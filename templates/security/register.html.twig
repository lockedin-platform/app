{% extends 'base.html.twig' %}

{% set recaptcha_enabled = recaptcha_site_key is not empty and recaptcha_site_key not in ['your_recaptcha_site_key', 'your_recaptcha_secret_key'] %}

{% block title %}Sign Up - Najahni{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-4" style="background:var(--nj-dark,#040816)">
    <div class="card border-0 overflow-hidden shadow-lg" style="max-width:1100px;width:95%;border-radius:1.5rem">
        <div class="row g-0">

            {# LEFT — Image panel (mirrors the registerModal exactly) #}
            <div class="col-lg-5 d-none d-lg-block position-relative" style="min-height:750px">
                <img src="{{ asset('uploads/auth-banner.avif') }}" alt="" class="w-100 h-100 position-absolute top-0 start-0" style="object-fit:cover">
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4"
                     style="background:linear-gradient(0deg,rgba(114,9,183,.85) 0%,rgba(67,97,238,.4) 50%,transparent 100%)">
                    <h4 class="text-white fw-bold mb-2">Join Najahni</h4>
                    <p class="text-white small opacity-90 mb-3">Be part of the Tunisian innovation community.</p>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2 text-white">
                            <i class="bi bi-check-circle-fill" style="font-size:.8rem"></i>
                            <small class="opacity-90">Launch your innovative projects</small>
                        </div>
                        <div class="d-flex align-items-center gap-2 text-white">
                            <i class="bi bi-check-circle-fill" style="font-size:.8rem"></i>
                            <small class="opacity-90">Find mentors &amp; investors</small>
                        </div>
                        <div class="d-flex align-items-center gap-2 text-white">
                            <i class="bi bi-check-circle-fill" style="font-size:.8rem"></i>
                            <small class="opacity-90">Grow your business</small>
                        </div>
                    </div>
                </div>
            </div>

            {# RIGHT — Form #}
            <div class="col-lg-7">
                <div class="p-4 p-lg-4">
                    <div class="text-center mb-3">
                        <h3 class="fw-bold" style="font-size:1.5rem">Create Account</h3>
                        <p class="text-muted small mb-0">Fill in your information to get started</p>
                    </div>

                    {% if errors is defined and errors|length %}
                        <div class="alert alert-danger rounded-3 py-2 small">
                            {% for err in errors %}<div><i class="bi bi-exclamation-triangle-fill me-1"></i>{{ err }}</div>{% endfor %}
                        </div>
                    {% endif %}

                    <form method="post" id="registerForm" novalidate>
                        {% set e = fieldErrors|default({}) %}
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">First name</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                                    <input type="text" name="firstname" class="form-control border-start-0 ps-0 {{ e.firstname is defined ? 'is-invalid' }}" value="{{ user.firstname }}" placeholder="Your first name" required minlength="2" maxlength="100">
                                </div>
                                {% if e.firstname is defined %}<div class="text-danger small mt-1">{{ e.firstname }}</div>{% endif %}
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">Last name</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-fill"></i></span>
                                    <input type="text" name="lastname" class="form-control border-start-0 ps-0 {{ e.lastname is defined ? 'is-invalid' }}" value="{{ user.lastname }}" placeholder="Your last name" required minlength="2" maxlength="100">
                                </div>
                                {% if e.lastname is defined %}<div class="text-danger small mt-1">{{ e.lastname }}</div>{% endif %}
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-semibold small mb-1">Email</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                <input type="email" name="email" class="form-control border-start-0 ps-0 {{ e.email is defined ? 'is-invalid' }}" value="{{ user.email }}" placeholder="your@email.com" required>
                            </div>
                            {% if e.email is defined %}<div class="text-danger small mt-1">{{ e.email }}</div>{% endif %}
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">Phone</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-phone"></i></span>
                                    <input type="tel" name="phone" class="form-control border-start-0 ps-0 {{ e.phone is defined ? 'is-invalid' }}" value="{{ user.phone }}" placeholder="+216 XX XXX XXX" pattern="^\+?[0-9\s\-]{7,20}$" maxlength="20">
                                </div>
                                {% if e.phone is defined %}<div class="text-danger small mt-1">{{ e.phone }}</div>{% endif %}
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">Role</label>
                                <select name="role" class="form-select form-select-sm" required>
                                    <option value="ENTREPRENEUR" {{ user.role == 'ENTREPRENEUR' ? 'selected' }}>Entrepreneur</option>
                                    <option value="MENTOR" {{ user.role == 'MENTOR' ? 'selected' }}>Mentor</option>
                                    <option value="INVESTISSEUR" {{ user.role == 'INVESTISSEUR' ? 'selected' }}>Investor</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">Password</label>
                                <div class="input-group input-group-sm">
                                    <input type="password" name="password" id="regPassword" class="form-control border-end-0 {{ e.password is defined ? 'is-invalid' }}" placeholder="Min. 6 characters" required minlength="6" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}" title="Min 6 characters: 1 uppercase, 1 lowercase, 1 digit">
                                    <button class="btn btn-outline-secondary border-start-0 btn-sm" type="button" onclick="togglePassword('regPassword', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                {% if e.password is defined %}<div class="text-danger small mt-1">{{ e.password }}</div>{% endif %}
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">Confirm</label>
                                <div class="input-group input-group-sm">
                                    <input type="password" name="confirm_password" id="regConfirm" class="form-control border-end-0 {{ e.confirm_password is defined ? 'is-invalid' }}" placeholder="Confirm password" required minlength="6">
                                    <button class="btn btn-outline-secondary border-start-0 btn-sm" type="button" onclick="togglePassword('regConfirm', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                {% if e.confirm_password is defined %}<div class="text-danger small mt-1">{{ e.confirm_password }}</div>{% endif %}
                            </div>
                        </div>

                        {# Password strength #}
                        <div class="mb-3">
                            <div class="progress mb-1" style="height:3px">
                                <div class="progress-bar" id="pwStrength" role="progressbar" style="width:0%"></div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <small id="rLen" class="text-muted" style="font-size:.7rem"><i class="bi bi-circle"></i> 6+ chars</small>
                                <small id="rUp" class="text-muted" style="font-size:.7rem"><i class="bi bi-circle"></i> Uppercase</small>
                                <small id="rLow" class="text-muted" style="font-size:.7rem"><i class="bi bi-circle"></i> Lowercase</small>
                                <small id="rDig" class="text-muted" style="font-size:.7rem"><i class="bi bi-circle"></i> Digit</small>
                            </div>
                        </div>

                        {% if recaptcha_enabled %}
                        <div class="d-flex justify-content-center mb-3">
                            <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
                        </div>
                        {% endif %}
                        <button type="submit" class="btn btn-nj w-100 py-2 mb-2">
                            <i class="bi bi-person-plus me-2"></i>Create My Account
                        </button>
                    </form>

                    {% if recaptcha_enabled %}
                    <div class="text-center mb-2">
                        <small class="text-muted"><i class="bi bi-shield-check text-success"></i> Protected by reCAPTCHA</small>
                    </div>
                    {% endif %}

                    <div class="d-flex align-items-center my-2">
                        <hr class="flex-grow-1"><span class="px-3 text-muted small">or</span><hr class="flex-grow-1">
                    </div>

                    <div class="d-grid mb-2">
                        <a href="{{ path('app_google_connect') }}" class="btn btn-outline-secondary py-2 d-flex align-items-center justify-content-center" style="border-radius:.75rem">
                            <svg width="18" height="18" viewBox="0 0 24 24" class="me-2">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                            </svg>
                            Sign up with Google
                        </a>
                    </div>

                    <p class="text-center text-muted small mb-0">Already have an account?
                        <a href="{{ path('app_login') }}" class="fw-semibold text-decoration-none" style="color:var(--nj-primary)">Sign in</a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function togglePassword(id, btn) {
    const inp = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (inp.type === 'password') { inp.type = 'text'; icon.className = 'bi bi-eye-slash'; }
    else { inp.type = 'password'; icon.className = 'bi bi-eye'; }
}

document.addEventListener('DOMContentLoaded', () => {
    const pw = document.getElementById('regPassword');
    const bar = document.getElementById('pwStrength');
    if (!pw) return;
    pw.addEventListener('input', () => {
        const v = pw.value;
        let score = 0;
        const checks = [
            ['rLen', v.length >= 6],
            ['rUp', /[A-Z]/.test(v)],
            ['rLow', /[a-z]/.test(v)],
            ['rDig', /\d/.test(v)]
        ];
        checks.forEach(([id, met]) => {
            score += met ? 1 : 0;
            const el = document.getElementById(id);
            const icon = el.querySelector('i');
            if (met) { icon.className = 'bi bi-check-circle-fill text-success'; el.classList.add('text-success'); el.classList.remove('text-muted'); }
            else { icon.className = 'bi bi-circle'; el.classList.remove('text-success'); el.classList.add('text-muted'); }
        });
        const colors = ['', 'bg-danger', 'bg-warning', 'bg-info', 'bg-success'];
        bar.style.width = (score * 25) + '%';
        bar.className = 'progress-bar ' + (colors[score] || '');
    });
});
</script>
{% if recaptcha_enabled %}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endif %}
{% endblock %}
