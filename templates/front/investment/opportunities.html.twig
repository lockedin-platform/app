{% extends 'front/layout.html.twig' %}

{% block title %}Investment Opportunities — LockedIn{% endblock %}

{% block main %}
<div class="row g-4">

    {# ── Page Header ── #}
    <div class="col-12">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h2 class="fw-bold mb-1" style="font-size:1.8rem">
                    <i class="bi bi-lightning-charge-fill me-2" style="color:var(--nj-primary)"></i>
                    {% if is_granted('ROLE_INVESTISSEUR') %}
                        My Investment Hub
                    {% else %}
                        Investment Opportunities
                    {% endif %}
                </h2>
                <p class="text-muted mb-0">
                    {% if is_granted('ROLE_INVESTISSEUR') %}
                        Manage your postings and review entrepreneur applications
                    {% else %}
                        Browse investor postings and apply with your project
                    {% endif %}
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                {% if is_granted('ROLE_INVESTISSEUR') %}
                    {% if pendingInboxCount > 0 %}
                        <a href="{{ path('app_invest_my_postings') }}" class="btn btn-warning btn-sm fw-semibold">
                            <i class="bi bi-inbox-fill me-1"></i>{{ pendingInboxCount }} New Application{{ pendingInboxCount > 1 ? 's' }}
                        </a>
                    {% endif %}
                    <a href="{{ path('app_invest_create_posting') }}" class="btn btn-sm fw-semibold" style="background:var(--nj-gradient);color:#fff">
                        <i class="bi bi-plus-lg me-1"></i>Post Investment
                    </a>
                    <a href="{{ path('app_invest_my_postings') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-list-ul me-1"></i>My Postings
                    </a>
                    <a href="{{ path('app_invest_my_offers') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-send me-1"></i>My Offers
                    </a>
                {% else %}
                    <a href="{{ path('app_invest_my_applications') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-file-earmark-check me-1"></i>My Applications
                    </a>
                {% endif %}
                <a href="{{ path('app_invest_my_contracts') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-file-earmark-text me-1"></i>My Contracts
                </a>
            </div>
        </div>
    </div>

    {# ── Flash messages ── #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="col-12">
                <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : (type == 'success' ? 'success' : 'info')) }} alert-dismissible fade show" role="alert">
                    {{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {# ── Search & Sort Bar ── #}
    <div class="col-12">
        <form method="GET" class="d-flex gap-2 flex-wrap">
            <input type="text" name="q" value="{{ search }}" class="form-control form-control-sm flex-grow-1" placeholder="Search by sector or description…" style="max-width:320px">
            <select name="sort" class="form-select form-select-sm" style="max-width:180px" onchange="this.form.submit()">
                <option value="recent" {{ sort == 'recent' ? 'selected' }}>Most Recent</option>
                <option value="budget_desc" {{ sort == 'budget_desc' ? 'selected' }}>Budget: High → Low</option>
                <option value="budget_asc" {{ sort == 'budget_asc' ? 'selected' }}>Budget: Low → High</option>
                <option value="deadline" {{ sort == 'deadline' ? 'selected' }}>Deadline Soon</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search me-1"></i>Search</button>
            {% if search %}<a href="{{ path('app_invest_opportunities') }}" class="btn btn-sm btn-outline-secondary">Clear</a>{% endif %}
        </form>
    </div>

    {# ── Posting Cards ── #}
    {% if postings is empty %}
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox display-4 text-muted"></i>
            <p class="text-muted mt-3">No open investment postings found.</p>
            {% if is_granted('ROLE_INVESTISSEUR') %}
                <a href="{{ path('app_invest_create_posting') }}" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i>Post your first investment interest
                </a>
            {% endif %}
        </div>
    {% else %}
        {% for posting in postings %}
            {% set applied = posting.id in myApplicationPostingIds %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 position-relative" style="border-radius:1rem;background:var(--nj-card-bg)">
                    {# Sector badge #}
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background:var(--nj-gradient);font-size:.75rem">
                            <i class="bi bi-tag me-1"></i>{{ posting.sector }}
                        </span>
                    </div>

                    <div class="card-body p-4">
                        {# Investor info #}
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white" style="width:38px;height:38px;background:var(--nj-gradient);font-size:.9rem;flex-shrink:0">
                                {{ posting.postedBy.firstname|slice(0,1)|upper }}{{ posting.postedBy.lastname|slice(0,1)|upper }}
                            </div>
                            <div>
                                <div class="fw-semibold" style="font-size:.9rem">{{ posting.postedBy.firstname }} {{ posting.postedBy.lastname }}</div>
                                <div class="text-muted" style="font-size:.75rem">Investor · {{ posting.createdAt|date('M d, Y') }}</div>
                            </div>
                        </div>

                        {# Budget range #}
                        <div class="mb-3">
                            <div class="d-flex align-items-baseline gap-2">
                                <span class="fw-bold" style="font-size:1.3rem;color:var(--nj-primary)">
                                    {{ posting.budgetMin|number_format(0, ',', ' ') }}
                                </span>
                                <span class="text-muted fw-semibold">–</span>
                                <span class="fw-bold" style="font-size:1.3rem;color:var(--nj-primary)">
                                    {{ posting.budgetMax|number_format(0, ',', ' ') }} TND
                                </span>
                            </div>
                            <div class="text-muted" style="font-size:.78rem">Investment budget range</div>
                        </div>

                        {# Description #}
                        <p class="text-muted mb-3" style="font-size:.87rem;line-height:1.5">
                            {{ posting.description|length > 150 ? posting.description|slice(0,150) ~ '…' : posting.description }}
                        </p>

                        {# Deadline #}
                        {% if posting.deadline %}
                            {% set daysLeft = ((posting.deadline.timestamp - ("now"|date('U')))|abs // 86400) %}
                            {% if posting.deadline.timestamp > "now"|date('U') %}
                                <div class="mb-3 d-flex align-items-center gap-2 text-muted" style="font-size:.8rem">
                                    <i class="bi bi-calendar-event"></i>
                                    Deadline: <strong>{{ posting.deadline|date('M d, Y') }}</strong>
                                    {% if daysLeft <= 14 %}
                                        <span class="badge bg-danger" style="font-size:.7rem">{{ daysLeft }}d left</span>
                                    {% elseif daysLeft <= 60 %}
                                        <span class="badge bg-warning text-dark" style="font-size:.7rem">{{ (daysLeft / 7)|round }}w left</span>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endif %}

                        {# Applications count (for investor's own postings) #}
                        {% if is_granted('ROLE_INVESTISSEUR') and app.user and posting.postedBy.id == app.user.id %}
                            <div class="mb-2 text-muted" style="font-size:.8rem">
                                <i class="bi bi-people me-1"></i>
                                {{ posting.applications|length }} application{{ posting.applications|length != 1 ? 's' }}
                                {% if posting.pendingApplicationCount > 0 %}
                                    · <span class="text-warning fw-semibold">{{ posting.pendingApplicationCount }} pending</span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                        {% if is_granted('ROLE_ENTREPRENEUR') %}
                            {% if applied %}
                                <button class="btn btn-success btn-sm w-100 fw-semibold" disabled>
                                    <i class="bi bi-check-circle me-1"></i>Applied
                                </button>
                            {% else %}
                                <a href="{{ path('app_invest_posting_apply', {id: posting.id}) }}" class="btn btn-sm w-100 fw-semibold" style="background:var(--nj-gradient);color:#fff">
                                    <i class="bi bi-send-fill me-1"></i>Apply Now
                                </a>
                            {% endif %}
                        {% elseif is_granted('ROLE_INVESTISSEUR') and app.user and posting.postedBy.id == app.user.id %}
                            <a href="{{ path('app_invest_my_postings') }}" class="btn btn-outline-primary btn-sm w-100">
                                <i class="bi bi-eye me-1"></i>View Applications
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}

    {# ── Pagination ── #}
    {% if pagination.pageCount is defined and pagination.pageCount > 1 %}
        <div class="col-12 d-flex justify-content-center mt-2">
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    {% if pagination.currentPageNumber > 1 %}
                        <li class="page-item"><a class="page-link" href="?page={{ pagination.currentPageNumber - 1 }}&q={{ search }}&sort={{ sort }}">‹</a></li>
                    {% endif %}
                    {% for p in 1..pagination.pageCount %}
                        <li class="page-item {{ p == pagination.currentPageNumber ? 'active' }}">
                            <a class="page-link" href="?page={{ p }}&q={{ search }}&sort={{ sort }}">{{ p }}</a>
                        </li>
                    {% endfor %}
                    {% if pagination.currentPageNumber < pagination.pageCount %}
                        <li class="page-item"><a class="page-link" href="?page={{ pagination.currentPageNumber + 1 }}&q={{ search }}&sort={{ sort }}">›</a></li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    {% endif %}

</div>
{% endblock %}
