{# Investment lifecycle wayfinder — include with: pageLabel, activeStep (1-5) #}
{% set wfSteps = [
    {num: 1, label: 'Parcourir', icon: 'bi-search'},
    {num: 2, label: 'Offrir', icon: 'bi-hand-index'},
    {num: 3, label: 'Negocier', icon: 'bi-chat-dots'},
    {num: 4, label: 'Payer', icon: 'bi-credit-card'},
    {num: 5, label: 'Portfolio', icon: 'bi-briefcase'},
] %}
<style>
.wf-bar{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:.75rem;padding:.5rem 1.2rem;margin-bottom:.85rem;min-height:40px;gap:1rem;backdrop-filter:blur(14px)}
.wf-page{font-size:.82rem;font-weight:700;color:rgba(255,255,255,.9);white-space:nowrap;letter-spacing:.01em}
.wf-steps{display:flex;align-items:center;gap:0}
.wf-step{display:flex;align-items:center;gap:.3rem;font-size:.72rem;color:rgba(255,255,255,.35);white-space:nowrap;padding:.2rem .45rem;border-radius:10rem;transition:all .2s}
.wf-step.wf-active{color:#67e8f9;font-weight:600;background:rgba(103,232,249,.1);border:1px solid rgba(103,232,249,.18)}
.wf-step.wf-done{color:rgba(255,255,255,.55)}
.wf-step i{font-size:.7rem}
.wf-connector{width:18px;height:1px;background:rgba(255,255,255,.1);flex-shrink:0}
.wf-step.wf-active+.wf-connector{background:rgba(103,232,249,.3)}
@media(max-width:576px){.wf-steps{display:none}}
</style>
<div class="wf-bar">
    <span class="wf-page">{{ pageLabel }}</span>
    <div class="wf-steps">
        {% for step in wfSteps %}
            <span class="wf-step{% if step.num == activeStep %} wf-active{% elseif step.num < activeStep %} wf-done{% endif %}">
                <i class="bi {{ step.icon }}"></i>{{ step.label }}
            </span>
            {% if not loop.last %}<span class="wf-connector"></span>{% endif %}
        {% endfor %}
    </div>
</div>
