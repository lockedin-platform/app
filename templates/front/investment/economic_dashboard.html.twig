{% extends 'front/layout.html.twig' %}

{% block title %}Investment Intelligence - LockedIn{% endblock %}

{% block main %}
{% include 'front/investment/_wayfinder.html.twig' with {pageLabel: 'Economic Intelligence', activeStep: 1} %}
<style>
.eco-dash-hero {
    background: linear-gradient(-45deg, #0f172a, #1e3a5f, #0d9488, #1e293b);
    background-size: 400% 400%;
    animation: gradientShift 8s ease infinite;
    border-radius: 1rem;
    padding: 2rem 2.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
}
@keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}
.eco-dash-hero h2, .eco-dash-hero a { position: relative; z-index: 1; }
.eco-dash-vignette {
    position: relative;
}
.eco-dash-vignette::before {
    content: '';
    position: absolute;
    inset: -20px;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(15,23,42,.06) 100%);
    pointer-events: none;
    border-radius: 1.5rem;
    z-index: 0;
}
.eco-dash-vignette > * { position: relative; z-index: 1; }
</style>

<div class="eco-dash-hero">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="fw-bold mb-0 text-white"><i class="bi bi-globe me-2"></i>Investment Intelligence</h2>
        <a href="{{ path('app_invest_opportunities') }}" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

{# ── Impact on Active Opportunities ── #}
<div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;border-left:4px solid #0f172a">
    <div class="card-body py-4 px-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-bullseye me-2"></i>Impact on Active Opportunities</h5>

        {# Risk breakdown #}
        {% if riskCounts is defined and riskCounts.total > 0 %}
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fw-semibold" style="font-size:1.05rem">{{ riskCounts.total }} active opportunit{{ riskCounts.total > 1 ? 'ies' : 'y' }}</span>
            <span class="mx-1 text-muted">|</span>
            {% if riskCounts.low > 0 %}
            <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background:rgba(34,197,94,.15);color:#86efac;font-size:.82rem;font-weight:600">
                <i class="bi bi-shield-check"></i>{{ riskCounts.low }} low
            </span>
            {% endif %}
            {% if riskCounts.medium > 0 %}
            <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background:rgba(245,158,11,.15);color:#fcd34d;font-size:.82rem;font-weight:600">
                <i class="bi bi-exclamation-triangle"></i>{{ riskCounts.medium }} moderate
            </span>
            {% endif %}
            {% if riskCounts.high > 0 %}
            <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background:rgba(239,68,68,.15);color:#fca5a5;font-size:.82rem;font-weight:600">
                <i class="bi bi-shield-exclamation"></i>{{ riskCounts.high }} high
            </span>
            {% endif %}
        </div>
        {% endif %}

        {# Climate verdict — prominent #}
        {% if climateVerdict is defined and climateVerdict %}
        <div class="p-4 rounded-3 mt-2" style="background:linear-gradient(135deg,rgba(59,130,246,.12),rgba(99,102,241,.10));border:1px solid rgba(99,102,241,.3)">
            <div class="fw-semibold mb-2" style="font-size:.95rem;color:#818cf8"><i class="bi bi-cloud-sun-fill me-2"></i>Today's Investment Climate</div>
            <div style="font-size:1rem;line-height:1.65;color:rgba(226,232,240,.9)">{{ climateVerdict }}</div>
        </div>
        {% else %}
        <div class="p-4 rounded-3 mt-2" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08)">
            <div class="fw-semibold mb-2" style="font-size:.95rem;color:#818cf8"><i class="bi bi-cloud-sun-fill me-2"></i>Today's Investment Climate</div>
            <div class="text-muted" style="font-size:.92rem">Economic data unavailable at this time.</div>
        </div>
        {% endif %}
    </div>
</div>

{# Mission control: current conditions affecting opportunities #}
{% if riskCounts is defined and riskCounts.total > 0 %}
<div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;border-left:4px solid #3b82f6">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-activity fs-5 text-primary"></i>
            <span class="fw-bold" style="font-size:1.05rem">Current conditions affecting {{ riskCounts.total }} opportunit{{ riskCounts.total > 1 ? 'ies' : 'y' }} on the platform</span>
        </div>
        <div class="d-flex gap-3 flex-wrap">
            {% if riskCounts.low > 0 %}
            <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background:rgba(34,197,94,.15);color:#86efac;font-size:.82rem;font-weight:600">
                <i class="bi bi-shield-check"></i>{{ riskCounts.low }} low risk
            </span>
            {% endif %}
            {% if riskCounts.medium > 0 %}
            <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background:rgba(245,158,11,.15);color:#fcd34d;font-size:.82rem;font-weight:600">
                <i class="bi bi-exclamation-triangle"></i>{{ riskCounts.medium }} moderate risk
            </span>
            {% endif %}
            {% if riskCounts.high > 0 %}
            <span class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill" style="background:rgba(239,68,68,.15);color:#fca5a5;font-size:.82rem;font-weight:600">
                <i class="bi bi-shield-exclamation"></i>{{ riskCounts.high }} high risk
            </span>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}

{# Country selector + Currency converter #}
<div class="eco-dash-vignette">
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius:1rem">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">Economic Data by Country</h6>
                <select id="countrySelect" class="form-select mb-3">
                    <option value="TN" selected>Tunisia</option>
                    <option value="FR">France</option>
                    <option value="US">United States</option>
                    <option value="DE">Germany</option>
                    <option value="GB">United Kingdom</option>
                    <option value="MA">Morocco</option>
                </select>
                <div id="ecoSpinner" class="text-center py-3">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="small text-muted mt-2">Loading data...</p>
                </div>
                <div id="ecoCards" class="d-none">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="stat-card p-3">
                                <div class="small text-muted">EUR/USD</div>
                                <div class="fw-bold fs-5" id="eurUsd">--</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-3">
                                <div class="small text-muted">EUR/TND</div>
                                <div class="fw-bold fs-5" id="eurTnd">--</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-3">
                                <div class="small text-muted">GDP</div>
                                <div class="fw-bold fs-5" id="gdpVal">--</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-3">
                                <div class="small text-muted">Inflation</div>
                                <div class="fw-bold fs-5" id="inflVal">--</div>
                            </div>
                        </div>
                    </div>

                    {# Investment context annotations #}
                    <div class="mt-3 d-flex flex-column gap-2">
                        {% if inflationSensitive is defined and inflationSensitive > 0 %}
                        <div class="d-flex align-items-start gap-2 p-2 rounded" style="background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25)">
                            <i class="bi bi-graph-up-arrow text-warning mt-1" style="font-size:.85rem"></i>
                            <span style="font-size:.82rem;line-height:1.4;color:#fcd34d">
                                <strong>{{ inflationSensitive }}</strong> active opportunit{{ inflationSensitive > 1 ? 'ies' : 'y' }} in inflation-sensitive sectors (import-dependent)
                            </span>
                        </div>
                        {% endif %}
                        {% if shortDeadlineCount is defined and shortDeadlineCount > 0 %}
                        <div class="d-flex align-items-start gap-2 p-2 rounded" style="background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.25)">
                            <i class="bi bi-currency-exchange text-primary mt-1" style="font-size:.85rem"></i>
                            <span style="font-size:.82rem;line-height:1.4;color:#93c5fd">
                                <strong>{{ shortDeadlineCount }}</strong> opportunit{{ shortDeadlineCount > 1 ? 'ies' : 'y' }} with near deadline involve cross-border financing considerations
                            </span>
                        </div>
                        {% endif %}
                    </div>

                    <div class="mt-3 p-3 rounded" id="riskFactorBox" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="small text-muted">Economic Risk Factor</div>
                                <div class="fw-bold fs-4" id="riskFactorVal">--</div>
                            </div>
                            <div>
                                <span class="badge fs-6" id="riskLevelBadge">--</span>
                            </div>
                        </div>
                        <div class="progress mt-2" style="height:8px;border-radius:4px">
                            <div class="progress-bar" id="riskBar" style="width:0%"></div>
                        </div>
                        <p class="small mt-2 mb-0" id="riskRecommendation">--</p>
                    </div>
                    <p class="small text-muted mt-2 mb-0" id="ecoTimestamp"></p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius:1rem">
            <div class="card-body">
                <h6 class="fw-semibold mb-3">Currency Converter</h6>
                <div class="row g-2 mb-3">
                    <div class="col-5">
                        <label class="form-label small">Amount</label>
                        <input type="number" id="convAmount" class="form-control" value="1000" min="0" step="0.01">
                    </div>
                    <div class="col-3">
                        <label class="form-label small">From</label>
                        <select id="convFrom" class="form-select">
                            <option value="EUR" selected>EUR</option>
                            <option value="USD">USD</option>
                            <option value="TND">TND</option>
                            <option value="GBP">GBP</option>
                            <option value="MAD">MAD</option>
                        </select>
                    </div>
                    <div class="col-1 d-flex align-items-end justify-content-center pb-2">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                    <div class="col-3">
                        <label class="form-label small">To</label>
                        <select id="convTo" class="form-select">
                            <option value="EUR">EUR</option>
                            <option value="USD">USD</option>
                            <option value="TND" selected>TND</option>
                            <option value="GBP">GBP</option>
                            <option value="MAD">MAD</option>
                        </select>
                    </div>
                </div>
                <button type="button" id="convertBtn" class="btn btn-nj w-100 mb-3">Convert</button>
                <div id="convResult" class="p-3 rounded text-center d-none" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)">
                    <div class="small text-muted">Result</div>
                    <div class="fw-bold fs-4" id="convValue">--</div>
                    <div class="small text-muted" id="convRate">--</div>
                </div>

                <hr class="my-3">
                <h6 class="fw-semibold mb-2">Real-time Rates (EUR base)</h6>
                <div id="ratesTable">
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>{# /.eco-dash-vignette #}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const countrySelect = document.getElementById('countrySelect');

    function loadEconomicData() {
        const country = countrySelect.value;
        document.getElementById('ecoSpinner').classList.remove('d-none');
        document.getElementById('ecoCards').classList.add('d-none');

        fetch('{{ path("app_invest_economic_data") }}?country=' + encodeURIComponent(country))
            .then(r => r.json())
            .then(data => {
                document.getElementById('eurUsd').textContent = (data.exchangeRateEurUsd || 0).toFixed(4);
                document.getElementById('eurTnd').textContent = (data.exchangeRateEurTnd || 0).toFixed(3);
                document.getElementById('gdpVal').textContent = (data.gdpBillions || 0).toFixed(1) + ' Bn $';
                document.getElementById('inflVal').textContent = (data.inflationRate || 0).toFixed(1) + '%';

                const factor = data.economicRiskFactor || 50;
                document.getElementById('riskFactorVal').textContent = factor + ' / 100';
                const badge = document.getElementById('riskLevelBadge');
                badge.textContent = data.riskLevel || '--';
                badge.style.background = data.riskColor || '#999';
                badge.style.color = '#fff';

                const bar = document.getElementById('riskBar');
                bar.style.width = factor + '%';
                bar.style.background = data.riskColor || '#999';

                document.getElementById('riskRecommendation').textContent = data.recommendation || '';
                document.getElementById('ecoTimestamp').textContent = 'Country: ' + (data.countryName || country) + ' | Data year: ' + (data.dataYear || 'N/A');

                document.getElementById('ecoSpinner').classList.add('d-none');
                document.getElementById('ecoCards').classList.remove('d-none');
            })
            .catch(() => {
                document.getElementById('ecoSpinner').innerHTML = '<p class="text-danger">Failed to load data.</p>';
            });
    }

    countrySelect.addEventListener('change', loadEconomicData);
    loadEconomicData();

    // Currency converter
    document.getElementById('convertBtn').addEventListener('click', function() {
        const amount = document.getElementById('convAmount').value;
        const from = document.getElementById('convFrom').value;
        const to = document.getElementById('convTo').value;

        fetch('{{ path("app_invest_currency_convert") }}?amount=' + amount + '&from=' + from + '&to=' + to)
            .then(r => r.json())
            .then(data => {
                document.getElementById('convValue').textContent = data.formatted;
                document.getElementById('convRate').textContent = '1 ' + from + ' = ' + data.rate + ' ' + to;
                document.getElementById('convResult').classList.remove('d-none');

                // Update rates table
                if (data.rates) {
                    let html = '<table class="table table-sm mb-0">';
                    for (const [cur, rate] of Object.entries(data.rates)) {
                        html += '<tr><td class="fw-semibold">' + cur + '</td><td>' + Number(rate).toFixed(4) + '</td></tr>';
                    }
                    html += '</table>';
                    document.getElementById('ratesTable').innerHTML = html;
                }
            })
            .catch(() => {
                document.getElementById('convValue').textContent = 'Error';
            });
    });

    // Auto-load rates on page load
    fetch('{{ path("app_invest_currency_convert") }}?amount=1&from=EUR&to=TND')
        .then(r => r.json())
        .then(data => {
            if (data.rates) {
                let html = '<table class="table table-sm mb-0">';
                for (const [cur, rate] of Object.entries(data.rates)) {
                    html += '<tr><td class="fw-semibold">' + cur + '</td><td>' + Number(rate).toFixed(4) + '</td></tr>';
                }
                html += '</table>';
                document.getElementById('ratesTable').innerHTML = html;
            }
        });
});
</script>
{% endblock %}
