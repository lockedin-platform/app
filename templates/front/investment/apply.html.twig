{% extends 'front/layout.html.twig' %}

{% block title %}Apply to Investment Posting — Najahni{% endblock %}

{% block main %}
<div class="row justify-content-center g-4">
    <div class="col-12 col-lg-8">

        {# Back link #}
        <a href="{{ path('app_invest_opportunities') }}" class="d-inline-flex align-items-center gap-1 text-muted text-decoration-none mb-4" style="font-size:.88rem">
            <i class="bi bi-arrow-left"></i> Back to opportunities
        </a>

        {# Posting summary card #}
        <div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;background:var(--nj-card-bg)">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white" style="width:48px;height:48px;background:var(--nj-gradient);font-size:1rem;flex-shrink:0">
                        {{ posting.postedBy.firstname|slice(0,1)|upper }}{{ posting.postedBy.lastname|slice(0,1)|upper }}
                    </div>
                    <div>
                        <div class="fw-bold" style="font-size:1.05rem">{{ posting.postedBy.firstname }} {{ posting.postedBy.lastname }}</div>
                        <div class="text-muted" style="font-size:.82rem">
                            <i class="bi bi-tag me-1"></i>{{ posting.sector }} investor
                        </div>
                    </div>
                    <div class="ms-auto text-end">
                        <div class="fw-bold" style="color:var(--nj-primary);font-size:1.1rem">
                            {{ posting.budgetMin|number_format(0, ',', ' ') }} – {{ posting.budgetMax|number_format(0, ',', ' ') }} TND
                        </div>
                        <div class="text-muted" style="font-size:.78rem">Budget range</div>
                    </div>
                </div>
                <p class="text-muted mb-0" style="font-size:.9rem;line-height:1.6">{{ posting.description }}</p>
                {% if posting.deadline %}
                    <div class="mt-3 text-muted" style="font-size:.82rem">
                        <i class="bi bi-calendar-event me-1"></i>Application deadline: <strong>{{ posting.deadline|date('M d, Y') }}</strong>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="alert alert-{{ type == 'danger' ? 'danger' : 'info' }} alert-dismissible fade show" role="alert">
                    {{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Application Form #}
        <div class="card border-0 shadow-sm" style="border-radius:1rem;background:var(--nj-card-bg)">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-4">
                    <i class="bi bi-send-fill me-2" style="color:var(--nj-primary)"></i>Submit Your Application
                </h4>

                <form method="POST" action="{{ path('app_invest_posting_apply', {id: posting.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('apply_posting_' ~ posting.id) }}">

                    {# Project selection #}
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Select Your Project <span class="text-danger">*</span></label>
                        <p class="text-muted mb-2" style="font-size:.84rem">Choose which of your projects best matches this investor's interest.</p>
                        <div class="row g-3">
                            {% for project in projects %}
                                <div class="col-12 col-md-6">
                                    <label class="d-block h-100">
                                        <input type="radio" name="project_id" value="{{ project.id }}" class="d-none project-radio" required>
                                        <div class="card h-100 border-2 project-card" style="border-radius:.75rem;cursor:pointer;transition:.15s;border-color:transparent">
                                            <div class="card-body p-3">
                                                <div class="fw-semibold mb-1" style="font-size:.95rem">{{ project.titre }}</div>
                                                {% if project.secteur %}
                                                    <span class="badge bg-secondary rounded-pill mb-2" style="font-size:.72rem">{{ project.secteur }}</span>
                                                {% endif %}
                                                {% if project.description %}
                                                    <p class="text-muted mb-0" style="font-size:.8rem;line-height:1.4">
                                                        {{ project.description|length > 80 ? project.description|slice(0,80) ~ '…' : project.description }}
                                                    </p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    {# Cover message #}
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="cover_message">
                            Cover Message <span class="text-danger">*</span>
                        </label>
                        <p class="text-muted mb-2" style="font-size:.84rem">
                            Introduce yourself and explain why your project is a great fit for this investor. Be specific and authentic.
                        </p>
                        <textarea id="cover_message" name="cover_message" rows="6" class="form-control"
                            placeholder="Hi, I'm [your name] and I'm building [project name]. Our project aligns with your interest in [sector] because…"
                            minlength="20" maxlength="2000" required></textarea>
                        <div class="form-text text-end" id="charCount">0 / 2000</div>
                    </div>

                    {# Tips box #}
                    <div class="alert border-0 mb-4" style="background:rgba(99,102,241,.08);border-radius:.75rem">
                        <h6 class="fw-semibold mb-2"><i class="bi bi-lightbulb me-1" style="color:var(--nj-primary)"></i>Tips for a strong application</h6>
                        <ul class="mb-0 text-muted" style="font-size:.84rem">
                            <li>Briefly explain your project and traction (users, revenue, etc.)</li>
                            <li>Show how the investor's budget range fits your funding needs</li>
                            <li>Mention what you'll use the investment for</li>
                            <li>Share any relevant milestones or achievements</li>
                        </ul>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn fw-semibold px-4" style="background:var(--nj-gradient);color:#fff">
                            <i class="bi bi-send-fill me-2"></i>Submit Application
                        </button>
                        <a href="{{ path('app_invest_opportunities') }}" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<style>
.project-card { border: 2px solid transparent; transition: .15s; }
.project-radio:checked + .project-card {
    border-color: var(--nj-primary) !important;
    background: rgba(99,102,241,.07);
}
.project-card:hover { border-color: var(--nj-primary) !important; }
</style>

<script>
document.querySelectorAll('.project-radio').forEach(r => {
    r.addEventListener('change', () => {
        document.querySelectorAll('.project-card').forEach(c => c.style.borderColor = 'transparent');
        if (r.checked) r.nextElementSibling.style.borderColor = 'var(--nj-primary)';
    });
});
const textarea = document.getElementById('cover_message');
const counter = document.getElementById('charCount');
textarea?.addEventListener('input', () => { counter.textContent = textarea.value.length + ' / 2000'; });
</script>
{% endblock %}
