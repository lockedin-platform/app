{% extends 'front/layout.html.twig' %}

{% block title %}Home - LockedIn{% endblock %}

{% block body_attributes %}data-page="home" data-bs-theme="dark"{% endblock %}

{% block stylesheets %}
<style>
main.container-fluid { padding: 0 !important; }

.nj-audience-section {
    padding: 4rem 0 2rem;
    position: relative;
    z-index: 2;
    background: linear-gradient(180deg, #0d0f1a 0%, #111827 100%);
    color: #e2e8f0;
}
.nj-audience-section h3 { color: #ffffff; }
.nj-audience-section .text-muted { color: rgba(255,255,255,0.55) !important; }
.nj-audience-card {
    height: 100%;
    border-radius: 16px;
    background: rgba(255,255,255,0.04);
    box-shadow: 0 16px 42px rgba(15, 23, 42, .08);
    padding: 2rem 1.6rem;
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(14px);
    color: #e2e8f0;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity .5s ease, transform .5s ease, box-shadow .25s ease;
    animation: audienceCardIn 0.6s ease 0.5s both;
    display: flex;
    flex-direction: column;
}
.nj-audience-card .btn { margin-top: auto; }
@keyframes audienceCardIn { to { opacity: 1; transform: translateY(0); } }
.nj-audience-card.revealed { animation: none; opacity: 1; transform: translateY(0); }
.nj-audience-card:hover { box-shadow: 0 24px 52px rgba(15, 23, 42, .12); }
.nj-audience-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: rgba(255,255,255,0.08) !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 1rem;
}
.nj-audience-card h4,
.nj-audience-card strong { font-size: 1.15rem; font-weight: 800; color: #ffffff; margin-bottom: .55rem; }
.nj-audience-card p { color: rgba(255,255,255,0.7); font-size: .93rem; line-height: 1.6; margin-bottom: 1rem; }
.nj-audience-points {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    gap: .55rem;
}
.nj-audience-points li {
    color: rgba(255,255,255,0.65);
    font-size: .86rem;
    display: flex;
    align-items: flex-start;
    gap: .55rem;
}
.nj-audience-points i { color: var(--nj-primary); margin-top: .1rem; }

.nj-hero {
    --hero-progress: 0;
    --hero-exit-progress: 0;
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
        radial-gradient(circle at 16% 18%, rgba(103, 232, 249, .16), transparent 24%),
        radial-gradient(circle at 84% 20%, rgba(245, 158, 11, .18), transparent 26%),
        radial-gradient(circle at 48% 84%, rgba(124, 58, 237, .26), transparent 34%),
        linear-gradient(135deg, #040816 0%, #0b1431 38%, #120928 70%, #040816 100%);
}
.nj-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
        linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 120px 120px;
    mask-image: linear-gradient(180deg, rgba(0,0,0,.55), transparent 90%);
    opacity: .28;
}
.nj-hero::after {
    content: '';
    position: absolute;
    inset: auto 0 -12rem;
    height: 24rem;
    background: radial-gradient(circle at 50% 50%, rgba(67, 97, 238, .22), transparent 72%);
    filter: blur(20px);
    opacity: .8;
}
.nj-hero-grid {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg, rgba(255,255,255,.03), transparent 28%),
        radial-gradient(circle at 50% 50%, rgba(255,255,255,.05), transparent 55%);
    pointer-events: none;
    transform: translate3d(0, calc(var(--hero-progress) * 8vh), 0);
    opacity: calc(.48 - (var(--hero-progress) * .16));
}
.nj-hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(12px);
    opacity: .75;
    pointer-events: none;
}
.nj-hero-orb-a {
    width: 18rem;
    height: 18rem;
    top: 10%;
    left: -6rem;
    background: radial-gradient(circle, rgba(56, 189, 248, .45), transparent 68%);
    transform: translate3d(calc(var(--hero-progress) * -12vw), calc(var(--hero-progress) * -8vh), 0) scale(calc(1 + (var(--hero-progress) * .35)));
}
.nj-hero-orb-b {
    width: 24rem;
    height: 24rem;
    top: 12%;
    right: -6rem;
    background: radial-gradient(circle, rgba(245, 158, 11, .28), transparent 70%);
    transform: translate3d(calc(var(--hero-progress) * 10vw), calc(var(--hero-progress) * -5vh), 0) scale(calc(1 + (var(--hero-progress) * .2)));
}
.nj-hero-orb-c {
    width: 20rem;
    height: 20rem;
    bottom: -6rem;
    left: 40%;
    background: radial-gradient(circle, rgba(124, 58, 237, .34), transparent 72%);
    transform: translate3d(calc(var(--hero-progress) * -4vw), calc(var(--hero-progress) * 10vh), 0) scale(calc(1 + (var(--hero-progress) * .28)));
}
.nj-hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
}
.nj-hero-canvas.loaded { opacity: .88; }
.nj-hero-shell {
    position: relative;
    z-index: 2;
    width: min(1240px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 7rem 0 4.5rem;
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(420px, .96fr);
    gap: 2.75rem;
    align-items: center;
}
.nj-hero-copy {
    position: relative;
    z-index: 2;
    color: #fff;
    max-width: 640px;
    transform: translate3d(0, calc(var(--hero-progress) * -12vh), 0) scale(calc(1 - (var(--hero-progress) * .04)));
    opacity: calc(1 - (var(--hero-exit-progress) * .6));
    filter: blur(calc(var(--hero-exit-progress) * 5px));
    transition: transform .12s linear, opacity .12s linear, filter .12s linear;
}
.nj-hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    padding: .55rem .9rem;
    margin-bottom: 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.08);
    backdrop-filter: blur(14px);
    font-size: .78rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,255,255,.78);
}
.nj-hero-kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #67e8f9;
    box-shadow: 0 0 0 6px rgba(103, 232, 249, .12);
}
.nj-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    background: linear-gradient(135deg, rgba(255,255,255,.14), rgba(255,255,255,.04));
    border: 1px solid rgba(255,255,255,.14);
    backdrop-filter: blur(10px);
    color: #fff;
    padding: .5rem 1.15rem;
    border-radius: 999px;
    font-size: .84rem;
    font-weight: 600;
    margin-bottom: 1.6rem;
    min-width: 240px;
    box-shadow: 0 12px 30px rgba(6, 9, 24, .32);
    transition: opacity .35s ease;
}
.nj-stat-pill::before {
    content: '';
    width: .6rem;
    height: .6rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #67e8f9, #3b82f6);
    box-shadow: 0 0 20px rgba(103, 232, 249, .55);
}
.nj-stat-pill.fade-out { opacity: 0; }
.nj-hero-title {
    margin: 0 0 1.25rem;
    font-size: clamp(3rem, 7vw, 5.4rem);
    font-weight: 800;
    line-height: .94;
    letter-spacing: -.05em;
}
.nj-hero-title-line {
    display: block;
    text-wrap: balance;
}
.nj-hero-title-accent {
    background: linear-gradient(90deg, #ffffff 0%, #c4fbff 24%, #8bb8ff 52%, #f9c86b 82%, #ffffff 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmerText 7s linear infinite;
}
@keyframes shimmerText {
    0% { background-position: 0% 50%; }
    100% { background-position: 240% 50%; }
}
.nj-hero-lead {
    font-size: 1.06rem;
    color: rgba(233, 240, 255, .76);
    max-width: 36rem;
    margin: 0 0 2rem;
    line-height: 1.7;
}
.nj-hero-actions {
    display: flex;
    gap: .95rem;
    flex-wrap: wrap;
    margin-bottom: 1.35rem;
}
/* light-mode: background: linear-gradient(135deg, #7c3aed, #3b82f6 56%, #67e8f9 120%); box-shadow: 0 18px 40px rgba(59,130,246,.28); */
.btn-hero-primary {
    background: rgba(255,255,255,.06);
    border: 1.5px solid rgba(255,255,255,.18);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: .85rem 1.9rem;
    border-radius: .9rem;
    transition: transform .2s, box-shadow .2s, background .2s, border-color .2s;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0,0,0,.25);
}
.btn-hero-primary:hover { transform: translateY(-3px); background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.35); color: #fff; box-shadow: 0 8px 28px rgba(0,0,0,.35); }
.btn-hero-secondary {
    background: rgba(255,255,255,.02);
    border: 1px solid rgba(255,255,255,.18);
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    padding: .82rem 1.65rem;
    border-radius: .9rem;
    transition: background .2s, border-color .2s;
    backdrop-filter: blur(10px);
}
.btn-hero-secondary:hover { background: rgba(255,255,255,.12); border-color: #fff; color: #fff; }
.nj-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin-bottom: 2rem;
}
.nj-hero-meta-pill {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .55rem .85rem;
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    color: rgba(255,255,255,.74);
    font-size: .8rem;
}
.nj-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .9rem;
}
.nj-hero-stat {
    padding: 1rem 1.05rem;
    border-radius: 1.1rem;
    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.03));
    border: 1px solid rgba(255,255,255,.12);
    color: rgba(255,255,255,.9);
    box-shadow: 0 16px 40px rgba(7, 10, 24, .24);
}
.nj-hero-stat .stat-num {
    font-size: 1.8rem;
    font-weight: 800;
    display: block;
    line-height: 1;
    margin-bottom: .4rem;
}
.nj-hero-stat .stat-label {
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    opacity: .62;
}
.nj-hero-stage {
    position: relative;
    min-height: 620px;
    display: flex;
    justify-content: flex-end;
    perspective: 1600px;
}
.nj-stage-shell {
    --stage-tilt-x: 0deg;
    --stage-tilt-y: 0deg;
    --stage-pointer-x: 50%;
    --stage-pointer-y: 50%;
    position: relative;
    width: min(560px, 100%);
    min-height: 620px;
    margin-left: auto;
    border-radius: 2rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.12);
    background:
        linear-gradient(180deg, rgba(255,255,255,.1), rgba(255,255,255,.02)),
        linear-gradient(160deg, rgba(6, 13, 30, .92), rgba(12, 22, 49, .88));
    box-shadow: 0 42px 90px rgba(1, 4, 17, .48);
    backdrop-filter: blur(16px);
    transform: translate3d(0, var(--stage-story-y, 0px), 0) rotateX(calc(var(--stage-tilt-y) + var(--stage-story-rotate-x, 0deg))) rotateY(calc(var(--stage-tilt-x) + var(--stage-story-rotate-y, 0deg))) scale(calc(var(--stage-story-scale, 1) + (var(--hero-exit-progress) * .04)));
    transition: transform .35s ease, box-shadow .35s ease, opacity .35s ease;
    transform-style: preserve-3d;
    will-change: transform;
}
.nj-stage-shell.is-journey-fixed {
    position: fixed;
    top: 16vh;
    right: clamp(1rem, 4vw, 3rem);
    width: min(35vw, 500px);
    min-height: min(62vh, 620px);
    z-index: 18;
    pointer-events: none;
    box-shadow: 0 48px 120px rgba(2, 6, 23, .48);
}
.nj-stage-shell::before,
.nj-stage-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
}
.nj-stage-shell::before {
    background:
        linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, rgba(0,0,0,.65), transparent 100%);
    opacity: .24;
}
.nj-stage-shell::after {
    background: radial-gradient(circle at var(--stage-pointer-x) var(--stage-pointer-y), rgba(125,211,252,.24), transparent 34%);
    opacity: .9;
}
.nj-stage-ring,
.nj-stage-badge,
.nj-stage-beacon,
.nj-stage-card,
.nj-stage-chip {
    position: absolute;
    z-index: 2;
    opacity: calc(1 - (var(--journey-scene-progress, 0) * .78));
    filter: blur(calc(var(--journey-scene-progress, 0) * 2px));
    transition: opacity .35s ease, filter .35s ease;
}
.nj-stage-ring {
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: inset 0 0 45px rgba(255,255,255,.04), 0 0 40px rgba(59,130,246,.08);
}
.nj-stage-ring-a { inset: 12% 16%; animation: orbitSpin 20s linear infinite; }
.nj-stage-ring-b { inset: 20% 24%; border-color: rgba(103,232,249,.18); animation: orbitSpinReverse 24s linear infinite; }
.nj-stage-ring-c { inset: 30% 34%; border-color: rgba(245,158,11,.18); animation: orbitSpin 16s linear infinite; }
@keyframes orbitSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes orbitSpinReverse { from { transform: rotate(360deg); } to { transform: rotate(0deg); } }
.nj-stage-badge {
    padding: .45rem .8rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(5, 11, 29, .5);
    backdrop-filter: blur(10px);
    color: rgba(255,255,255,.75);
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
}
.nj-stage-badge-a { top: 11%; right: 11%; }
.nj-stage-badge-b { bottom: 13%; left: 10%; }
.nj-stage-beacon {
    top: 47%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6.25rem;
    height: 6.25rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle, rgba(103,232,249,.24), rgba(103,232,249,0));
}
.nj-stage-beacon-core {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #67e8f9, #3b82f6);
    box-shadow: 0 0 0 10px rgba(103,232,249,.12), 0 0 28px rgba(103,232,249,.5);
    animation: beaconPulse 2.8s ease-in-out infinite;
}
.nj-stage-beacon-label {
    position: absolute;
    bottom: -1.8rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: .74rem;
    color: rgba(255,255,255,.62);
    letter-spacing: .12em;
    text-transform: uppercase;
}
@keyframes beaconPulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 10px rgba(103,232,249,.12), 0 0 28px rgba(103,232,249,.5); }
    50% { transform: scale(1.12); box-shadow: 0 0 0 18px rgba(103,232,249,.08), 0 0 38px rgba(103,232,249,.7); }
}
.nj-stage-card {
    padding: 1rem 1.05rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(255,255,255,.12);
    background: linear-gradient(180deg, rgba(10,18,41,.82), rgba(10,18,41,.56));
    backdrop-filter: blur(12px);
    box-shadow: 0 22px 50px rgba(2, 6, 21, .34);
    color: #fff;
}
.nj-stage-card-main { top: 9%; left: 7%; width: 250px; animation: floatCardA 10s ease-in-out infinite; }
.nj-stage-card-secondary { right: 6%; top: 29%; width: 220px; animation: floatCardB 11s ease-in-out infinite; }
.nj-stage-card-tertiary { left: 11%; bottom: 10%; width: 280px; animation: floatCardC 12s ease-in-out infinite; }
@keyframes floatCardA { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -14px, 0); } }
@keyframes floatCardB { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -12px, 0); } }
@keyframes floatCardC { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -10px, 0); } }
.nj-stage-card-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    margin-bottom: .7rem;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: rgba(255,255,255,.58);
}
.nj-stage-card-eyebrow::before {
    content: '';
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: #67e8f9;
}
.nj-stage-card-main strong,
.nj-stage-card-secondary h3 {
    display: block;
    margin: 0 0 .4rem;
    font-size: 2.6rem;
    line-height: .94;
    letter-spacing: -.05em;
}
.nj-stage-card-secondary h3 { font-size: 1.18rem; line-height: 1.2; }
.nj-stage-card p { margin: 0; color: rgba(255,255,255,.72); font-size: .84rem; line-height: 1.55; }
.nj-stage-bars { display: grid; gap: .45rem; margin-top: 1rem; }
.nj-stage-bars span {
    display: block;
    height: .42rem;
    width: var(--bar-size);
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(103,232,249,.85), rgba(59,130,246,.35));
}
.nj-stage-metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .7rem;
    margin-top: .85rem;
}
.nj-stage-metric-grid strong { display: block; font-size: 1.2rem; line-height: 1; margin-bottom: .3rem; }
.nj-stage-metric-grid span { font-size: .74rem; color: rgba(255,255,255,.58); text-transform: uppercase; letter-spacing: .08em; }
.nj-stage-chip {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .55rem .85rem;
    border-radius: 999px;
    background: rgba(5, 11, 29, .6);
    border: 1px solid rgba(255,255,255,.14);
    backdrop-filter: blur(10px);
    color: rgba(255,255,255,.8);
    font-size: .78rem;
}
.nj-stage-chip span { width: .55rem; height: .55rem; border-radius: 50%; }
.nj-stage-chip-a { top: 18%; right: 12%; }
.nj-stage-chip-a span { background: #67e8f9; }
.nj-stage-chip-b { right: 8%; bottom: 17%; }
.nj-stage-chip-b span { background: #f59e0b; }
.nj-stage-chip-c { left: 12%; top: 44%; }
.nj-stage-chip-c span { background: #a855f7; }

.nj-scroll-indicator {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(255,255,255,.56);
    animation: scrollBounce 2s ease-in-out infinite;
    text-align: center;
    font-size: .78rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: calc(1 - (var(--hero-progress) * 1.8));
}
@keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
}

.nj-signal-section {
    position: relative;
    z-index: 3;
    padding: 3.5rem 0 2.75rem;
    background: linear-gradient(180deg, #06101f 0%, #09121f 68%, rgba(6, 16, 31, .96) 100%);
}
.nj-signal-shell {
    border-radius: 1.75rem;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    border: 1px solid rgba(148, 163, 184, .16);
    background: linear-gradient(180deg, rgba(9, 18, 31, .92), rgba(9, 18, 31, .72));
    box-shadow: 0 30px 80px rgba(2, 6, 23, .34);
    backdrop-filter: blur(14px);
}
.nj-chapter-label {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    padding: .58rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, .22);
    background: rgba(255, 255, 255, .66);
    color: #0f172a;
    opacity: 0;
    transform: translate3d(-20px, 0, 0);
}
.nj-chapter-label.is-visible { opacity: 1; transform: translate3d(0, 0, 0); }
.nj-chapter-label.is-visible,
#proofLabel,
#proofLabel.is-visible {
    color: #ffffff;
    opacity: 1;
}
.nj-chapter-label.is-dark {
    background: rgba(255,255,255,.06);
    color: #ffffff;
    border-color: rgba(255,255,255,.12);
}
.nj-chapter-index {
    font-size: .72rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: .72;
}
.nj-chapter-text {
    font-size: .92rem;
    font-weight: 700;
    letter-spacing: .02em;
}
.nj-chapter-cursor {
    width: .5rem;
    height: 1rem;
    border-radius: 999px;
    background: currentColor;
    animation: chapterBlink 1s steps(1, end) infinite;
}
@keyframes chapterBlink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: .2; } }
.nj-signal-intro,
.nj-journey-note,
.nj-proof-intro {
    max-width: 46rem;
    margin: 1rem 0 0;
    line-height: 1.75;
    color: rgba(226, 232, 240, .74);
}
.nj-proof-intro { color: #566274; }
.nj-ticker {
    --ticker-progress: 0;
    height: 56px;
    margin-top: 1.6rem;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, .18);
    background: rgba(15, 12, 41, .92);
    backdrop-filter: blur(8px);
    position: relative;
    opacity: 0;
    transform: translate3d(0, calc((1 - var(--ticker-progress)) * 42px), 0) scale(calc(.94 + (var(--ticker-progress) * .06)));
    filter: blur(calc((1 - var(--ticker-progress)) * 8px));
    transition: opacity .4s ease, transform .18s linear, filter .18s linear;
    animation: tickerIn 0.5s ease 0.8s both;
}
@keyframes tickerIn { to { opacity: 0.8; transform: translate3d(0,0,0) scale(1); filter: blur(0); } }
.nj-ticker.revealed { animation: none; opacity: calc(.25 + (var(--ticker-progress) * .75)); }
.nj-ticker-track {
    display: flex;
    align-items: center;
    height: 100%;
    animation: tickerScroll 55s linear infinite;
    width: max-content;
}
.nj-ticker:hover .nj-ticker-track { animation-play-state: paused; }
@keyframes tickerScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.nj-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: 0 1.6rem;
    white-space: nowrap;
    color: rgba(255,255,255,.78);
    font-size: .82rem;
    font-weight: 500;
    opacity: 1 !important;
    transform: none !important;
    transition: opacity 0.4s ease;
}
.nj-ticker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
}
.nj-ticker-dot.project { background: #3b82f6; }
.nj-ticker-dot.investment { background: #06d6a0; }
.nj-ticker-dot.mentorship { background: #f59e0b; }
.nj-ticker-dot.community { background: #a855f7; }
.nj-ticker-dot.user { background: #94a3b8; }
.nj-signal-empty {
    margin-top: 1.6rem;
    padding: 1rem 1.2rem;
    border-radius: 1rem;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.68);
}

.nj-journey {
    position: relative;
    height: 500vh;
    background:
        radial-gradient(circle at 18% 22%, rgba(103, 232, 249, .08), transparent 24%),
        radial-gradient(circle at 84% 16%, rgba(245, 158, 11, .08), transparent 18%),
        linear-gradient(180deg, #07101c 0%, #0a1220 54%, #0d1320 100%);
    color: #fff;
    z-index: 4;
}
.nj-journey-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
}
.nj-journey-head {
    position: absolute;
    top: clamp(1.2rem, 4vw, 2.4rem);
    left: clamp(1rem, 4vw, 3rem);
    z-index: 16;
    max-width: 34rem;
}
.nj-journey-track {
    --journey-translate: 0vw;
    display: flex;
    width: 600vw;
    height: 100%;
    transform: translate3d(var(--journey-translate), 0, 0);
    will-change: transform;
}
.nj-journey-slide {
    --slide-active: 0;
    position: relative;
    width: 100vw;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8.5rem 0 4rem;
    opacity: calc(.38 + (var(--slide-active) * .62));
}
.nj-journey-slide::before {
    content: '';
    position: absolute;
    inset: 16% auto auto 7%;
    width: 24rem;
    height: 24rem;
    border-radius: 50%;
    background: var(--slide-glow);
    filter: blur(26px);
    opacity: calc(.18 + (var(--slide-active) * .24));
}
.nj-journey-slide-inner {
    position: relative;
    z-index: 2;
    width: min(78rem, calc(100vw - 4rem));
    margin: 0 auto;
    padding-right: min(36vw, 24rem);
}
.nj-journey-panel {
    max-width: min(42rem, calc(100vw - 4rem));
    min-height: 30rem;
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 2.6rem);
    position: relative;
    left: auto;
    right: auto;
    border-radius: 2rem;
    border: 1px solid rgba(255,255,255,.12);
    background:
        linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03)),
        var(--slide-gradient);
    box-shadow: 0 36px 90px rgba(2, 6, 23, .34);
    backdrop-filter: blur(12px);
    transform: translate3d(0, calc((1 - var(--slide-active)) * 36px), 0) scale(calc(.92 + (var(--slide-active) * .08)));
    transition: transform .18s linear, box-shadow .3s ease;
}
.nj-journey-topline {
    display: flex;
    align-items: center;
    gap: .8rem;
    margin-bottom: 1.25rem;
}
.nj-journey-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.18);
    font-weight: 800;
    letter-spacing: .08em;
}
.nj-journey-step {
    display: inline-flex;
    align-items: center;
    padding: .5rem .8rem;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.14);
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: rgba(255,255,255,.74);
}
.nj-journey-icon {
    width: 4rem;
    height: 4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.2rem;
    margin-bottom: 1.4rem;
    background: var(--slide-surface);
    border: 1px solid rgba(255,255,255,.16);
    font-size: 1.55rem;
    color: var(--slide-accent);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
}
.nj-journey-panel h3 {
    margin: 0 0 1rem;
    font-size: clamp(2.3rem, 4vw, 3.7rem);
    line-height: .96;
    letter-spacing: -.05em;
    max-width: 10ch;
}
.nj-journey-panel p {
    margin: 0 0 1.35rem;
    max-width: 33rem;
    color: rgba(255,255,255,.78);
    line-height: 1.78;
}
.nj-journey-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-bottom: 1.7rem;
}
.nj-journey-metrics span {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .6rem .9rem;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.14);
    color: rgba(255,255,255,.82);
    font-size: .84rem;
}
.nj-journey-cta {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: .9rem 1.15rem;
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.16);
    box-shadow: 0 18px 40px rgba(2, 6, 23, .18);
}
.nj-journey-cta:hover { color: #fff; transform: translateY(-2px); }
.nj-journey-dots {
    position: absolute;
    left: 50%;
    bottom: clamp(1.3rem, 4vw, 2rem);
    transform: translateX(-50%);
    z-index: 16;
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    padding: .7rem .9rem;
    border-radius: 999px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    backdrop-filter: blur(14px);
}
.nj-journey-dot {
    --dot-active: 0;
    display: block;
    width: .72rem;
    height: .72rem;
    border-radius: 50%;
    background: var(--dot-color);
    opacity: calc(.32 + (var(--dot-active) * .68));
    transform: scale(calc(.7 + (var(--dot-active) * .55)));
    box-shadow: 0 0 calc(18px * var(--dot-active)) var(--dot-color);
    transition: transform .2s ease, opacity .2s ease;
}

.nj-social-proof {
    position: relative;
    z-index: 3;
    padding: 4.5rem 0 0;
    background: #0d0f1a;
    color: #e2e8f0;
}
.nj-social-proof .nj-chapter-label,
.nj-social-proof .nj-proof-intro {
    color: #e2e8f0;
}
.nj-impact-grid {
    --impact-progress: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.35rem;
    margin-top: 2rem;
    opacity: 0;
    transform: translate3d(0, calc(30px + ((1 - var(--impact-progress)) * 7vh)), 0) scale(calc(.95 + (var(--impact-progress) * .05)));
    transition: opacity .6s ease, transform .18s linear;
}
.nj-impact-grid.revealed {
    opacity: calc(.25 + (var(--impact-progress) * .75));
    transform: translate3d(0, calc((1 - var(--impact-progress)) * 7vh), 0) scale(calc(.95 + (var(--impact-progress) * .05)));
}
.nj-impact-card {
    position: relative;
    padding: 1.55rem 1.25rem;
    border-radius: 1.5rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 18px 50px rgba(15, 23, 42, .08);
    color: #e2e8f0;
    display: grid;
    justify-items: center;
    gap: .7rem;
    overflow: hidden;
    backdrop-filter: blur(14px);
}
.nj-impact-card::before {
    content: '';
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
}
.nj-impact-card:nth-child(1)::before { background: radial-gradient(circle, rgba(99,102,241,0.18) 0%, transparent 70%); }
.nj-impact-card:nth-child(2)::before { background: radial-gradient(circle, rgba(6,182,212,0.18) 0%, transparent 70%); }
.nj-impact-card:nth-child(3)::before { background: radial-gradient(circle, rgba(245,158,11,0.18) 0%, transparent 70%); }
.nj-impact-card:nth-child(4)::before { background: radial-gradient(circle, rgba(168,85,247,0.18) 0%, transparent 70%); }
.nj-impact-card::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 5rem;
    background: linear-gradient(180deg, transparent, rgba(15, 23, 42, .03));
}
.nj-impact-num { font-size: 2.8rem; font-weight: 800; color: #ffffff; line-height: 1; position: relative; z-index: 1; }
.nj-impact-label { font-weight: 700; font-size: .95rem; color: rgba(255,255,255,0.6); }
.nj-impact-sub { font-size: .78rem; color: rgba(255,255,255,0.6); margin-top: -.15rem; }

.nj-strengths {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
    margin-top: 3rem;
}
.nj-strength-card {
    --story-shift: 0px;
    --story-tilt: 0deg;
    --magnetic-x: 0px;
    --magnetic-y: 0px;
    --magnetic-rotate-x: 0deg;
    --magnetic-rotate-y: 0deg;
    background: linear-gradient(180deg, #111827, #0f172a 68%, #10192c 100%);
    border-radius: 1.1rem;
    padding: 1.35rem 1.4rem;
    color: #fff;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .14);
    opacity: 0;
    transform: translate3d(calc(-30px + var(--magnetic-x)), calc(var(--story-shift) + var(--magnetic-y)), 0) rotateX(calc(var(--story-tilt) + var(--magnetic-rotate-x))) rotateY(var(--magnetic-rotate-y));
    transform-style: preserve-3d;
    transition: opacity .4s ease, transform .18s linear, box-shadow .25s ease;
}
.nj-strength-card.revealed {
    opacity: 1;
    transform: translate3d(var(--magnetic-x), calc(var(--story-shift) + var(--magnetic-y)), 0) rotateX(calc(var(--story-tilt) + var(--magnetic-rotate-x))) rotateY(var(--magnetic-rotate-y));
}
.nj-strength-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
}
.nj-strength-card:nth-child(1)::before { background: #3b82f6; }
.nj-strength-card:nth-child(2)::before { background: #06d6a0; }
.nj-strength-card:nth-child(3)::before { background: #f59e0b; }
.nj-strength-card:nth-child(4)::before { background: #a855f7; }
.nj-strength-card i { font-size: 1.4rem; margin-bottom: .55rem; display: block; color: rgba(255,255,255,.92); }
.nj-strength-card h6 { font-weight: 700; font-size: .95rem; margin-bottom: .25rem; }
.nj-strength-card p { font-size: .8rem; color: rgba(255,255,255,.62); margin: 0; line-height: 1.65; }
.nj-strength-card.is-magnetic {
    transition: opacity .4s ease, transform .08s linear, box-shadow .18s ease;
    box-shadow: 0 24px 60px rgba(15, 23, 42, .22);
}
.nj-strength-card.is-magnetic-reset {
    transition: opacity .4s ease, transform .6s cubic-bezier(.16, 1, .3, 1), box-shadow .3s ease;
}

.nj-closing-section {
    position: relative;
    z-index: 3;
    padding: 3rem 0 5rem;
    background: #0d0f1a;
    padding-bottom: 0;
}
.nj-closing {
    --closing-progress: 0;
    border-radius: 2rem;
    background:
        radial-gradient(circle at 12% 18%, rgba(103,232,249,.16), transparent 20%),
        radial-gradient(circle at 88% 20%, rgba(245,158,11,.18), transparent 18%),
        linear-gradient(135deg, #08101f 0%, #0f172a 46%, #131129 100%);
    border: 1px solid rgba(148, 163, 184, .16);
    box-shadow: 0 34px 90px rgba(2, 6, 23, .24);
    overflow: hidden;
    opacity: 0;
    transform: translate3d(0, calc((1 - var(--closing-progress)) * 8vh), 0) scale(calc(.94 + (var(--closing-progress) * .06)));
    transition: opacity .8s ease, transform .18s linear;
}
.nj-closing.revealed {
    opacity: calc(.2 + (var(--closing-progress) * .8));
    transform: translate3d(0, calc((1 - var(--closing-progress)) * 8vh), 0) scale(calc(.94 + (var(--closing-progress) * .06)));
}
.nj-closing-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, .88fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(1.6rem, 4vw, 2.8rem);
}
.nj-closing-copy {
    color: #fff;
    max-width: 38rem;
}
.nj-closing-copy h2 {
    margin: 1.1rem 0 1rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: .98;
    letter-spacing: -.04em;
}
.nj-closing-copy p {
    margin: 0 0 1.6rem;
    color: rgba(226, 232, 240, .76);
    line-height: 1.78;
}
.nj-closing-actions {
    display: flex;
    gap: .9rem;
    flex-wrap: wrap;
}
.nj-closing .btn-hero-primary {
    animation: closingBreath 4.5s ease-in-out infinite;
}
@keyframes closingBreath {
    0%, 100% { transform: translateY(0) scale(1); box-shadow: 0 18px 40px rgba(59,130,246,.28); }
    50% { transform: translateY(-2px) scale(1.03); box-shadow: 0 24px 56px rgba(59,130,246,.36); }
}
.nj-closing-visual {
    position: relative;
    min-height: 360px;
    border-radius: 1.7rem;
    border: 1px solid rgba(255,255,255,.12);
    background:
        linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03)),
        linear-gradient(160deg, rgba(6, 13, 30, .82), rgba(12, 22, 49, .8));
    overflow: hidden;
}
.nj-closing-visual::before,
.nj-closing-visual::after {
    content: '';
    position: absolute;
    border-radius: 50%;
}
.nj-closing-visual::before {
    inset: 12% 18%;
    border: 1px solid rgba(255,255,255,.12);
    animation: orbitSpin 22s linear infinite;
}
.nj-closing-visual::after {
    inset: 24% 30%;
    border: 1px solid rgba(103,232,249,.18);
    animation: orbitSpinReverse 18s linear infinite;
}
.nj-closing-core {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8rem;
    height: 8rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(103,232,249,.36), rgba(59,130,246,.16) 52%, transparent 70%);
    display: grid;
    place-items: center;
}
.nj-closing-core::before {
    content: '';
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #67e8f9, #3b82f6);
    box-shadow: 0 0 0 10px rgba(103,232,249,.08), 0 0 34px rgba(103,232,249,.45);
}
.nj-closing-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .65rem .95rem;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    color: rgba(255,255,255,.82);
    backdrop-filter: blur(10px);
    font-size: .8rem;
}
.nj-closing-chip span {
    width: .55rem;
    height: .55rem;
    border-radius: 50%;
}
.nj-closing-chip-a { top: 14%; right: 10%; }
.nj-closing-chip-a span { background: #67e8f9; }
.nj-closing-chip-b { left: 10%; bottom: 16%; }
.nj-closing-chip-b span { background: #f59e0b; }
.nj-closing-chip-c { right: 12%; bottom: 22%; }
.nj-closing-chip-c span { background: #8b5cf6; }

@media (max-width: 991px) {
    .nj-hero-shell {
        grid-template-columns: 1fr;
        padding: 6.5rem 0 4rem;
    }
    .nj-hero-stage { min-height: 540px; }
    .nj-stage-shell {
        min-height: 540px;
        width: min(100%, 620px);
        margin: 0 auto;
    }
    .nj-impact-grid,
    .nj-strengths { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nj-closing-shell { grid-template-columns: 1fr; }
}

@media (max-width: 819px) {
    .nj-journey {
        height: auto;
        padding: 3rem 0 4rem;
    }
    .nj-journey-sticky {
        position: relative;
        height: auto;
        overflow: visible;
    }
    .nj-journey-head {
        position: relative;
        top: auto;
        left: auto;
        padding: 0 1rem 1.5rem;
    }
    .nj-journey-track {
        width: 100%;
        display: grid;
        gap: 1rem;
        transform: none !important;
    }
    .nj-journey-slide {
        width: auto;
        height: auto;
        padding: 0 1rem;
        opacity: 1;
    }
    .nj-journey-slide::before { inset: 1rem auto auto 10%; width: 18rem; height: 18rem; }
    .nj-journey-slide-inner { width: 100%; padding-right: 0; }
    .nj-journey-panel {
        max-width: 100%;
        min-height: auto;
        transform: none;
    }
    .nj-journey-dots { display: none; }
    .nj-stage-shell.is-journey-fixed {
        position: relative;
        top: auto;
        right: auto;
        width: min(100%, 620px);
        min-height: 540px;
        pointer-events: auto;
    }
}

@media (max-width: 767px) {
    .nj-hero { min-height: 128vh; }
    .nj-hero-title { font-size: 2.45rem; line-height: .98; }
    .nj-hero-lead { font-size: .98rem; }
    .nj-hero-stats { grid-template-columns: 1fr; }
    .nj-stage-shell {
        min-height: 500px;
        border-radius: 1.5rem;
    }
    .nj-stage-card-main { top: 8%; left: 5%; width: 220px; }
    .nj-stage-card-secondary { right: 4%; top: 31%; width: 200px; }
    .nj-stage-card-tertiary { left: 6%; bottom: 8%; width: 240px; }
    .nj-impact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
}

@media (max-width: 575px) {
    .nj-hero-shell {
        width: min(100% - 1.25rem, 100%);
        padding-top: 6rem;
    }
    .nj-hero-actions .btn-hero-primary,
    .nj-hero-actions .btn-hero-secondary,
    .nj-closing-actions .btn-hero-primary,
    .nj-closing-actions .btn-hero-secondary {
        width: 100%;
        text-align: center;
        justify-content: center;
    }
    .nj-stage-shell { min-height: 470px; }
    .nj-stage-card-main,
    .nj-stage-card-secondary,
    .nj-stage-card-tertiary {
        position: relative;
        top: auto;
        left: auto;
        right: auto;
        bottom: auto;
        width: auto;
        margin: 1rem;
        animation: none;
    }
    .nj-stage-card-secondary,
    .nj-stage-card-tertiary,
    .nj-stage-chip-b,
    .nj-stage-chip-c,
    .nj-stage-badge-b { display: none; }
    .nj-stage-beacon { top: 45%; }
    .nj-impact-grid,
    .nj-strengths { grid-template-columns: 1fr; }
    .nj-closing-visual { min-height: 300px; }
}

@media (prefers-reduced-motion: reduce) {
    .nj-hero-title-accent,
    .nj-stage-ring-a,
    .nj-stage-ring-b,
    .nj-stage-ring-c,
    .nj-stage-beacon-core,
    .nj-stage-card-main,
    .nj-stage-card-secondary,
    .nj-stage-card-tertiary,
    .nj-scroll-indicator,
    .nj-chapter-cursor,
    .nj-closing .btn-hero-primary,
    .nj-closing-visual::before,
    .nj-closing-visual::after {
        animation: none !important;
    }
    .nj-ticker-track { animation-duration: .01ms; animation-iteration-count: 1; transform: none; }
}

/* ── Hero: always dark regardless of theme ── */
.nj-hero, .nj-hero * { color-scheme: dark; }
.nj-stat-pill { background: rgba(255,255,255,.12) !important; color: #fff !important; border-color: rgba(255,255,255,.18) !important; }
[data-bs-theme="light"] .nj-stat-pill { background: rgba(255,255,255,.88) !important; color: #0f172a !important; border-color: rgba(255,255,255,.95) !important; }
.nj-hero-lead { color: rgba(233,240,255,.76) !important; }
.nj-hero-title { color: #fff !important; }
.nj-hero-meta-pill { color: rgba(255,255,255,.74) !important; background: rgba(255,255,255,.06) !important; }
.nj-hero-stat { color: rgba(255,255,255,.9) !important; }
.nj-hero-stat .stat-num { color: #fff !important; }
.nj-hero-stat .stat-label { color: rgba(255,255,255,.55) !important; }
.nj-hero-kicker { color: rgba(255,255,255,.78) !important; }

/* ── Audience section: light-mode friendly ── */
[data-bs-theme="light"] .nj-audience-section {
    background: linear-gradient(180deg, #eef2ff 0%, #e8edf8 100%) !important;
}
[data-bs-theme="light"] .nj-audience-section h3 { color: #0f172a !important; }
[data-bs-theme="light"] .nj-audience-section .text-muted { color: #475569 !important; }
[data-bs-theme="light"] .nj-audience-card {
    background: #ffffff !important;
    border: 1px solid rgba(67,97,238,.15) !important;
    box-shadow: 0 4px 20px rgba(67,97,238,.08) !important;
    color: #1e293b !important;
}
[data-bs-theme="light"] .nj-audience-card h4,
[data-bs-theme="light"] .nj-audience-card strong { color: #0f172a !important; font-size: 1.1rem; }
[data-bs-theme="light"] .nj-audience-card p { color: #475569 !important; }
[data-bs-theme="light"] .nj-audience-points li { color: #475569 !important; }
[data-bs-theme="light"] .nj-audience-points li i { color: var(--nj-primary) !important; }
[data-bs-theme="light"] .nj-audience-icon { background: rgba(67,97,238,.1) !important; }
[data-bs-theme="light"] .nj-audience-icon i { color: var(--nj-primary) !important; }
</style>
{% endblock %}

{% block main %}
{# Force dark mode on html element before Bootstrap theme loader fires #}
<script>document.documentElement.setAttribute('data-bs-theme','dark');</script>
{% set isGuest = not is_granted('ROLE_USER') %}
{% set modules = [
    {
        icon: "bi-cash-stack",
        eyebrow: "Active capital",
        gradient: "linear-gradient(140deg, rgba(30, 64, 175, .94), rgba(14, 116, 144, .86) 56%, rgba(15, 23, 42, .92) 100%)",
        surface: "rgba(59, 130, 246, .16)",
        glow: "radial-gradient(circle, rgba(59,130,246,.28), transparent 68%)",
        accent: "#60a5fa",
        title: "Find the capital that matches the right signal.",
        desc: "Post a clear opportunity, structure the offer, negotiate in a clean framework and advance the discussion through to contract.",
        stat: platformStats.openOpportunities ~ " active opportunities",
        secondary: platformStats.totalInvestors ~ " investors on the lookout",
        cta: "Explore opportunities",
        route: path('app_invest_opportunities')
    },
    {
        icon: "bi-rocket-takeoff",
        eyebrow: "Structured execution",
        gradient: "linear-gradient(140deg, rgba(194, 65, 12, .92), rgba(234, 88, 12, .82) 56%, rgba(51, 25, 8, .94) 100%)",
        surface: "rgba(249, 115, 22, .16)",
        glow: "radial-gradient(circle, rgba(249,115,22,.22), transparent 70%)",
        accent: "#fb923c",
        title: "Turn an idea into a readable, solid and shareable project.",
        desc: "Frame the proposition, track key milestones, make the project visible and keep momentum when attention arrives.",
        stat: platformStats.totalProjects ~ " projects in progress",
        secondary: platformStats.activeProjects ~ " projects still active",
        cta: "Enter my projects",
        route: path('app_projet_index')
    },
    {
        icon: "bi-people-fill",
        eyebrow: "Community energy",
        gradient: "linear-gradient(140deg, rgba(88, 28, 135, .94), rgba(109, 40, 217, .84) 54%, rgba(24, 24, 51, .94) 100%)",
        surface: "rgba(139, 92, 246, .16)",
        glow: "radial-gradient(circle, rgba(168,85,247,.24), transparent 70%)",
        accent: "#c084fc",
        title: "Circulate feedback, contacts and social traction.",
        desc: "LockedIn doesn't leave projects alone. The community brings visibility, feedback and context that saves time.",
        stat: platformStats.totalUsers ~ " active members",
        secondary: platformStats.totalEntrepreneurs ~ " entrepreneurs present",
        cta: "See the community",
        route: path('app_community_posts')
    },
    {
        icon: "bi-mortarboard",
        eyebrow: "Useful mentoring",
        gradient: "linear-gradient(140deg, rgba(6, 95, 70, .94), rgba(13, 148, 136, .82) 54%, rgba(6, 32, 33, .94) 100%)",
        surface: "rgba(20, 184, 166, .16)",
        glow: "radial-gradient(circle, rgba(20,184,166,.2), transparent 70%)",
        accent: "#2dd4bf",
        title: "Activate the right person at the right moment in the journey.",
        desc: "Mentors step in when the question is real: clarify an offer, unblock a step, prepare a decision.",
        stat: platformStats.totalMentorsAvail ~ " mentors available",
        secondary: platformStats.totalSessions ~ " sessions already conducted",
        cta: "Find a mentor",
        route: path('app_mentorat_requests')
    },
    {
        icon: "bi-people-fill",
        eyebrow: "Co-founders & Partners",
        gradient: "linear-gradient(140deg, rgba(67, 56, 202, .94), rgba(99, 102, 241, .82) 54%, rgba(17, 24, 39, .94) 100%)",
        surface: "rgba(99, 102, 241, .16)",
        glow: "radial-gradient(circle, rgba(99,102,241,.24), transparent 70%)",
        accent: "#818cf8",
        title: "Find the right co-founder, partner, or collaborator.",
        desc: "AI-guided matching connects you with the people who complement your skills, share your vision, and accelerate your deal.",
        stat: platformStats.totalUsers ~ " profiles to explore",
        secondary: "AI-powered compatibility matching",
        cta: "Find co-founders",
        route: path('app_team_matcher_index')
    },
    {
        icon: "bi-person-vcard",
        eyebrow: "Readable identity",
        gradient: "linear-gradient(140deg, rgba(161, 98, 7, .94), rgba(245, 158, 11, .84) 54%, rgba(47, 32, 7, .94) 100%)",
        surface: "rgba(245, 158, 11, .16)",
        glow: "radial-gradient(circle, rgba(245,158,11,.2), transparent 70%)",
        accent: "#fbbf24",
        title: "Make your profile an entry point that inspires trust.",
        desc: "The platform assembles reputation, activity, mentoring and trajectory to give an immediate read of your presence.",
        stat: platformStats.totalUsers ~ " visible profiles",
        secondary: platformStats.fundedDeals ~ " deals as social proof",
        cta: "Open my profile",
        route: path('app_profile')
    }
] %}
{% set closingRoute = is_granted('ROLE_ADMIN') ? path('admin_dashboard') : path('app_projet_index') %}

<section class="nj-hero" id="njHero" data-bs-theme="dark">
    <div class="nj-hero-grid"></div>
    <div class="nj-hero-orb nj-hero-orb-a"></div>
    <div class="nj-hero-orb nj-hero-orb-b"></div>
    <div class="nj-hero-orb nj-hero-orb-c"></div>

    <div class="nj-hero-shell">
        <div class="nj-hero-copy">
            <div class="nj-hero-kicker">
                <span class="nj-hero-kicker-dot"></span>
                Tunisian Startup Ecosystem
            </div>

            <div class="nj-stat-pill" id="heroPill">
                <span id="heroPillText">{{ platformStats.activeProjects }} active projects</span>
            </div>

            {% if isGuest %}
                <h1 class="nj-hero-title">
                    <span class="nj-hero-title-line">A platform that gives</span>
                    <span class="nj-hero-title-line nj-hero-title-accent">depth to your ambition.</span>
                </h1>
                <p class="lead nj-hero-lead">LockedIn connects funding, mentoring and community in one experience designed to take a project from weak signal to concrete deal.</p>
            {% else %}
                <h1 class="nj-hero-title">
                    <span class="nj-hero-title-line">Steer your projects with</span>
                    <span class="nj-hero-title-line nj-hero-title-accent">a visible and vibrant deal flow.</span>
                </h1>
                <p class="lead nj-hero-lead">Track opportunities, activate mentors, expose your projects and circulate ecosystem energy from a single cockpit.</p>
            {% endif %}

            <div class="nj-hero-actions">
                {% if app.user %}
                    <a href="{{ path('app_projet_index') }}" class="btn btn-hero-primary">My Projects</a>
                    <a href="{{ path('app_invest_opportunities') }}" class="btn btn-hero-secondary">Investment Opportunities</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-hero-primary">Join LockedIn - it's free</a>
                    <a href="{{ path('app_login') }}" class="btn btn-hero-secondary">Sign In</a>
                {% endif %}
            </div>

            <div class="nj-hero-meta">
                <span class="nj-hero-meta-pill"><i class="bi bi-graph-up-arrow"></i> Investment</span>
                <span class="nj-hero-meta-pill"><i class="bi bi-people-fill"></i> Community</span>
                <span class="nj-hero-meta-pill"><i class="bi bi-mortarboard"></i> Mentoring</span>
                <span class="nj-hero-meta-pill"><i class="bi bi-people-fill"></i> Co-founders</span>
            </div>

            <div class="nj-hero-stats">
                <div class="nj-hero-stat">
                    <span class="stat-num" data-count="{{ platformStats.activeProjects }}">0</span>
                    <span class="stat-label">Active projects</span>
                </div>
                <div class="nj-hero-stat">
                    <span class="stat-num" data-count="{{ platformStats.totalInvestors }}">0</span>
                    <span class="stat-label">Investors</span>
                </div>
                <div class="nj-hero-stat">
                    <span class="stat-num" data-count="{{ platformStats.fundedDeals }}">0</span>
                    <span class="stat-label">Funded deals</span>
                </div>
            </div>
        </div>

        <div class="nj-hero-stage" id="heroStage">
            <div class="nj-stage-shell" id="heroStageShell">
                <canvas class="nj-hero-canvas" id="heroCanvas"></canvas>
                <div class="nj-stage-ring nj-stage-ring-a"></div>
                <div class="nj-stage-ring nj-stage-ring-b"></div>
                <div class="nj-stage-ring nj-stage-ring-c"></div>

                <div class="nj-stage-badge nj-stage-badge-a">Immersive deal map</div>
                <div class="nj-stage-badge nj-stage-badge-b">Tunisian founder signal</div>

                <article class="nj-stage-card nj-stage-card-main">
                    <span class="nj-stage-card-eyebrow">Open pipeline</span>
                    <strong>{{ platformStats.openOpportunities }}</strong>
                    <p>opportunities currently in discussion on the platform.</p>
                    <div class="nj-stage-bars">
                        <span style="--bar-size:92%"></span>
                        <span style="--bar-size:78%"></span>
                        <span style="--bar-size:64%"></span>
                    </div>
                </article>

                <article class="nj-stage-card nj-stage-card-secondary">
                    <span class="nj-stage-card-eyebrow">Latest momentum</span>
                    <h3>{{ platformStats.latestProjectName ? platformStats.latestProjectName : 'Featured Project' }}</h3>
                    <p>{{ platformStats.latestProjectSector ? platformStats.latestProjectSector : 'Tunisian Ecosystem' }}</p>
                </article>

                <article class="nj-stage-card nj-stage-card-tertiary">
                    <span class="nj-stage-card-eyebrow">Platform reach</span>
                    <p>A network connecting the right actors at the right moment.</p>
                    <div class="nj-stage-metric-grid">
                        <div>
                            <strong>{{ platformStats.totalUsers }}</strong>
                            <span>Members</span>
                        </div>
                        <div>
                            <strong>{{ platformStats.totalMentorsAvail }}</strong>
                            <span>Mentors</span>
                        </div>
                        <div>
                            <strong>{{ platformStats.totalSessions }}</strong>
                            <span>Sessions</span>
                        </div>
                        <div>
                            <strong>{{ platformStats.fundedDeals }}</strong>
                            <span>Deals</span>
                        </div>
                    </div>
                </article>

                <div class="nj-stage-chip nj-stage-chip-a"><span></span>{{ platformStats.totalUsers }} active members</div>
                {% if platformStats.fundedDeals > 0 %}
                <div class="nj-stage-chip nj-stage-chip-b"><span></span>{{ platformStats.fundedDeals }} funded deals</div>
                {% endif %}
                {% if platformStats.totalMentorsAvail > 0 %}
                <div class="nj-stage-chip nj-stage-chip-c"><span></span>{{ platformStats.totalMentorsAvail }} mentors available</div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="nj-scroll-indicator">
        <div>Explore</div>
        <i class="bi bi-chevron-down" style="font-size:1.5rem"></i>
    </div>
</section>

{% if isGuest %}
<section class="nj-audience-section">
    <div class="container">
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-2">Why join LockedIn?</h3>
            <p class="text-muted mb-0">Three profiles, three concrete reasons to enter the ecosystem.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="nj-audience-card" style="transition-delay:0ms">
                    <div class="nj-audience-icon" style="background:rgba(67,97,238,.12);color:var(--nj-primary)">
                        <i class="bi bi-rocket-takeoff"></i>
                    </div>
                    <h4>For entrepreneurs</h4>
                    <p>Give structure to your project, make it visible, and move forward with real support to fund and accelerate its execution.</p>
                    <ul class="nj-audience-points">
                        <li><i class="bi bi-check-circle-fill"></i><span>Publish a clear, credible project</span></li>
                        <li><i class="bi bi-check-circle-fill"></i><span>Connect with investors and mentors</span></li>
                        <li><i class="bi bi-check-circle-fill"></i><span>Advance your project with concrete tools</span></li>
                    </ul>
                    <a href="{{ path('app_register') }}" class="btn btn-nj w-100">Create my account for free</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="nj-audience-card" style="transition-delay:100ms">
                    <div class="nj-audience-icon" style="background:rgba(114,9,183,.12);color:var(--nj-accent)">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h4>For investors</h4>
                    <p>Spot real opportunities, evaluate projects faster, and connect with founders who need a solid partner.</p>
                    <ul class="nj-audience-points">
                        <li><i class="bi bi-check-circle-fill"></i><span>Browse entrepreneurial opportunities</span></li>
                        <li><i class="bi bi-check-circle-fill"></i><span>Negotiate offers in a structured framework</span></li>
                        <li><i class="bi bi-check-circle-fill"></i><span>Track funded deals on a single platform</span></li>
                    </ul>
                    <a href="{{ path('app_register') }}" class="btn btn-nj w-100">Join as an investor</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="nj-audience-card" style="transition-delay:200ms">
                    <div class="nj-audience-icon" style="background:rgba(6,214,160,.16);color:var(--nj-success)">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <h4>For mentors</h4>
                    <p>Share your experience with entrepreneurs who are moving forward, support meaningful projects, and make your expertise visible where it matters.</p>
                    <ul class="nj-audience-points">
                        <li><i class="bi bi-check-circle-fill"></i><span>Receive mentoring requests</span></li>
                        <li><i class="bi bi-check-circle-fill"></i><span>Intervene where your experience has real value</span></li>
                        <li><i class="bi bi-check-circle-fill"></i><span>Contribute to the Tunisian entrepreneurial ecosystem</span></li>
                    </ul>
                    <a href="{{ path('app_register') }}" class="btn btn-nj w-100">Become a mentor on LockedIn</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}

<section data-bs-theme="dark" style="position:relative;z-index:3;padding:4rem 0;background:linear-gradient(180deg,#06101f 0%,#0a1220 100%)">
    <div class="container">
        <div class="text-center mb-5">
            <div style="display:inline-flex;align-items:center;gap:.6rem;padding:.45rem 1rem;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);color:rgba(255,255,255,.7);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1.2rem">
                <span style="width:6px;height:6px;border-radius:50%;background:#67e8f9;box-shadow:0 0 8px rgba(103,232,249,.6)"></span>
                Six modules, one ecosystem
            </div>
            <h2 class="fw-bold text-white mb-2" style="font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-.03em">Everything your project needs to move forward</h2>
            <p style="color:rgba(226,232,240,.62);max-width:38rem;margin:0 auto;font-size:1rem;line-height:1.7">From the first idea to a signed deal — funding, mentoring, community and co-founders all in one place.</p>
        </div>

        <div class="row g-3">
            {% for m in modules %}
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="{{ m.route }}" class="text-decoration-none d-block h-100" style="border-radius:1.25rem;background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.1);padding:1.6rem 1.5rem;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease;color:inherit" onmouseover="this.style.transform='translateY(-3px)';this.style.borderColor='{{ m.accent }}55';this.style.boxShadow='0 16px 40px rgba(0,0,0,.3)'" onmouseout="this.style.transform='';this.style.borderColor='rgba(255,255,255,.1)';this.style.boxShadow=''">
                    <div style="width:44px;height:44px;border-radius:.9rem;background:{{ m.surface }};border:1px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;margin-bottom:1.1rem;font-size:1.25rem;color:{{ m.accent }}">
                        <i class="bi {{ m.icon }}"></i>
                    </div>
                    <div style="font-size:.7rem;text-transform:uppercase;letter-spacing:.14em;color:{{ m.accent }};font-weight:700;margin-bottom:.45rem">{{ m.eyebrow }}</div>
                    <div class="fw-bold text-white mb-2" style="font-size:.98rem;line-height:1.35">{{ m.title }}</div>
                    <div style="font-size:.83rem;color:rgba(255,255,255,.55);line-height:1.6">{{ m.desc }}</div>
                    <div style="margin-top:1rem;font-size:.8rem;font-weight:600;color:{{ m.accent }}">{{ m.cta }} →</div>
                </a>
            </div>
            {% endfor %}
        </div>

        {% if activityFeed|length > 0 %}
        <div style="margin-top:2.5rem;height:50px;overflow:hidden;border-radius:999px;border:1px solid rgba(148,163,184,.14);background:rgba(10,18,41,.8);backdrop-filter:blur(8px);position:relative">
            <div style="display:flex;align-items:center;height:100%;width:max-content;animation:tickerScroll 55s linear infinite">
                {% for event in activityFeed %}
                    <span style="display:inline-flex;align-items:center;gap:.45rem;padding:0 1.6rem;white-space:nowrap;color:rgba(255,255,255,.65);font-size:.8rem">
                        <span style="width:6px;height:6px;border-radius:50%;flex-shrink:0;background:{% if event.type == 'investment' %}#06d6a0{% elseif event.type == 'project' %}#3b82f6{% elseif event.type == 'mentorship' %}#f59e0b{% elseif event.type == 'community' %}#a855f7{% else %}#94a3b8{% endif %}"></span>
                        {{ event.text }} &middot; <span style="opacity:.45">{{ event.ago }}</span>
                    </span>
                {% endfor %}
                {% for event in activityFeed %}
                    <span style="display:inline-flex;align-items:center;gap:.45rem;padding:0 1.6rem;white-space:nowrap;color:rgba(255,255,255,.65);font-size:.8rem">
                        <span style="width:6px;height:6px;border-radius:50%;flex-shrink:0;background:{% if event.type == 'investment' %}#06d6a0{% elseif event.type == 'project' %}#3b82f6{% elseif event.type == 'mentorship' %}#f59e0b{% elseif event.type == 'community' %}#a855f7{% else %}#94a3b8{% endif %}"></span>
                        {{ event.text }} &middot; <span style="opacity:.45">{{ event.ago }}</span>
                    </span>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</section>


<section data-bs-theme="dark" style="position:relative;z-index:3;padding:5rem 0;background:linear-gradient(180deg,#0a1220 0%,#040816 100%)">
    <div class="container">
        <div style="border-radius:2rem;background:radial-gradient(circle at 15% 50%,rgba(67,97,238,.18),transparent 40%),radial-gradient(circle at 85% 50%,rgba(114,9,183,.14),transparent 40%),linear-gradient(135deg,#0d1425 0%,#111827 100%);border:1px solid rgba(255,255,255,.1);padding:clamp(2.5rem,6vw,4rem);display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center" class="flex-wrap">
            <div>
                {% if isGuest %}
                    <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .9rem;border-radius:999px;background:rgba(67,97,238,.15);border:1px solid rgba(67,97,238,.3);color:#818cf8;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1.4rem">
                        <span style="width:6px;height:6px;border-radius:50%;background:#818cf8;animation:beaconPulse 2s ease-in-out infinite"></span>
                        Free to join
                    </div>
                    <h2 class="text-white fw-bold mb-3" style="font-size:clamp(1.7rem,4vw,2.6rem);line-height:1.15;letter-spacing:-.03em;max-width:28rem">Your launchpad is ready. Your network is waiting.</h2>
                    <p style="color:rgba(226,232,240,.65);max-width:32rem;line-height:1.75;margin-bottom:2rem">Join entrepreneurs, investors and mentors building Tunisia's next generation of ventures. No credit card. No commitment. Just momentum.</p>
                    <div style="display:flex;gap:.8rem;flex-wrap:wrap">
                        <a href="{{ path('app_register') }}" class="btn fw-bold px-4 py-3" style="background:var(--nj-gradient);color:#fff;border-radius:.9rem;font-size:.95rem;border:none">Create my account — it's free</a>
                        <a href="{{ path('app_login') }}" class="btn fw-semibold px-4 py-3" style="background:rgba(255,255,255,.06);color:#fff;border:1px solid rgba(255,255,255,.18);border-radius:.9rem;font-size:.95rem">Sign in</a>
                    </div>
                {% else %}
                    <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .9rem;border-radius:999px;background:rgba(6,214,160,.1);border:1px solid rgba(6,214,160,.25);color:#06d6a0;font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:1.4rem">
                        <span style="width:6px;height:6px;border-radius:50%;background:#06d6a0"></span>
                        All systems active
                    </div>
                    <h2 class="text-white fw-bold mb-3" style="font-size:clamp(1.7rem,4vw,2.6rem);line-height:1.15;letter-spacing:-.03em;max-width:28rem">Everything is live. Pick up where you left off.</h2>
                    <p style="color:rgba(226,232,240,.65);max-width:32rem;line-height:1.75;margin-bottom:2rem">Your projects, investment opportunities, mentors and co-founders are all here and ready. One click to resume.</p>
                    <div style="display:flex;gap:.8rem;flex-wrap:wrap">
                        <a href="{{ closingRoute }}" class="btn fw-bold px-4 py-3" style="background:var(--nj-gradient);color:#fff;border-radius:.9rem;font-size:.95rem;border:none">{% if is_granted('ROLE_ADMIN') %}Open dashboard{% else %}Go to my projects{% endif %}</a>
                        <a href="{{ path('app_invest_opportunities') }}" class="btn fw-semibold px-4 py-3" style="background:rgba(255,255,255,.06);color:#fff;border:1px solid rgba(255,255,255,.18);border-radius:.9rem;font-size:.95rem">Browse opportunities</a>
                    </div>
                {% endif %}
            </div>
            <div style="display:flex;flex-direction:column;gap:1rem;min-width:180px" class="d-none d-md-flex">
                <div style="padding:1rem 1.2rem;border-radius:1rem;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);text-align:center">
                    <div class="fw-bold text-white" style="font-size:1.8rem;line-height:1">{{ platformStats.totalUsers }}</div>
                    <div style="font-size:.72rem;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.1em;margin-top:.3rem">Members</div>
                </div>
