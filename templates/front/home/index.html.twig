<section class="nj-signal-section" id="signalChapter">
    <div class="container">
        <div class="nj-signal-shell">
            <div class="nj-chapter-label is-dark" id="signalLabel">
                <span class="nj-chapter-index">Chapitre 2</span>
                <span class="nj-chapter-text">Activite en temps reel</span>
                <span class="nj-chapter-cursor"></span>
            </div>
            <p class="nj-signal-intro">Le flux ne se contente pas de faire joli. Il montre que la plateforme respire, bouge et relie des actions humaines a des signaux concrets.</p>

            {% if activityFeed|length > 0 %}
                <div class="nj-ticker" id="njTicker">
                    <div class="nj-ticker-track" id="tickerTrack">
                        {% for event in activityFeed %}
                            <span class="nj-ticker-item">
                                <span class="nj-ticker-dot {{ event.type }}"></span>
                                {{ event.text }} &middot; <span style="opacity:.5">{{ event.ago }}</span>
                            </span>
                        {% endfor %}
                        {% for event in activityFeed %}
                            <span class="nj-ticker-item">
                                <span class="nj-ticker-dot {{ event.type }}"></span>
                                {{ event.text }} &middot; <span style="opacity:.5">{{ event.ago }}</span>
                            </span>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="nj-signal-empty">Le flux reprendra des qu'une nouvelle activite sera enregistree sur la plateforme.</div>
            {% endif %}
        </div>
    </div>
</section>

<section class="nj-journey" id="journeyWrapper">
    <div class="nj-journey-sticky">
        <div class="nj-journey-head">
            <div class="nj-chapter-label is-dark" id="journeyLabel">
                <span class="nj-chapter-index">Chapitre 3</span>
                <span class="nj-chapter-text">Parcours fondateur</span>
                <span class="nj-chapter-cursor"></span>
            </div>
            <p class="nj-journey-note">Six ecrans, un seul mouvement: l'idee devient projet, le projet devient relation, la relation devient traction.</p>
        </div>

        <div class="nj-journey-track" id="journeyTrack">
            {% for m in modules %}
                <article class="nj-journey-slide" data-journey-slide style="--slide-glow: {{ m.glow }}; --slide-gradient: {{ m.gradient }}; --slide-accent: {{ m.accent }}; --slide-surface: {{ m.surface }};">
                    <div class="nj-journey-slide-inner">
                        <div class="nj-journey-panel">
                            <div class="nj-journey-topline">
                                <span class="nj-journey-index">{{ '%02d'|format(loop.index) }}</span>
                                <span class="nj-journey-step">{{ m.eyebrow }}</span>
                            </div>
                            <div class="nj-journey-icon"><i class="bi {{ m.icon }}"></i></div>
                            <h3>{{ m.title }}</h3>
                            <p>{{ m.desc }}</p>
                            <div class="nj-journey-metrics">
                                <span>{{ m.stat }}</span>
                                <span>{{ m.secondary }}</span>
                            </div>
                            <a href="{{ m.route }}" class="nj-journey-cta">{{ m.cta }} <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="nj-journey-dots" aria-hidden="true">
            {% for m in modules %}
                <span class="nj-journey-dot" data-journey-dot style="--dot-color: {{ m.accent }}"></span>
            {% endfor %}
        </div>
    </div>
</section>

