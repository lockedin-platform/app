{% extends 'front/layout.html.twig' %}

{% block title %}Courses - LockedIn{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.cours-card{border-radius:1.25rem;border:1px solid rgba(255,255,255,.08);
    background:rgba(255,255,255,.04);backdrop-filter:blur(14px);overflow:hidden;
    box-shadow:0 8px 32px rgba(0,0,0,.25);transition:transform .3s,box-shadow .3s,border-color .3s;color:rgba(226,232,240,.9);position:relative}
.cours-card:hover{transform:translateY(-6px);box-shadow:0 20px 56px rgba(217,119,6,.25),0 0 0 1px rgba(217,119,6,.2);border-color:rgba(217,119,6,.35)}
.cours-card-inner{position:relative;z-index:1}
.cours-thumb{height:160px;object-fit:cover;width:100%}
.cours-thumb-placeholder{height:160px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,rgba(217,119,6,.6) 0%,rgba(220,38,38,.45) 50%,rgba(124,58,237,.3) 100%)}
.cours-thumb-placeholder i{font-size:3.2rem;color:rgba(255,255,255,.9)}
.level-badge{font-size:.72rem;font-weight:700;padding:.28rem .65rem;border-radius:10rem}
.level-DEBUTANT{background:rgba(5,150,105,.15);color:#6ee7b7;border:1px solid rgba(5,150,105,.25)}
.level-INTERMEDIAIRE{background:rgba(217,119,6,.15);color:#fde68a;border:1px solid rgba(217,119,6,.25)}
.level-AVANCE{background:rgba(220,38,38,.15);color:#fca5a5;border:1px solid rgba(220,38,38,.25)}
.xp-chip{display:inline-flex;align-items:center;gap:.3rem;font-size:.75rem;font-weight:700;
    padding:.3rem .65rem;border-radius:10rem;background:rgba(255,209,102,.12);color:#fde68a;border:1px solid rgba(255,209,102,.2)}
.cert-chip{display:inline-flex;align-items:center;gap:.3rem;font-size:.72rem;font-weight:700;
    padding:.3rem .65rem;border-radius:10rem;background:rgba(5,150,105,.15);color:#6ee7b7;border:1px solid rgba(5,150,105,.25)}
.cat-chip{display:inline-flex;align-items:center;gap:.3rem;font-size:.74rem;font-weight:600;
    padding:.3rem .65rem;border-radius:8px;background:rgba(67,97,238,.15);color:#93c5fd}
</style>
{% endblock %}

{% block main %}

{# ── Page Hero ── #}
<div class="nj-page-hero nj-hero-apprentissage mb-4">
    <i class="bi bi-book nj-ph-icon"></i>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3" style="position:relative;z-index:1">
        <div>
            <div class="nj-ph-eyebrow">Learning</div>
            <h1 class="nj-ph-title mb-1">Course Catalog</h1>
            <p class="nj-ph-sub">Develop your entrepreneurial skills with certified courses</p>
        </div>
        <div class="nj-hero-actions">
            <div class="nj-action-group">
                <a href="{{ path('app_apprentissage_progression') }}" class="nj-action-link"><i class="bi bi-bar-chart"></i>My Progress</a>
            </div>
            <a href="{{ path('app_apprentissage_badges') }}" class="nj-action-cta cta-apprentissage"><i class="bi bi-award"></i>My Badges</a>
        </div>
    </div>
</div>

{# ── Search bar ── #}
<div class="nj-filter-bar nj-filter-apprentissage mb-4">
    <form method="get" id="coursSearchForm" class="d-flex gap-3 align-items-center">
        <div class="input-group flex-grow-1">
            <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="q" class="form-control" placeholder="Search a course, a skill..." value="{{ search }}">
        </div>
        <button class="btn btn-nj px-4 flex-shrink-0"><i class="bi bi-search me-1"></i>Search</button>
    </form>
</div>

{% if cours|length > 0 %}
<div id="liveResults">
<div class="nj-section-label" style="--nj-section-color:linear-gradient(135deg,#d97706,#dc2626)"><i class="bi bi-collection-play me-1"></i>{{ cours|length }} course{{ cours|length > 1 ? 's' : '' }} available</div>
<div class="row g-4">
    {% for c in cours %}
    <div class="col-md-6 col-lg-4">
        <div class="cours-card h-100 d-flex flex-column">
            {# Thumbnail #}
            {% if c.imageUrl %}
                <img src="{{ c.imageUrl }}" class="cours-thumb" alt="{{ c.titre }}">
            {% else %}
                <div class="cours-thumb-placeholder">
                    <i class="bi bi-book"></i>
                </div>
            {% endif %}

            <div class="p-4 flex-grow-1 d-flex flex-column">
                {# Badges row #}
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <span class="cat-chip">{{ c.categorie }}</span>
                    {% if c.niveauDifficulte %}
                    <span class="level-badge level-{{ c.niveauDifficulte|upper }}">{{ c.niveauDifficulte }}</span>
                    {% endif %}
                    {% if c.certification %}
                    <span class="cert-chip"><i class="bi bi-patch-check-fill"></i>Certified</span>
                    {% endif %}
                </div>

                {# Title #}
                <h5 class="fw-bold mb-2" style="font-size:.97rem;line-height:1.4">{{ c.titre }}</h5>

                {# Description #}
                <p class="text-muted mb-3" style="font-size:.84rem;line-height:1.6">
                    {{ c.description|length > 100 ? c.description|slice(0,100) ~ '...' : c.description }}
                </p>

                {# Meta row #}
                <div class="d-flex align-items-center gap-3 mb-3 mt-auto">
                    {% if c.dureeEstimee %}
                    <span class="text-muted small"><i class="bi bi-clock me-1"></i>{{ c.dureeEstimee }} min</span>
                    {% endif %}
                    {% if c.pointsXp %}
                    <span class="xp-chip"><i class="bi bi-star-fill"></i>{{ c.pointsXp }} XP</span>
                    {% endif %}
                </div>

                <a href="{{ path('app_apprentissage_cours_show', {id: c.id}) }}" class="btn btn-nj w-100">
                    <i class="bi bi-play-circle me-1"></i>Start course
                </a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
</div>

{% else %}
<div class="empty-state">
    <div class="mb-4">
        <div style="width:100px;height:100px;border-radius:50%;background:linear-gradient(135deg,rgba(217,119,6,.12),rgba(220,38,38,.1));
            display:flex;align-items:center;justify-content:center;margin:0 auto">
            <i class="bi bi-book" style="font-size:3rem;color:#d97706"></i>
        </div>
    </div>
    <h4>No courses available</h4>
    <p>Entrepreneurial courses will be available soon. Check back later!</p>
</div>
{% endif %}

{% endblock %}

{% block javascripts %}
<script>
(function(){
    const form = document.getElementById('coursSearchForm');
    if (!form) return;
    let timer;
    function liveSearch() {
        clearTimeout(timer);
        timer = setTimeout(function() {
            const params = new URLSearchParams(new FormData(form)).toString();
            fetch(window.location.pathname + '?' + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    const doc = new DOMParser().parseFromString(html, 'text/html');
                    const nr = doc.getElementById('liveResults');
                    const cur = document.getElementById('liveResults');
                    if (nr && cur) cur.innerHTML = nr.innerHTML;
                });
        }, 300);
    }
    form.querySelectorAll('input[name="q"]').forEach(el => el.addEventListener('input', liveSearch));
    form.addEventListener('submit', e => { e.preventDefault(); liveSearch(); });
})();
</script>
{% endblock %}
