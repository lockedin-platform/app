{% extends 'front/layout.html.twig' %}

{% block title %}My Progress - LockedIn{% endblock %}

{% block main %}
<div class="nj-page-hero nj-hero-apprentissage mb-4">
    <i class="bi bi-bar-chart nj-ph-icon"></i>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3" style="position:relative;z-index:1">
        <div>
            <div class="nj-ph-eyebrow">Learning</div>
            <h1 class="nj-ph-title mb-1">My Progress</h1>
            <p class="nj-ph-sub">Track your learning journey and certifications</p>
        </div>
        <div class="nj-hero-actions">
            {% if coursTermines > 0 %}
            <div class="nj-action-group">
                <a href="{{ path('app_apprentissage_progression_pdf') }}" class="nj-action-link"><i class="bi bi-file-earmark-pdf"></i>Export PDF</a>
            </div>
            {% endif %}
            <a href="{{ path('app_apprentissage_cours') }}" class="nj-action-cta cta-apprentissage"><i class="bi bi-book"></i>Browse Courses</a>
        </div>
    </div>
</div>

{# ===== STATISTIQUES ===== #}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="nj-raised p-3 text-center" style="border-top:2px solid rgba(217,119,6,.5)">
            <div class="nj-num nj-num-amber" style="font-size:2rem">{{ totalCours }}</div>
            <div style="color:rgba(255,255,255,.4);font-size:.72rem;margin-top:.3rem;letter-spacing:.04em">COURSES TAKEN</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="nj-raised p-3 text-center" style="border-top:2px solid rgba(5,150,105,.5)">
            <div class="nj-num nj-num-good" style="font-size:2rem">{{ coursTermines }}</div>
            <div style="color:rgba(255,255,255,.4);font-size:.72rem;margin-top:.3rem;letter-spacing:.04em">COMPLETED</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="nj-raised p-3 text-center" style="border-top:2px solid rgba(67,97,238,.5)">
            <div class="nj-num nj-num-blue" style="font-size:2rem">{{ coursEnCours }}</div>
            <div style="color:rgba(255,255,255,.4);font-size:.72rem;margin-top:.3rem;letter-spacing:.04em">IN PROGRESS</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="nj-raised p-3 text-center" style="border-top:2px solid rgba(103,232,249,.5)">
            <div class="nj-num nj-num-cyan" style="font-size:2rem">{{ totalXp }}</div>
            <div style="color:rgba(255,255,255,.4);font-size:.72rem;margin-top:.3rem;letter-spacing:.04em">TOTAL XP</div>
        </div>
    </div>
</div>

{% if totalCours > 0 %}
<div class="card border-0 shadow-sm p-3 mb-4" style="border-radius:1rem">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="small fw-semibold">Overall progress</span>
        <span class="small text-muted">{{ moyennePct }}% average</span>
    </div>
    <div class="progress" style="height:12px;border-radius:1rem">
        <div class="progress-bar" style="width:{{ moyennePct }}%;background:var(--nj-gradient);border-radius:1rem"></div>
    </div>
</div>
{% endif %}
{# ===== FIN STATISTIQUES ===== #}

{% if progressions|length > 0 %}
<div class="row g-4">
    {% for p in progressions %}
    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius:1rem">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="fw-bold mb-0">{{ p.cours.titre }}</h5>
                    <span class="badge bg-{{ p.etat == 'COMPLETE' ? 'success' : (p.etat == 'CERTIFIE' ? 'warning text-dark' : (p.etat == 'EN_COURS' ? 'primary' : 'secondary')) }}">
                        {{ p.etat }}
                    </span>
                </div>
                <div class="progress mb-2" style="height:10px">
                    <div class="progress-bar" style="width:{{ p.pourcentage }}%;background:var(--nj-gradient)"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>{{ p.pourcentage }}% completed</span>
                    <span>{{ p.pointsXp }} XP</span>
                </div>
                <div class="mt-2 small text-muted">
                    <i class="bi bi-calendar me-1"></i>Started: {{ p.dateDebut|date('d/m/Y') }}
                    {% if p.dateObtention %} · Completed: {{ p.dateObtention|date('d/m/Y') }}{% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="text-center py-5">
    <div class="text-center"><i class="bi bi-graph-up" style="font-size:4rem;color:var(--nj-primary)"></i></div>
    <h4 class="fw-bold mt-3">No progress yet</h4>
    <p class="text-muted">Enroll in a course to get started</p>
    <a href="{{ path('app_apprentissage_cours') }}" class="btn btn-nj">Explore courses</a>
</div>
{% endif %}
{% endblock %}