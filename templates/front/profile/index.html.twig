{% extends 'front/layout.html.twig' %}

{% block title %}My Profile - Najahni{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.profile-hero{border-radius:1.5rem;overflow:hidden;position:relative;margin-bottom:1.5rem}
.profile-cover{height:140px;background:linear-gradient(135deg,#0891b2 0%,#4361ee 50%,#7209b7 100%);position:relative}
.profile-cover::after{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")}
.profile-avatar-area{padding:0 2rem 1.5rem;background:rgba(255,255,255,.03);position:relative}
.profile-avatar{width:90px;height:90px;border-radius:50%;border:4px solid rgba(255,255,255,.2);
    box-shadow:0 4px 20px rgba(0,0,0,.4);object-fit:cover;
    margin-top:-45px;display:block}
.profile-avatar-initials{width:90px;height:90px;border-radius:50%;border:4px solid rgba(255,255,255,.2);
    box-shadow:0 4px 20px rgba(0,0,0,.4);margin-top:-45px;
    background:linear-gradient(135deg,#4361ee,#7209b7);color:#fff;
    display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:800}
.security-item{display:flex;justify-content:space-between;align-items:center;
    padding:.65rem 0;border-bottom:1px solid rgba(255,255,255,.06)}
.security-item:last-child{border-bottom:none}
.xp-bar-wrap{background:rgba(255,255,255,.08);border-radius:10rem;height:8px;overflow:hidden}
.info-label{font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:.2rem}
.info-value{font-size:.9rem;color:rgba(226,232,240,.85);font-weight:500}
.ai-section{border:1.5px solid rgba(67,97,238,.2);border-radius:1.25rem;padding:1.5rem;
    background:linear-gradient(135deg,rgba(67,97,238,.08),rgba(114,9,183,.06))}
</style>
{% endblock %}

{% block main %}

<div class="d-flex justify-content-end gap-2 mb-3">
    <a href="{{ path('app_profile_notifications') }}" class="btn btn-outline-secondary position-relative">
        <i class="bi bi-bell"></i>
        {% if unreadNotifs > 0 %}
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.6rem">{{ unreadNotifs }}</span>
        {% endif %}
    </a>
    <a href="{{ path('app_profile_edit') }}" class="btn btn-nj"><i class="bi bi-pencil me-2"></i>Edit Profile</a>
</div>

<div class="row g-4">
    {# ── Left column ── #}
    <div class="col-md-4">
        {# Profile card with cover photo #}
        <div class="card p-0 overflow-hidden mb-3">
            <div class="profile-cover"></div>
            <div class="profile-avatar-area">
                {% if app.user.profilePicture %}
                    <img src="{{ app.user.profilePicture }}" class="profile-avatar" alt="">
                {% else %}
                    <div class="profile-avatar-initials">
                        {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                    </div>
                {% endif %}
                <div class="mt-2">
                    <h4 class="fw-bold mb-1">{{ app.user.firstname }} {{ app.user.lastname }}</h4>
                    <span class="badge badge-role-{{ app.user.role }} rounded-pill mb-2">{{ app.user.role|lower|capitalize }}</span>
                    <p class="text-muted mb-1" style="font-size:.85rem"><i class="bi bi-envelope me-1"></i>{{ app.user.email }}</p>
                    {% if app.user.phone %}<p class="text-muted mb-0" style="font-size:.85rem"><i class="bi bi-phone me-1"></i>{{ app.user.phone }}</p>{% endif %}
                </div>
            </div>
        </div>

        {# XP card #}
        {% if app.user.totalXp > 0 %}
        <div class="card p-4 mb-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="fw-bold mb-0"><i class="bi bi-star-fill text-warning me-2"></i>Experience</h6>
                <span class="badge" style="background:rgba(255,209,102,.15);color:#fde68a;font-size:.72rem">
                    Level {{ (app.user.totalXp / 100)|round }}
                </span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="nj-num nj-num-cyan" style="font-size:2rem">{{ app.user.totalXp }}</span>
                <span class="text-muted small">XP points</span>
            </div>
            <div class="xp-bar-wrap">
                <div class="progress-bar" style="width:{{ min(app.user.totalXp % 100, 100) }}%;height:8px;background:linear-gradient(90deg,#f59e0b,#d97706)"></div>
            </div>
            <p class="text-muted mb-0 mt-1" style="font-size:.75rem">{{ 100 - (app.user.totalXp % 100) }} XP until next level</p>
        </div>
        {% endif %}

        {# Security card #}
        <div class="card p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check me-2" style="color:var(--nj-success)"></i>Account Security</h6>
            <div class="security-item">
                <span class="small fw-medium">Email verified</span>
                {% if app.user.verified %}
                    <span class="badge" style="background:rgba(5,150,105,.15);color:#6ee7b7">
                        <i class="bi bi-check-circle-fill me-1"></i>Verified
                    </span>
                {% else %}
                    <form method="post" action="{{ path('app_profile_verify_email') }}" class="d-inline">
                        <input type="hidden" name="action" value="send">
                        <button type="submit" class="badge border-0" style="background:rgba(217,119,6,.15);color:#fde68a;cursor:pointer">
                            <i class="bi bi-exclamation-circle me-1"></i>Verify
                        </button>
                    </form>
                {% endif %}
            </div>
            <div class="security-item">
                <span class="small fw-medium">Google linked</span>
                {% if app.user.googleProviderId %}
                    <span class="badge" style="background:rgba(5,150,105,.1);color:#059669"><i class="bi bi-check-circle-fill me-1"></i>Linked</span>
                {% else %}
                    <a href="{{ path('app_google_connect') }}" class="badge text-decoration-none" style="background:rgba(255,255,255,.08);color:rgba(255,255,255,.65)">
                        <i class="bi bi-google me-1"></i>Link
                    </a>
                {% endif %}
            </div>
            <div class="security-item">
                <span class="small fw-medium">Face ID</span>
                {% if app.user.faceRegistered %}
                    <span class="badge" style="background:rgba(67,97,238,.2);color:#93c5fd"><i class="bi bi-person-bounding-box me-1"></i>Active</span>
                {% else %}
                    <span class="badge" style="background:rgba(255,255,255,.06);color:rgba(255,255,255,.4)">Inactive</span>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Right column ── #}
    <div class="col-md-8">
        {# Info card #}
        <div class="card p-4 mb-4">
            <h5 class="fw-bold mb-4"><i class="bi bi-person-lines-fill me-2" style="color:var(--nj-primary)"></i>Personal Information</h5>
            <div class="row g-4">
                {% if app.user.bio %}
                <div class="col-12">
                    <div class="info-label">Bio</div>
                    <p class="info-value mb-0">{{ app.user.bio }}</p>
                </div>
                {% endif %}
                {% if app.user.companyName %}
                <div class="col-md-6">
                    <div class="info-label">Company</div>
                    <div class="info-value"><i class="bi bi-building me-1 text-muted"></i>{{ app.user.companyName }}</div>
                </div>
                {% endif %}
                {% if app.user.linkedinUrl %}
                <div class="col-md-6">
                    <div class="info-label">LinkedIn</div>
                    <a href="{{ app.user.linkedinUrl }}" target="_blank" class="info-value text-decoration-none" style="color:var(--nj-primary)">
                        <i class="bi bi-linkedin me-1"></i>View profile
                    </a>
                </div>
                {% endif %}
                {% if app.user.address %}
                <div class="col-md-6">
                    <div class="info-label">Address</div>
                    <div class="info-value"><i class="bi bi-geo-alt me-1 text-muted"></i>{{ app.user.address }}</div>
                </div>
                {% endif %}
                {% if app.user.dateOfBirth %}
                <div class="col-md-6">
                    <div class="info-label">Date of birth</div>
                    <div class="info-value"><i class="bi bi-calendar me-1 text-muted"></i>{{ app.user.dateOfBirth|date('d/m/Y') }}</div>
                </div>
                {% endif %}
                <div class="col-md-6">
                    <div class="info-label">Member since</div>
                    <div class="info-value"><i class="bi bi-clock me-1 text-muted"></i>{{ app.user.createdAt|date('d/m/Y') }}</div>
                </div>
                <div class="col-md-6">
                    <div class="info-label">Status</div>
                    <div>
                        {% if app.user.verified %}
                            <span class="badge" style="background:rgba(5,150,105,.1);color:#059669"><i class="bi bi-check-circle-fill me-1"></i>Verified</span>
                        {% else %}
                            <span class="badge" style="background:rgba(217,119,6,.12);color:#d97706"><i class="bi bi-exclamation-circle me-1"></i>Not verified</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# AI Assistant #}
        <div class="ai-section mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-robot me-2" style="color:var(--nj-primary)"></i>Profile AI Assistant</h5>
                {% if not aiEnabled %}
                    <span class="badge bg-secondary">AI disabled</span>
                {% endif %}
            </div>
            <p class="text-muted small mb-3">Improve your bio, get personalized recommendations and connect with the right profiles.</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button id="generateBioBtn" class="btn btn-sm btn-outline-primary" {{ not aiEnabled ? 'disabled' : '' }}>
                    <i class="bi bi-pencil-square me-1"></i>Rewrite my bio
                </button>
                <button id="recommendationsBtn" class="btn btn-sm btn-outline-success" {{ not aiEnabled ? 'disabled' : '' }}>
                    <i class="bi bi-stars me-1"></i>Recommendations
                </button>
                <button id="matchingBtn" class="btn btn-sm btn-outline-info" {{ not aiEnabled ? 'disabled' : '' }}>
                    <i class="bi bi-people-fill me-1"></i>Suggested connections
                </button>
            </div>
            <div id="matchingResult" class="d-none mb-3">
                <h6 class="fw-semibold small mb-2"><i class="bi bi-people me-1"></i>Compatible profiles</h6>
                <div id="matchingList" class="d-flex flex-column gap-2"></div>
            </div>
            <div id="aiResult" class="rounded-3 p-3" style="min-height:80px;background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);font-size:.88rem;color:rgba(226,232,240,.85)">
                <p class="mb-0 text-muted">AI results will appear here.</p>
            </div>
            <div class="mt-3">
                <label class="form-label fw-semibold small mb-1">Ask the assistant</label>
                <div class="input-group">
                    <textarea id="aiChatMessage" class="form-control" rows="2" placeholder="What can I improve on my profile?" {{ not aiEnabled ? 'disabled' : '' }}></textarea>
                    <button id="aiChatSend" class="btn btn-nj" type="button" {{ not aiEnabled ? 'disabled' : '' }}><i class="bi bi-send-fill"></i></button>
                </div>
                <div id="aiChatResponse" class="mt-2 text-muted" style="font-size:.85rem"></div>
            </div>
        </div>

        {# Login history #}
        <div class="card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2" style="color:var(--nj-accent)"></i>Recent Sign-ins</h5>
                <a href="{{ path('app_profile_login_history') }}" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            {% if loginHistory|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0" style="font-size:.86rem">
                        <thead>
                            <tr style="background:rgba(255,255,255,.04)">
                                <th class="border-0 py-2 text-muted fw-semibold" style="font-size:.75rem;letter-spacing:.04em">DATE</th>
                                <th class="border-0 py-2 text-muted fw-semibold" style="font-size:.75rem;letter-spacing:.04em">METHOD</th>
                                <th class="border-0 py-2 text-muted fw-semibold" style="font-size:.75rem;letter-spacing:.04em">IP</th>
                                <th class="border-0 py-2 text-muted fw-semibold" style="font-size:.75rem;letter-spacing:.04em">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in loginHistory|slice(0, 5) %}
                            <tr>
                                <td class="text-muted py-2">{{ entry.loginTime|date('d/m/Y H:i') }}</td>
                                <td class="py-2">
                                    {% if entry.loginMethod == 'GOOGLE' %}
                                        <span class="badge" style="background:rgba(66,133,244,.12);color:#4285F4"><i class="bi bi-google me-1"></i>Google</span>
                                    {% elseif entry.loginMethod == 'FACE_ID' %}
                                        <span class="badge" style="background:rgba(114,9,183,.12);color:#7209b7"><i class="bi bi-person-bounding-box me-1"></i>Face ID</span>
                                    {% else %}
                                        <span class="badge" style="background:rgba(255,255,255,.08);color:rgba(255,255,255,.65)"><i class="bi bi-key me-1"></i>Email</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted py-2 small">{{ entry.ipAddress }}</td>
                                <td class="py-2">
                                    {% if entry.success %}
                                        <span style="color:#059669"><i class="bi bi-check-circle-fill"></i></span>
                                    {% else %}
                                        <span style="color:#dc2626"><i class="bi bi-x-circle-fill"></i></span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-3">
                    <i class="bi bi-clock-history text-muted" style="font-size:2rem;opacity:.4"></i>
                    <p class="text-muted small mb-0 mt-2">No login history.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    const resultBox = document.getElementById('aiResult');
    const responseBox = document.getElementById('aiChatResponse');
    const messageInput = document.getElementById('aiChatMessage');

    function setLoading(btn, txt) {
        btn.disabled = true;
        btn.dataset.orig = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + txt;
    }
    function resetBtn(btn) { if (btn.dataset.orig) { btn.innerHTML = btn.dataset.orig; btn.disabled = false; } }

    async function callAi(endpoint, payload) {
        const r = await fetch(endpoint, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest','Content-Type':'application/json'}, body: JSON.stringify(payload) });
        return r.json();
    }

    const generateBioBtn = document.getElementById('generateBioBtn');
    const recommendationsBtn = document.getElementById('recommendationsBtn');
    const chatSendBtn = document.getElementById('aiChatSend');
    const matchingBtn = document.getElementById('matchingBtn');
    const matchingResult = document.getElementById('matchingResult');
    const matchingList = document.getElementById('matchingList');

    if (generateBioBtn) generateBioBtn.addEventListener('click', async function() {
        setLoading(generateBioBtn, 'Generating...');
        const data = await callAi('{{ path('app_profile_ai_generate_bio') }}', {});
        resultBox.innerHTML = data.bio ? '<strong class="d-block mb-1">Suggested bio:</strong><p class="mb-0">' + data.bio.replace(/\n/g,'<br>') + '</p>' : '<span class="text-danger">' + (data.error||'Error') + '</span>';
        resetBtn(generateBioBtn);
    });

    if (recommendationsBtn) recommendationsBtn.addEventListener('click', async function() {
        setLoading(recommendationsBtn, 'Loading...');
        const data = await callAi('{{ path('app_profile_ai_recommendations') }}', {});
        resultBox.innerHTML = data.recommendations ? '<strong class="d-block mb-1">Recommendations:</strong><p class="mb-0">' + data.recommendations.replace(/\n/g,'<br>') + '</p>' : '<span class="text-danger">' + (data.error||'Error') + '</span>';
        resetBtn(recommendationsBtn);
    });

    if (chatSendBtn) chatSendBtn.addEventListener('click', async function() {
        const msg = messageInput.value.trim();
        if (!msg) return;
        setLoading(chatSendBtn, '');
        const data = await callAi('{{ path('app_profile_ai_chat') }}', {message:msg});
        responseBox.innerHTML = data.answer ? '<strong>AI: </strong>' + data.answer.replace(/\n/g,'<br>') : '<span class="text-danger">' + (data.error||'Error') + '</span>';
        resetBtn(chatSendBtn);
    });

    if (matchingBtn) matchingBtn.addEventListener('click', async function() {
        setLoading(matchingBtn, 'Analyzing...');
        const data = await callAi('{{ path('app_profile_ai_matching') }}', {});
        if (data.matches && data.matches.length > 0) {
            matchingResult.classList.remove('d-none');
            matchingList.innerHTML = data.matches.map(m => `
                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1)">
                    <div class="nj-avatar nj-avatar-sm flex-shrink-0" style="background:var(--nj-gradient)">
                        ${m.picture ? '<img src="/uploads/profiles/'+m.picture+'" style="width:36px;height:36px;border-radius:50%;object-fit:cover">' : m.name.charAt(0).toUpperCase()}
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold" style="font-size:.88rem;color:#e2e8f0">${m.name} <span class="badge ms-1" style="background:rgba(255,255,255,.08);color:rgba(255,255,255,.65);font-size:.68rem">${m.role}</span></div>
                        ${m.company ? '<small class="text-muted">'+m.company+'</small>' : ''}
                        <div class="text-success" style="font-size:.77rem"><i class="bi bi-lightning-fill"></i> ${m.reason}</div>
                    </div>
                    <span class="badge rounded-pill" style="background:rgba(67,97,238,.2);color:#93c5fd">${m.score}%</span>
                </div>`).join('');
        } else {
            matchingResult.classList.remove('d-none');
            matchingList.innerHTML = '<p class="text-muted text-center small p-3 mb-0">No suggestions available.</p>';
        }
        resetBtn(matchingBtn);
    });
})();
</script>
{% endblock %}
