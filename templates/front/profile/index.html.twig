{% extends 'front/layout.html.twig' %}

{% block title %}Mon Profil - Najahni{% endblock %}

{% block main %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-person-circle me-2"></i>Mon Profil</h2>
    <div class="d-flex gap-2">
        <a href="{{ path('app_profile_notifications') }}" class="btn btn-outline-secondary position-relative">
            <i class="bi bi-bell"></i>
            {% if unreadNotifs > 0 %}
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.65rem">{{ unreadNotifs }}</span>
            {% endif %}
        </a>
        <a href="{{ path('app_profile_edit') }}" class="btn btn-nj"><i class="bi bi-pencil me-2"></i>Modifier</a>
    </div>
</div>

<div class="row g-4">
    {# Left Column: Avatar & Quick Info #}
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4" style="border-radius:1rem">
            {% if app.user.profilePicture %}
                <img src="{{ app.user.profilePicture }}" class="rounded-circle mx-auto mb-3" width="120" height="120" style="object-fit:cover" alt="Avatar">
            {% else %}
                <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:120px;height:120px;background:var(--nj-gradient);color:#fff;font-size:3rem">
                    {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                </div>
            {% endif %}
            <h4 class="fw-bold mb-1">{{ app.user.firstname }} {{ app.user.lastname }}</h4>
            <span class="badge rounded-pill mb-2" style="background:var(--nj-gradient)">{{ app.user.role }}</span>
            <p class="text-muted small">{{ app.user.email }}</p>
            {% if app.user.phone %}<p class="text-muted small mb-0"><i class="bi bi-phone me-1"></i>{{ app.user.phone }}</p>{% endif %}
        </div>

        {% if app.user.totalXp > 0 %}
        <div class="card border-0 shadow-sm mt-3 p-4" style="border-radius:1rem">
            <h6 class="fw-bold mb-3"><i class="bi bi-star-fill text-warning me-2"></i>Expérience</h6>
            <div class="d-flex align-items-center">
                <div class="display-6 fw-bold me-3" style="color:var(--nj-primary)">{{ app.user.totalXp }}</div>
                <span class="text-muted">Points XP</span>
            </div>
        </div>
        {% endif %}

        {# Account Security Card #}
        <div class="card border-0 shadow-sm mt-3 p-4" style="border-radius:1rem">
            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check me-2"></i>Sécurité du compte</h6>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small">Email vérifié</span>
                    {% if app.user.verified %}
                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Oui</span>
                    {% else %}
                        <form method="post" action="{{ path('app_profile_verify_email') }}" class="d-inline">
                            <input type="hidden" name="action" value="send">
                            <button type="submit" class="badge bg-warning border-0 text-dark" style="cursor:pointer"><i class="bi bi-exclamation-circle"></i> Vérifier</button>
                        </form>
                    {% endif %}
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small">Google lié</span>
                    {% if app.user.googleProviderId %}
                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Oui</span>
                    {% else %}
                        <a href="{{ path('app_google_connect') }}" class="badge bg-secondary text-decoration-none"><i class="bi bi-google"></i> Lier</a>
                    {% endif %}
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small">Face ID</span>
                    {% if app.user.faceRegistered %}
                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Actif</span>
                    {% else %}
                        <span class="badge bg-secondary">Inactif</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Right Column: Details & History #}
    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius:1rem">
            <h5 class="fw-bold mb-4"><i class="bi bi-info-circle me-2"></i>Informations</h5>

            <div class="row g-3">
                {% if app.user.bio %}
                <div class="col-12">
                    <label class="form-label text-muted small fw-semibold">Bio</label>
                    <p>{{ app.user.bio }}</p>
                </div>
                {% endif %}

                {% if app.user.companyName %}
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold">Entreprise</label>
                    <p><i class="bi bi-building me-1"></i>{{ app.user.companyName }}</p>
                </div>
                {% endif %}

                {% if app.user.linkedinUrl %}
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold">LinkedIn</label>
                    <p><a href="{{ app.user.linkedinUrl }}" target="_blank" class="text-decoration-none"><i class="bi bi-linkedin me-1"></i>Voir le profil</a></p>
                </div>
                {% endif %}

                {% if app.user.address %}
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold">Adresse</label>
                    <p><i class="bi bi-geo-alt me-1"></i>{{ app.user.address }}</p>
                </div>
                {% endif %}

                {% if app.user.dateOfBirth %}
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold">Date de naissance</label>
                    <p><i class="bi bi-calendar me-1"></i>{{ app.user.dateOfBirth|date('d/m/Y') }}</p>
                </div>
                {% endif %}

                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold">Membre depuis</label>
                    <p><i class="bi bi-clock me-1"></i>{{ app.user.createdAt|date('d/m/Y') }}</p>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted small fw-semibold">Statut</label>
                    <p>
                        {% if app.user.verified %}
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Vérifié</span>
                        {% else %}
                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle me-1"></i>Non vérifié</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius:1rem">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-robot me-2"></i>Assistant IA de profil</h5>
                {% if not aiEnabled %}
                    <span class="badge bg-secondary">IA désactivée</span>
                {% endif %}
            </div>
            <p class="text-muted small">Améliorez votre bio, obtenez des recommandations personnalisées et posez une question à l'assistant IA.</p>
            <div class="d-flex flex-column flex-md-row gap-2 mb-3">
                <button id="generateBioBtn" class="btn btn-outline-primary w-100" {{ not aiEnabled ? 'disabled' : '' }}>
                    <i class="bi bi-pencil-square me-1"></i>Réécrire ma bio
                </button>
                <button id="recommendationsBtn" class="btn btn-outline-success w-100" {{ not aiEnabled ? 'disabled' : '' }}>
                    <i class="bi bi-stars me-1"></i>Recommandations IA
                </button>
                <button id="matchingBtn" class="btn btn-outline-info w-100" {{ not aiEnabled ? 'disabled' : '' }}>
                    <i class="bi bi-people-fill me-1"></i>Connexions suggérées
                </button>
            </div>
            <div id="matchingResult" class="d-none mb-3">
                <h6 class="fw-semibold"><i class="bi bi-people me-1"></i>Utilisateurs compatibles</h6>
                <div id="matchingList" class="list-group"></div>
            </div>
            <div id="aiResult" class="border rounded-3 p-3 bg-light" style="min-height:120px;">
                <p class="mb-0 text-muted">Résultats IA affichés ici.</p>
            </div>
            <div class="mt-4">
                <label class="form-label fw-semibold">Posez une question à l’assistant</label>
                <div class="input-group">
                    <textarea id="aiChatMessage" class="form-control" rows="2" placeholder="Que puis-je améliorer sur mon profil ?" {{ not aiEnabled ? 'disabled' : '' }}></textarea>
                    <button id="aiChatSend" class="btn btn-nj" type="button" {{ not aiEnabled ? 'disabled' : '' }}><i class="bi bi-send-fill me-1"></i>Envoyer</button>
                </div>
                <div id="aiChatResponse" class="mt-3 text-muted small">Réponse de l'IA ici.</div>
            </div>
        </div>

        {# Recent Login History #}
        <div class="card border-0 shadow-sm p-4" style="border-radius:1rem">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>Connexions récentes</h5>
                <a href="{{ path('app_profile_login_history') }}" class="btn btn-sm btn-outline-nj">Voir tout</a>
            </div>
            {% if loginHistory|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Méthode</th>
                                <th>IP</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in loginHistory|slice(0, 5) %}
                            <tr>
                                <td class="small">{{ entry.loginTime|date('d/m/Y H:i') }}</td>
                                <td>
                                    {% if entry.loginMethod == 'GOOGLE' %}
                                        <span class="badge bg-info"><i class="bi bi-google me-1"></i>Google</span>
                                    {% elseif entry.loginMethod == 'FACE_ID' %}
                                        <span class="badge" style="background:var(--nj-accent)"><i class="bi bi-person-bounding-box me-1"></i>Face ID</span>
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="bi bi-key me-1"></i>Email</span>
                                    {% endif %}
                                </td>
                                <td class="small text-muted">{{ entry.ipAddress }}</td>
                                <td>
                                    {% if entry.success %}
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    {% else %}
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted text-center small mb-0">Aucun historique de connexion.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    const baseUrl = window.location.origin;
    const resultBox = document.getElementById('aiResult');
    const responseBox = document.getElementById('aiChatResponse');
    const messageInput = document.getElementById('aiChatMessage');

    function setLoading(button, text) {
        button.disabled = true;
        button.dataset.original = button.innerHTML;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + text;
    }

    function resetButton(button) {
        if (button.dataset.original) {
            button.innerHTML = button.dataset.original;
            button.disabled = false;
        }
    }

    async function callAi(endpoint, payload) {
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
        });
        return response.json();
    }

    const generateBioBtn = document.getElementById('generateBioBtn');
    const recommendationsBtn = document.getElementById('recommendationsBtn');
    const chatSendBtn = document.getElementById('aiChatSend');

    if (generateBioBtn) {
        generateBioBtn.addEventListener('click', async function() {
            setLoading(generateBioBtn, 'Génération...');
            const data = await callAi('{{ path('app_profile_ai_generate_bio') }}', {});
            if (data.bio) {
                resultBox.innerHTML = '<strong>Bio IA :</strong><p class="mb-0">' + data.bio.replace(/\n/g, '<br>') + '</p>';
            } else {
                resultBox.innerHTML = '<span class="text-danger">' + (data.error || 'Erreur lors de la génération.') + '</span>';
            }
            resetButton(generateBioBtn);
        });
    }


    if (recommendationsBtn) {
        recommendationsBtn.addEventListener('click', async function() {
            setLoading(recommendationsBtn, 'Chargement...');
            const data = await callAi('{{ path('app_profile_ai_recommendations') }}', {});
            if (data.recommendations) {
                resultBox.innerHTML = '<strong>Recommandations :</strong><p class="mb-0">' + data.recommendations.replace(/\n/g, '<br>') + '</p>';
            } else {
                resultBox.innerHTML = '<span class="text-danger">' + (data.error || 'Erreur lors de la génération.') + '</span>';
            }
            resetButton(recommendationsBtn);
        });
    }

    if (chatSendBtn) {
        chatSendBtn.addEventListener('click', async function() {
            const message = messageInput.value.trim();
            if (!message) {
                responseBox.textContent = 'Entrez votre question pour l\'assistant.';
                return;
            }
            setLoading(chatSendBtn, 'Envoi...');
            const data = await callAi('{{ path('app_profile_ai_chat') }}', {message});
            if (data.answer) {
                responseBox.innerHTML = '<strong>IA :</strong> ' + data.answer.replace(/\n/g, '<br>');
            } else {
                responseBox.innerHTML = '<span class="text-danger">' + (data.error || 'Erreur lors de l\'envoi.') + '</span>';
            }
            resetButton(chatSendBtn);
        });
    }

    const matchingBtn = document.getElementById('matchingBtn');
    const matchingResult = document.getElementById('matchingResult');
    const matchingList = document.getElementById('matchingList');

    if (matchingBtn) {
        matchingBtn.addEventListener('click', async function() {
            setLoading(matchingBtn, 'Analyse IA...');
            const data = await callAi('{{ path('app_profile_ai_matching') }}', {});
            if (data.matches && data.matches.length > 0) {
                matchingResult.classList.remove('d-none');
                matchingList.innerHTML = data.matches.map(m => `
                    <div class="list-group-item d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;font-size:0.9rem;">
                            ${m.picture ? '<img src="/uploads/profiles/' + m.picture + '" class="rounded-circle" style="width:40px;height:40px;object-fit:cover">' : m.name.charAt(0).toUpperCase()}
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">${m.name} <span class="badge bg-secondary ms-1">${m.role}</span></div>
                            ${m.company ? '<small class="text-muted">' + m.company + '</small><br>' : ''}
                            <small class="text-success"><i class="bi bi-lightning-fill"></i> ${m.reason}</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info">${m.score}%</span>
                        </div>
                    </div>
                `).join('');
            } else {
                matchingResult.classList.remove('d-none');
                matchingList.innerHTML = '<p class="text-muted text-center small mb-0">Aucune suggestion disponible pour le moment.</p>';
            }
            resetButton(matchingBtn);
        });
    }
})();
</script>
{% endblock %}
