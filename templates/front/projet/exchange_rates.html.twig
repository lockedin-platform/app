{% extends 'front/layout.html.twig' %}

{% block title %}Exchange Rates - {{ projet.titre }} - LockedIn{% endblock %}

{% block main %}
<div class="nj-page-hero nj-hero-projets mb-4">
    <i class="bi bi-currency-exchange nj-ph-icon"></i>
    <div style="position:relative;z-index:1">
        <a href="{{ path('app_projet_show', {id: projet.id}) }}" class="d-inline-flex align-items-center gap-1 mb-2 text-decoration-none"
           style="color:rgba(255,255,255,.7);font-size:.82rem">
            <i class="bi bi-arrow-left"></i> Back to Project
        </a>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="nj-ph-eyebrow">Projects · Tools</div>
                <h1 class="nj-ph-title mb-1">Exchange Rates</h1>
                <p class="nj-ph-sub">{{ projet.titre }} &mdash; Financial data converted to major currencies</p>
            </div>
            <div class="nj-hero-actions">
                <span class="badge px-3 py-2" style="background:rgba(255,255,255,.08);color:rgba(255,255,255,.7);font-size:.78rem;border:1px solid rgba(255,255,255,.1)">
                    <i class="bi bi-clock me-1"></i>Rates of {{ rates.date }}
                </span>
            </div>
        </div>
    </div>
</div>

{# Model 4 — macro risk for the project's country (real World Bank data) #}
{% if macroRisk is defined and macroRisk.available %}
{% set lvlColor = macroRisk.score <= 33 ? '#27ae60' : (macroRisk.score <= 66 ? '#f39c12' : '#e74c3c') %}
<div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:1rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07) !important">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-globe2 me-2"></i>Macro risk — {{ projet.pays }}</h5>
        <span class="badge" style="background:{{ lvlColor }};font-size:.95rem">{{ macroRisk.score }}/100 · {{ macroRisk.level }}</span>
    </div>
    <div class="row g-2">
        {% for factor, val in macroRisk.factors %}
        <div class="col-6 col-md-4 col-lg-2">
            <div class="p-2 rounded text-center" style="background:rgba(255,255,255,.04)">
                <div class="small text-muted text-capitalize">{{ factor|replace({'_': ' '}) }}</div>
                <div class="fw-bold" style="color:{{ val <= 33 ? '#27ae60' : (val <= 66 ? '#f39c12' : '#e74c3c') }}">{{ val }}</div>
            </div>
        </div>
        {% endfor %}
    </div>
    <p class="text-muted small mb-0 mt-2"><i class="bi bi-info-circle me-1"></i>Based on latest World Bank indicators (inflation, GDP growth, political stability, FDI, unemployment). Higher = riskier.</p>
</div>
{% endif %}

{# Model 8 — sector timing (Tunisian Stock Exchange); shows only once the data is loaded #}
{% if sectorTiming is defined and sectorTiming.available %}
{% set tColor = sectorTiming.score >= 66 ? '#27ae60' : (sectorTiming.score >= 40 ? '#f39c12' : '#e74c3c') %}
<div class="card border-0 shadow-sm mb-4 p-4" style="border-radius:1rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07) !important">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Sector timing — {{ sectorTiming.sector }}</h5>
        <span class="badge" style="background:{{ tColor }};font-size:.95rem">{{ sectorTiming.score }}/100 · {{ sectorTiming.signal }}</span>
    </div>
    <p class="text-muted small mb-0 mt-2"><i class="bi bi-info-circle me-1"></i>
        {% if sectorTiming.change_pct is not null %}Sector momentum {{ sectorTiming.change_pct > 0 ? '+' }}{{ sectorTiming.change_pct }}%{% endif %}
        (Tunisian Stock Exchange, {{ sectorTiming.period }}). Higher = better time to enter this sector.</p>
</div>
{% endif %}

{# Rate Cards #}
<div class="row g-3 mb-4">
    {% for currency, rate in {'EUR': rates.EUR, 'USD': rates.USD, 'GBP': rates.GBP} %}
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4" style="border-radius:1rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07) !important">
            <div class="mb-2" style="font-size:2.5rem">
                {% if currency == 'EUR' %}🇪🇺{% elseif currency == 'USD' %}🇺🇸{% else %}🇬🇧{% endif %}
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--nj-primary)">1 TND = {{ rate ? rate|number_format(4) : 'N/A' }} {{ currency }}</h3>
            <p class="text-muted small mb-0">Tunisian Dinar &rarr; {{ currency }}</p>
        </div>
    </div>
    {% endfor %}
</div>

{# Conversion Table #}
{% if conversions|length > 0 and projet.donneesBusiness %}
<div class="card border-0 shadow-sm p-4" style="border-radius:1rem">
    <h5 class="fw-bold mb-4"><i class="bi bi-table me-2"></i>Converted Financial Data</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Indicator</th>
                    <th class="text-end">TND (Dinar)</th>
                    <th class="text-end">🇪🇺 EUR</th>
                    <th class="text-end">🇺🇸 USD</th>
                    <th class="text-end">🇬🇧 GBP</th>
                </tr>
            </thead>
            <tbody>
                {% set db = projet.donneesBusiness %}
                <tr>
                    <td><i class="bi bi-globe text-primary me-2"></i>Market Size</td>
                    <td class="text-end fw-semibold">{{ db.tailleMarche|number_format(0, ',', ' ') }} TND</td>
                    {% for cur in ['EUR', 'USD', 'GBP'] %}
                    <td class="text-end">{{ conversions[cur].taille_marche is not null ? conversions[cur].taille_marche|number_format(0, ',', ' ') ~ ' ' ~ cur : 'N/A' }}</td>
                    {% endfor %}
                </tr>
                <tr>
                    <td><i class="bi bi-arrow-down-circle text-danger me-2"></i>Estimated Costs</td>
                    <td class="text-end fw-semibold">{{ db.coutsEstimes|number_format(0, ',', ' ') }} TND</td>
                    {% for cur in ['EUR', 'USD', 'GBP'] %}
                    <td class="text-end">{{ conversions[cur].couts_estimes is not null ? conversions[cur].couts_estimes|number_format(0, ',', ' ') ~ ' ' ~ cur : 'N/A' }}</td>
                    {% endfor %}
                </tr>
                <tr>
                    <td><i class="bi bi-arrow-up-circle text-success me-2"></i>Expected Revenue</td>
                    <td class="text-end fw-semibold">{{ db.revenusAttendus|number_format(0, ',', ' ') }} TND</td>
                    {% for cur in ['EUR', 'USD', 'GBP'] %}
                    <td class="text-end">{{ conversions[cur].revenus_attendus is not null ? conversions[cur].revenus_attendus|number_format(0, ',', ' ') ~ ' ' ~ cur : 'N/A' }}</td>
                    {% endfor %}
                </tr>
                <tr>
                    <td><i class="bi bi-cash-stack text-warning me-2"></i><strong>Estimated Margin</strong></td>
                    <td class="text-end fw-bold" style="color:{{ db.margeEstimee >= 0 ? '#10b981' : '#ef4444' }}">{{ db.margeEstimee|number_format(0, ',', ' ') }} TND</td>
                    {% for cur in ['EUR', 'USD', 'GBP'] %}
                    <td class="text-end fw-bold" style="color:{{ conversions[cur].marge >= 0 ? '#10b981' : '#ef4444' }}">{{ conversions[cur].marge is not null ? conversions[cur].marge|number_format(0, ',', ' ') ~ ' ' ~ cur : 'N/A' }}</td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="card border-0 shadow-sm p-5 text-center" style="border-radius:1rem">
    <i class="bi bi-info-circle" style="font-size:3rem;color:var(--nj-primary);opacity:.4"></i>
    <p class="text-muted mt-3 mb-0">Add business data to your project to see the currency conversions.</p>
</div>
{% endif %}
{% endblock %}
