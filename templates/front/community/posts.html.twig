{% extends 'front/layout.html.twig' %}

{% block title %}Community Feed - Najahni{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .community-feed-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: .75rem;
    }

    .community-post-copy {
        white-space: pre-wrap;
        line-height: 1.65;
    }

    .community-post-image {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, .08);
    }

    .community-reaction-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .8rem;
    }

    .community-reaction-picker {
        position: relative;
        display: flex;
        align-items: center;
        gap: .45rem;
    }

    .community-reaction-picker.is-submitting {
        pointer-events: none;
    }

    .community-reaction-trigger,
    .community-reaction-toggle {
        appearance: none;
        border: 1px solid rgba(255, 255, 255, .12);
        background: rgba(255, 255, 255, .06);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: rgba(226, 232, 240, .8);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, background-color .18s ease;
    }

    .community-reaction-trigger {
        gap: .55rem;
        padding: .55rem .95rem;
        border-radius: 999px;
        font-weight: 600;
    }

    .community-reaction-toggle {
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 999px;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .community-reaction-trigger:hover,
    .community-reaction-trigger.active,
    .community-reaction-toggle:hover,
    .community-reaction-picker.is-open .community-reaction-toggle {
        transform: translateY(-1px);
        border-color: rgba(67, 97, 238, .4);
        background: rgba(67, 97, 238, .15);
        box-shadow: 0 10px 24px rgba(67, 97, 238, .2);
        color: #fff;
    }

    .community-reaction-trigger-icon {
        font-size: 1.1rem;
    }

    .community-picker-menu {
        position: absolute;
        left: 0;
        bottom: calc(100% + .7rem);
        z-index: 12;
        min-width: 13rem;
        padding: .5rem;
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, .1);
        background: rgba(11, 20, 49, .97);
        backdrop-filter: blur(14px);
        box-shadow: 0 20px 48px rgba(0, 0, 0, .5);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(.45rem) scale(.98);
        transition: opacity .16s ease, transform .16s ease, visibility .16s ease;
    }

    .community-reaction-menu {
        display: flex;
        gap: .35rem;
        min-width: 0;
    }

    .community-reaction-menu form {
        margin: 0;
    }

    .community-reaction-option {
        appearance: none;
        border: none;
        background: transparent;
        color: rgba(226, 232, 240, .8);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .25rem;
        padding: .15rem;
        cursor: pointer;
    }

    .community-reaction-option-emoji {
        display: grid;
        place-items: center;
        width: 2.7rem;
        height: 2.7rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, .1);
        background: rgba(255, 255, 255, .06);
        font-size: 1.35rem;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
    }

    .community-reaction-option:hover .community-reaction-option-emoji,
    .community-reaction-option:focus-visible .community-reaction-option-emoji {
        transform: translateY(-.22rem) scale(1.06);
        box-shadow: 0 14px 24px rgba(67, 97, 238, .25);
        border-color: rgba(67, 97, 238, .4);
    }

    .community-reaction-option-label {
        font-size: .72rem;
        color: rgba(255, 255, 255, .45);
    }

    .community-reaction-option.active .community-reaction-option-emoji {
        border-color: rgba(67, 97, 238, .45);
        background: rgba(67, 97, 238, .2);
    }

    .community-reaction-option-remove .community-reaction-option-emoji {
        font-size: 1.2rem;
    }

    .community-reaction-picker:hover .community-picker-menu,
    .community-reaction-picker:focus-within .community-picker-menu,
    .community-reaction-picker.is-open .community-picker-menu {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    .community-reaction-caption {
        font-size: .94rem;
        color: rgba(255, 255, 255, .5);
    }

    .community-side-card {
        position: sticky;
        top: 5.5rem;
    }

    @media (max-width: 991px) {
        .community-feed-toolbar {
            grid-template-columns: 1fr;
        }

        .community-side-card {
            position: static;
        }
    }
</style>
{% endblock %}

{% block main %}
{% set newPostData = newPostData|default({content: ''}) %}
{% set newPostErrors = newPostErrors|default({}) %}
{% set openPostEditId = openPostEditId|default(null) %}
{% set postEditData = postEditData|default({content: '', remove_image: false}) %}
{% set postEditErrors = postEditErrors|default({}) %}

{# ── Page Hero ── #}
<div class="nj-page-hero nj-hero-community mb-4">
    <i class="bi bi-people nj-ph-icon"></i>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3" style="position:relative;z-index:1">
        <div>
            <div class="nj-ph-eyebrow">Community</div>
            <h1 class="nj-ph-title mb-1">Feed</h1>
            <p class="nj-ph-sub">Share, react and connect with the Najahni community</p>
        </div>
        <div class="nj-hero-actions">
            <div class="nj-action-group">
                <a href="{{ path('app_community_groups') }}" class="nj-action-link"><i class="bi bi-collection"></i>Groups</a>
                <span class="nj-action-sep"></span>
                <a href="{{ path('app_community_events') }}" class="nj-action-link"><i class="bi bi-calendar-event"></i>Events</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="nj-filter-bar nj-filter-community mb-4">
            <form method="get" action="{{ path('app_community_posts') }}" class="community-feed-toolbar w-100">
                <input type="search" name="q" value="{{ search }}" class="form-control" placeholder="Search by author or text..." data-live-post-search>
                <select name="sort" class="form-select">
                    <option value="newest" {{ sort == 'newest' ? 'selected' }}>Most recent</option>
                    <option value="oldest" {{ sort == 'oldest' ? 'selected' }}>Oldest first</option>
                    <option value="reactions" {{ sort == 'reactions' ? 'selected' }}>Most reactions</option>
                </select>
                <button type="submit" class="btn btn-outline-nj"><i class="bi bi-funnel me-1"></i>Filter</button>
            </form>
        </div>

        <div class="nj-section-label" style="--nj-section-color:linear-gradient(135deg,#db2777,#7c3aed)"><i class="bi bi-pencil-square me-1"></i>New Post</div>
        {# New Post Form #}
        <div class="card border-0 shadow-sm mb-4" style="border-radius:1rem">
            <div class="card-body p-4">
                {# AI moderation warning (hidden by default, shown by JS) #}
                <div id="aiModerationWarning" class="d-none mb-3 p-3 rounded-3" style="background:rgba(239,71,111,.1);border:1.5px solid rgba(239,71,111,.3)">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-exclamation" style="color:#fca5a5;font-size:1.1rem"></i>
                        <div>
                            <div class="fw-semibold" style="color:#fca5a5;font-size:.88rem">AI Moderation Warning</div>
                            <div class="text-muted" style="font-size:.8rem">Your post contains inappropriate content. It will be automatically filtered before publication.</div>
                        </div>
                        <span class="badge ms-auto" style="background:rgba(239,71,111,.2);color:#fca5a5;font-size:.7rem"><i class="bi bi-robot me-1"></i>AI Filter</span>
                    </div>
                </div>
                <form method="post" action="{{ path('app_community_post_new') }}" enctype="multipart/form-data">
                    <label class="form-label fw-semibold">Text</label>
                    <textarea id="newPostContent" name="content" class="form-control mb-3{{ newPostErrors.content is defined ? ' is-invalid' }}" rows="3" placeholder="What's new? Share with the community..." maxlength="500">{{ newPostData.content }}</textarea>
                    {% if newPostErrors.content is defined %}
                    <div class="invalid-feedback d-block mb-3">{{ newPostErrors.content }}</div>
                    {% endif %}
                    <div class="row g-3 align-items-center">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Photo</label>
                            <input type="file" name="image" class="form-control{{ newPostErrors.image is defined ? ' is-invalid' }}" accept="image/*">
                            {% if newPostErrors.image is defined %}
                            <div class="invalid-feedback d-block">{{ newPostErrors.image }}</div>
                            {% endif %}
                        </div>
                        <div class="col-md-6 d-flex justify-content-between align-items-center">
                            <small class="text-muted">Text or image, max 500 characters</small>
                            <button type="submit" class="btn btn-nj"><i class="bi bi-send me-2"></i>Post</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {# Posts Feed #}
        <div class="nj-section-label" style="--nj-section-color:linear-gradient(135deg,#db2777,#7c3aed)"><i class="bi bi-chat-square-text me-1"></i>Feed</div>
        <div id="liveResults">
        {% for post in posts %}
        {% set myReaction = post.getReactionTypeForUser(app.user) %}
        {% set summary = post.reactionSummary %}
        {% set reactionCaption = post.reactionsCount > 0 ? post.reactionsCount ~ ' reactions' : 'No reactions yet' %}
        {% set currentReactionMeta = myReaction and reactionMeta[myReaction] is defined ? reactionMeta[myReaction] : reactionMeta['LIKE'] %}
        {% set postEditActive = openPostEditId == post.id %}
        {% if myReaction and reactionMeta[myReaction] is defined %}
            {% set reactionCaption = reactionCaption ~ ' · You chose ' ~ reactionMeta[myReaction].label %}
        {% endif %}
        <div id="post-{{ post.id }}" class="card border-0 shadow-sm mb-3" style="border-radius:1rem" data-post-id="{{ post.id }}" data-live-post-card data-live-post-text="{{ (post.user.firstname ~ ' ' ~ post.user.lastname ~ ' ' ~ post.content)|lower|e('html_attr') }}">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <a href="{{ path('app_user_profile', {id: post.user.id}) }}" class="text-decoration-none d-flex align-items-center">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;background:var(--nj-gradient);color:#fff">
                            {{ post.user.firstname|first|upper }}{{ post.user.lastname|first|upper }}
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">{{ post.user.firstname }} {{ post.user.lastname }}</h6>
                            <small class="text-muted">{{ post.createdAt|date('d/m/Y H:i') }}</small>
                        </div>
                    </a>
                    <div class="ms-auto d-flex gap-2 align-items-center">
                        <select class="form-select form-select-sm community-translation-select" data-translate-url="{{ path('app_community_post_translate', {id: post.id}) }}" style="width:130px;min-width:130px">
                            <option value="original">Original</option>
                            {% for code, label in translationLanguages %}
                            <option value="{{ code }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                        {% if post.user == app.user or is_granted('ROLE_ADMIN') %}
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#edit-post-{{ post.id }}"><i class="bi bi-pencil-square"></i></button>
                        <form method="post" action="{{ path('app_community_post_delete', {id: post.id}) }}">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                        {% endif %}
                    </div>
                </div>

                <p class="mb-2 community-post-copy" data-post-text data-original-text="{{ post.content|e('html_attr') }}">{{ post.content }}</p>
                <small class="text-muted d-block mb-3" data-translation-status>Original text</small>

                {% if post.imageUrl %}
                <img src="{{ post.imageUrl }}" alt="Illustration de publication" class="community-post-image mb-3">
                {% endif %}

                {% if post.user == app.user or is_granted('ROLE_ADMIN') %}
                <div class="collapse mb-3{{ postEditActive ? ' show' : '' }}" id="edit-post-{{ post.id }}">
                    <div class="border rounded-4 p-3 bg-light-subtle">
                        <form method="post" action="{{ path('app_community_post_update', {id: post.id}) }}" enctype="multipart/form-data">
                            <label class="form-label fw-semibold">Texte</label>
                            <textarea name="content" class="form-control mb-3{{ postEditActive and postEditErrors.content is defined ? ' is-invalid' }}" rows="3" maxlength="500">{{ postEditActive ? postEditData.content : post.content }}</textarea>
                            {% if postEditActive and postEditErrors.content is defined %}
                            <div class="invalid-feedback d-block mb-3">{{ postEditErrors.content }}</div>
                            {% endif %}
                            <div class="row g-3 align-items-center">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Image</label>
                                    <input type="file" name="image" class="form-control{{ postEditActive and postEditErrors.image is defined ? ' is-invalid' }}" accept="image/*">
                                    {% if postEditActive and postEditErrors.image is defined %}
                                    <div class="invalid-feedback d-block">{{ postEditErrors.image }}</div>
                                    {% endif %}
                                </div>
                                <div class="col-md-6 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    {% if post.imageUrl %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="remove_image" id="remove-image-{{ post.id }}" value="1" {{ postEditActive and postEditData.remove_image ? 'checked' }}>
                                        <label class="form-check-label small" for="remove-image-{{ post.id }}">Remove image</label>
                                    </div>
                                    {% endif %}
                                    <button type="submit" class="btn btn-sm btn-nj">Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                {% endif %}

                {# Reactions #}
                <div class="community-reaction-bar">
                    <div class="community-reaction-picker" data-picker-root data-reaction-picker data-react-url="{{ path('app_community_post_react', {id: post.id}) }}" data-remove-url="{{ path('app_community_post_unreact', {id: post.id}) }}">
                        <form method="post" action="{{ myReaction ? path('app_community_post_unreact', {id: post.id}) : path('app_community_post_react', {id: post.id}) }}" data-async-reaction data-reaction-main-form>
                            <input type="hidden" name="reaction" value="LIKE">
                            <button class="community-reaction-trigger {{ myReaction ? 'active' }}" type="submit" data-reaction-trigger>
                                <span class="community-reaction-trigger-icon" data-reaction-trigger-icon>{{ myReaction ? currentReactionMeta.emoji : reactionMeta['LIKE'].emoji }}</span>
                                <span data-reaction-trigger-label>{{ myReaction ? currentReactionMeta.label : 'Like' }}</span>
                            </button>
                        </form>

                        <button class="community-reaction-toggle" type="button" data-picker-toggle aria-expanded="false" aria-label="Choose a reaction">+</button>

                        <div class="community-picker-menu community-reaction-menu" data-picker-menu>
                            {% for type, meta in reactionMeta %}
                            <form method="post" action="{{ path('app_community_post_react', {id: post.id}) }}" data-async-reaction>
                                <input type="hidden" name="reaction" value="{{ type }}">
                                <button class="community-reaction-option {{ myReaction == type ? 'active' }}" type="submit" title="{{ meta.label }}" aria-label="{{ meta.label }}" data-reaction-option data-reaction-type="{{ type }}">
                                    <span class="community-reaction-option-emoji">{{ meta.emoji }}</span>
                                    <span class="community-reaction-option-label">{{ meta.label }}</span>
                                </button>
                            </form>
                            {% endfor %}

                            <form method="post" action="{{ path('app_community_post_unreact', {id: post.id}) }}" data-async-reaction data-reaction-remove-form {{ myReaction ? '' : 'hidden' }}>
                                <button class="community-reaction-option community-reaction-option-remove" type="submit" title="Remove reaction" aria-label="Remove reaction">
                                    <span class="community-reaction-option-emoji">×</span>
                                    <span class="community-reaction-option-label">Remove</span>
                                </button>
                            </form>
                        </div>
                    </div>
                    <small class="community-reaction-caption" data-reaction-caption>{{ reactionCaption }}</small>
                </div>
            </div>
        </div>
        {% else %}
        <div class="text-center py-5">
            <div class="text-center"><i class="bi bi-chat-left-text" style="font-size:3rem;color:var(--nj-primary)"></i></div>
            <p class="text-muted mt-2">No posts yet. Be the first to share!</p>
        </div>
        {% endfor %}
        </div>
        {% if posts|length > 0 %}
        <div class="text-center py-5 d-none" data-live-post-empty>
            <div class="text-center"><i class="bi bi-search" style="font-size:2.5rem;color:var(--nj-primary)"></i></div>
            <p class="text-muted mt-2 mb-0">No posts match your live search.</p>
        </div>
        {% endif %}
    </div>

    {# Sidebar #}
    <div class="col-xl-4">
        <div class="community-side-card d-flex flex-column gap-3">

            {# Navigation #}
            <div class="card border-0 shadow-sm" style="border-radius:1rem">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-grid me-2"></i>Navigation</h6>
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_community_groups') }}" class="btn btn-outline-primary text-start"><i class="bi bi-people me-2"></i>Groups</a>
                        <a href="{{ path('app_community_events') }}" class="btn btn-outline-primary text-start"><i class="bi bi-calendar-event me-2"></i>Events</a>
                    </div>
                </div>
            </div>

            {# Upcoming Events #}
            <div class="card border-0 shadow-sm" style="border-radius:1rem;border-top:3px solid var(--nj-c-community)!important">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-calendar-event me-2" style="color:var(--nj-c-community)"></i>Upcoming Events</h6>
                        <a href="{{ path('app_community_events') }}" class="small text-decoration-none" style="color:var(--nj-primary)">See all</a>
                    </div>
                    {% if upcomingEvents|length > 0 %}
                    <div class="d-flex flex-column gap-3">
                        {% for event in upcomingEvents %}
                        <div style="border-left:3px solid var(--nj-c-community);padding-left:.85rem">
                            <div class="fw-semibold" style="font-size:.88rem">{{ event.title }}</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>{{ event.eventDate|date('d M Y, H:i') }}</small>
                                <small class="text-muted"><i class="bi bi-people me-1"></i>{{ event.participantsCount }}{% if event.capacity > 0 %}/{{ event.capacity }}{% endif %}</small>
                            </div>
                            {% if event.hasCapacity and not event.hasParticipant(app.user) %}
                            <form method="post" action="{{ path('app_community_event_join', {id: event.id}) }}" class="mt-2">
                                <button class="btn btn-sm btn-nj w-100" style="font-size:.75rem;padding:.3rem .7rem"><i class="bi bi-check-circle me-1"></i>Join</button>
                            </form>
                            {% elseif event.hasParticipant(app.user) %}
                            <div class="mt-2"><span class="badge" style="background:rgba(236,72,153,.15);color:#f9a8d4;font-size:.72rem"><i class="bi bi-check-circle-fill me-1"></i>Registered</span></div>
                            {% else %}
                            <div class="mt-2"><span class="badge bg-secondary" style="font-size:.72rem">Full</span></div>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-2">
                        <i class="bi bi-calendar-x" style="font-size:2rem;color:rgba(255,255,255,.2)"></i>
                        <p class="text-muted small mb-2 mt-1">No upcoming events.</p>
                        <a href="{{ path('app_community_event_new') }}" class="btn btn-sm btn-outline-secondary">Create one</a>
                    </div>
                    {% endif %}
                </div>
            </div>

            {# AI Moderation Info #}
            <div class="card border-0 shadow-sm" style="border-radius:1rem;background:linear-gradient(135deg,rgba(67,97,238,.08),rgba(114,9,183,.06));border:1.5px solid rgba(67,97,238,.2)!important">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-2"><i class="bi bi-shield-check me-2" style="color:var(--nj-success)"></i>AI Moderation Active</h6>
                    <p class="text-muted small mb-0">Every post is automatically scanned for inappropriate content before publication. The AI filters profanity in English, French and Arabic in real time.</p>
                    <div class="d-flex align-items-center gap-2 mt-3">
                        <span class="badge" style="background:rgba(6,214,160,.15);color:#6ee7b7;font-size:.72rem"><i class="bi bi-circle-fill me-1" style="font-size:.45rem"></i>Online</span>
                        <small class="text-muted" style="font-size:.72rem">Powered by PurgoMalum API</small>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const reactionMeta = {
        LIKE: { label: 'J\'aime', emoji: '👍' },
        LOVE: { label: 'Love', emoji: '❤️' },
        HAHA: { label: 'Haha', emoji: '😂' },
        WOW: { label: 'Wow', emoji: '😮' },
        SAD: { label: 'Sad', emoji: '😢' },
        ANGRY: { label: 'Angry', emoji: '😡' },
    };

    const closePickers = (except = null) => {
        document.querySelectorAll('[data-picker-root]').forEach((root) => {
            if (root === except) {
                return;
            }

            root.classList.remove('is-open');
            const toggle = root.querySelector('[data-picker-toggle]');
            if (toggle instanceof HTMLButtonElement) {
                toggle.setAttribute('aria-expanded', 'false');
            }
        });
    };

    const setReactionError = (picker, message) => {
        const caption = picker.closest('.community-reaction-bar')?.querySelector('[data-reaction-caption]');
        if (!(caption instanceof HTMLElement)) {
            return;
        }

        const previous = caption.dataset.previousCaption || caption.textContent || '';
        caption.textContent = message;

        window.setTimeout(() => {
            caption.textContent = previous;
        }, 1500);
    };

    const applyReactionState = (picker, payload) => {
        const reaction = typeof payload.myReaction === 'string' ? payload.myReaction : '';
        const current = reaction !== '' ? (reactionMeta[reaction] || reactionMeta.LIKE) : reactionMeta.LIKE;
        const mainForm = picker.querySelector('[data-reaction-main-form]');
        const trigger = picker.querySelector('[data-reaction-trigger]');
        const icon = picker.querySelector('[data-reaction-trigger-icon]');
        const label = picker.querySelector('[data-reaction-trigger-label]');
        const caption = picker.closest('.community-reaction-bar')?.querySelector('[data-reaction-caption]');
        const removeForm = picker.querySelector('[data-reaction-remove-form]');

        if (mainForm instanceof HTMLFormElement) {
            mainForm.action = reaction === ''
                ? (picker.dataset.reactUrl || mainForm.action)
                : (picker.dataset.removeUrl || mainForm.action);
        }

        if (trigger instanceof HTMLButtonElement) {
            trigger.classList.toggle('active', reaction !== '');
        }

        if (icon instanceof HTMLElement) {
            icon.textContent = payload.currentEmoji || current.emoji;
        }

        if (label instanceof HTMLElement) {
            label.textContent = payload.currentLabel || current.label;
        }

        if (caption instanceof HTMLElement) {
            caption.textContent = payload.caption || (payload.reactionsCount > 0 ? `${payload.reactionsCount} reactions` : 'Pas encore de reaction');
            caption.dataset.previousCaption = caption.textContent;
        }

        if (removeForm instanceof HTMLFormElement) {
            removeForm.hidden = reaction === '';
        }

        picker.querySelectorAll('[data-reaction-option]').forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) {
                return;
            }

            button.classList.toggle('active', button.dataset.reactionType === reaction);
        });

        closePickers();
    };

    document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (target === null) {
            return;
        }

        const toggle = target.closest('[data-picker-toggle]');
        if (toggle instanceof HTMLButtonElement) {
            const root = toggle.closest('[data-picker-root]');
            if (!(root instanceof HTMLElement)) {
                return;
            }

            const willOpen = !root.classList.contains('is-open');
            closePickers(willOpen ? root : null);
            root.classList.toggle('is-open', willOpen);
            toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
            return;
        }

        if (!target.closest('[data-picker-root]')) {
            closePickers();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closePickers();
        }
    });

    document.querySelectorAll('[data-reaction-picker]').forEach((picker) => {
        picker.addEventListener('submit', async (event) => {
            const target = event.target;
            const form = target instanceof HTMLFormElement && target.matches('[data-async-reaction]') ? target : null;

            if (form === null) {
                return;
            }

            event.preventDefault();

            if (!(picker instanceof HTMLElement) || picker.classList.contains('is-submitting')) {
                return;
            }

            picker.classList.add('is-submitting');

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json',
                    },
                    body: new FormData(form),
                    credentials: 'same-origin',
                });

                const data = await response.json();

                if (!response.ok || data.ok !== true) {
                    throw new Error(data.message || 'La reaction a echoue.');
                }

                applyReactionState(picker, data);
            } catch (error) {
                setReactionError(picker, error instanceof Error ? error.message : 'La reaction a echoue.');
            } finally {
                picker.classList.remove('is-submitting');
            }
        });
    });

    document.querySelectorAll('.community-translation-select').forEach((select) => {
        select.addEventListener('change', async () => {
            const card = select.closest('[data-post-id]');
            const url = select.dataset.translateUrl;
            const textNode = card.querySelector('[data-post-text]');
            const statusNode = card.querySelector('[data-translation-status]');
            const originalText = textNode.dataset.originalText || '';

            try {
                select.setAttribute('disabled', 'disabled');
                const response = await fetch(`${url}?target=${encodeURIComponent(select.value)}`, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                });

                const data = await response.json();

                if (!response.ok || !data.ok) {
                    throw new Error(data.message || 'La traduction est indisponible.');
                }

                textNode.textContent = data.text;
                statusNode.textContent = data.is_original
                    ? 'Texte original'
                    : `Traduit de ${data.source_label} vers ${data.target_label}`;
            } catch (error) {
                textNode.textContent = originalText;
                statusNode.textContent = error.message;
                select.value = 'original';
            } finally {
                select.removeAttribute('disabled');
            }
        });
    });
    // Client-side instant post filtering
    const livePostSearch = document.querySelector('[data-live-post-search]');
    const livePostCards = Array.from(document.querySelectorAll('[data-live-post-card]'));
    const livePostEmpty = document.querySelector('[data-live-post-empty]');

    const applyLivePostFilter = () => {
        if (!(livePostSearch instanceof HTMLInputElement)) {
            return;
        }

        const needle = livePostSearch.value.trim().toLowerCase();
        let visible = 0;

        livePostCards.forEach((card) => {
            if (!(card instanceof HTMLElement)) {
                return;
            }

            const haystack = (card.dataset.livePostText || '').toLowerCase();
            const matches = needle === '' || haystack.includes(needle);
            card.classList.toggle('d-none', !matches);

            if (matches) {
                visible += 1;
            }
        });

        if (livePostEmpty instanceof HTMLElement) {
            livePostEmpty.classList.toggle('d-none', visible !== 0);
        }
    };

    if (livePostSearch instanceof HTMLInputElement) {
        livePostSearch.addEventListener('input', applyLivePostFilter);
        applyLivePostFilter();
    }

    // Real-time AI moderation warning
    (function(){
        const textarea = document.getElementById('newPostContent');
        const warning = document.getElementById('aiModerationWarning');
        if (!textarea || !warning) return;
        const badWords = ['fuck','shit','bitch','asshole','bastard','merde','putain','salope','conard','conasse','puta','idiot','stupid'];
        textarea.addEventListener('input', function(){
            const val = textarea.value.toLowerCase();
            const hasBad = badWords.some(w => val.includes(w));
            warning.classList.toggle('d-none', !hasBad);
        });
    })();

    // AJAX sort (server-side) for the sort dropdown
    (function(){
        const form = document.querySelector('.community-feed-toolbar');
        if (!form) return;
        const sortSelect = form.querySelector('select[name="sort"]');
        let timer;
        function liveSearch() {
            clearTimeout(timer);
            timer = setTimeout(function() {
                const params = new URLSearchParams(new FormData(form)).toString();
                fetch(form.action + '?' + params, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function(r) { return r.text(); })
                    .then(function(html) {
                        const doc = new DOMParser().parseFromString(html, 'text/html');
                        const newResults = doc.getElementById('liveResults');
                        if (newResults) document.getElementById('liveResults').innerHTML = newResults.innerHTML;
                    });
            }, 300);
        }
        if (sortSelect) sortSelect.addEventListener('change', liveSearch);
        form.addEventListener('submit', function(e) { e.preventDefault(); liveSearch(); });
    })();
});
</script>
{% endblock %}
