<div class="nj-chat-panel" id="njChatPanel">
    <div class="nj-chat-header">
        <div class="nj-chat-header-avatar"><i class="bi bi-robot text-white" style="font-size:.85rem"></i></div>
        <div class="flex-grow-1">
