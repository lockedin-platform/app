    </div>
    <div class="nj-chat-messages" id="njChatMessages">
        <div class="nj-chat-msg bot">
            <div class="nj-chat-avatar"><i class="bi bi-robot text-white"></i></div>
            <div class="nj-chat-bubble">Hello {{ app.user.firstname }}! 👋 I'm <strong>LockedIn AI</strong>. How can I help you today?</div>
        </div>
    </div>
    <div class="nj-chat-quick" id="njChatQuick">
        <button class="nj-chat-qbtn" data-q="How do I create a project?">💡 Create project</button>
        <button class="nj-chat-qbtn" data-q="How do I find investors?">💰 Investment</button>
        <button class="nj-chat-qbtn" data-q="How do I find a mentor?">🎓 Mentoring</button>
    </div>
    <div class="nj-chat-input-wrap">
        <input type="text" class="nj-chat-input" id="njChatInput" placeholder="Ask your question..." autocomplete="off">
        <button class="nj-chat-send" id="njChatSend"><i class="bi bi-send-fill"></i></button>
    </div>
</div>

<script>
(function(){
    const fab = document.getElementById('njChatFab');
    const panel = document.getElementById('njChatPanel');
    const messages = document.getElementById('njChatMessages');
    const input = document.getElementById('njChatInput');
    const send = document.getElementById('njChatSend');
    const quickWrap = document.getElementById('njChatQuick');
    const chatUrl = '{{ path("app_global_ai_chat") }}';
    let open = false;

    fab.addEventListener('click', function(){
        open = !open;
        fab.classList.toggle('open', open);
        panel.classList.toggle('visible', open);
        if(open) input.focus();
    });

    function scrollBottom(){ messages.scrollTop = messages.scrollHeight; }

    function escHtml(s){ const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

    function formatText(t){
        t = t.replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>');
        t = t.replace(/\n/g,'<br>');
        return t;
    }

    function addMsg(text, role){
        const d = document.createElement('div');
        d.className = 'nj-chat-msg ' + role;
        if(role === 'bot'){
            d.innerHTML = '<div class="nj-chat-avatar"><i class="bi bi-robot text-white"></i></div><div class="nj-chat-bubble">' + formatText(text) + '</div>';
        } else {
            d.innerHTML = '<div class="nj-chat-bubble">' + escHtml(text) + '</div><div class="nj-chat-avatar"><i class="bi bi-person-fill" style="color:rgba(255,255,255,.7)"></i></div>';
        }
        messages.appendChild(d);
        scrollBottom();
    }

    function addTyping(){
        const d = document.createElement('div');
        d.id = 'njTyping';
        d.className = 'nj-chat-msg bot';
        d.innerHTML = '<div class="nj-chat-avatar"><i class="bi bi-robot text-white"></i></div><div class="nj-chat-bubble" style="padding:.45rem .7rem"><div class="nj-typing"><span></span><span></span><span></span></div></div>';
        messages.appendChild(d);
        scrollBottom();
    }

    function removeTyping(){ const t = document.getElementById('njTyping'); if(t) t.remove(); }

    async function ask(msg){
        if(!msg.trim()) return;
        quickWrap.style.display = 'none';
        addMsg(msg, 'user');
        input.value = '';
        input.disabled = true;
        send.disabled = true;
        addTyping();
        try {
            const r = await fetch(chatUrl, {
                method:'POST',
                headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
                body: JSON.stringify({message: msg})
            });
            removeTyping();
            const data = await r.json();
            addMsg(data.response || data.error || 'Unexpected error.', 'bot');
        } catch(e){
            removeTyping();
            addMsg('Connection error. Check your network.', 'bot');
        }
        input.disabled = false;
        send.disabled = false;
        input.focus();
    }

    send.addEventListener('click', () => ask(input.value));
    input.addEventListener('keydown', e => { if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); ask(input.value); }});
    quickWrap.querySelectorAll('.nj-chat-qbtn').forEach(b => b.addEventListener('click', () => ask(b.dataset.q)));
})();
</script>
{% endif %}

