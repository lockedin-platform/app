{% extends 'front/layout.html.twig' %}

{% block title %}Mentoring Chatbot - Najahni{% endblock %}

{% block main %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-mortarboard me-2"></i>Mentorat</h2>
</div>

{# ── 4-Tab Navigation (role-aware) ── #}
{% set userRole = app.user.role %}
<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link" href="{{ path('app_mentorat_requests') }}"><i class="bi bi-send me-1"></i>Requests</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_mentorat_sessions') }}"><i class="bi bi-camera-video me-1"></i>Sessions</a></li>
    {% if userRole == 'MENTOR' %}
        <li class="nav-item"><a class="nav-link" href="{{ path('app_mentorat_availability') }}"><i class="bi bi-calendar-check me-1"></i>Availability</a></li>
    {% endif %}
    <li class="nav-item"><a class="nav-link active" href="{{ path('app_mentorat_chatbot') }}"><i class="bi bi-robot me-1"></i>Chatbot</a></li>
</ul>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="border-radius:1rem">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-robot me-2"></i>Najahni Assistant</h5>
                <p class="text-muted small mb-0">Ask your questions about Najahni, mentoring, projects, investment...</p>
            </div>
            <div class="card-body p-4">
                <div id="chatMessages" style="height:400px;overflow-y:auto;border:1px solid #e9ecef;border-radius:0.75rem;padding:1rem;background:#f8f9fa;" class="mb-3">
                    <div class="d-flex mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;min-width:32px;background:var(--nj-gradient);color:#fff"><i class="bi bi-robot"></i></div>
                        <div class="bg-white p-2 px-3 rounded-3 shadow-sm" style="max-width:80%">
                            <small>Hello {{ app.user.firstname }}! 👋 I am the Najahni assistant. I know everything about the platform: mentoring, sessions, calendar, projects, investment, community and learning. How can I help you?</small>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="What is Najahni?"><i class="bi bi-info-circle me-1"></i>What is Najahni?</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="How to find a mentor?"><i class="bi bi-search me-1"></i>Find a mentor</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="How to book a session?"><i class="bi bi-calendar-check me-1"></i>Book a session</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Who are the best mentors?"><i class="bi bi-star me-1"></i>Best mentors</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="How does matching work?"><i class="bi bi-lightning me-1"></i>Matching</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Help"><i class="bi bi-question-circle me-1"></i>Help</button>
                </div>
                <div class="input-group">
                    <input type="text" id="chatInput" class="form-control" placeholder="Type your message..." onkeypress="if(event.key==='Enter')sendMessage()">
                    <button class="btn btn-nj" onclick="sendMessage()"><i class="bi bi-send"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const knowledgeBase = [
    // ── About Najahni ──
    { keywords: ['najahni', 'plateforme', 'platform', 'c\'est quoi', 'what is', 'à propos', 'about'],
      answer: 'Najahni is a digital platform designed to foster entrepreneurship and mentoring by connecting dynamic founders with experienced mentors, investors and essential resources to build and grow innovative projects.' },

    { keywords: ['qui a créé', 'qui a fait', 'créateur', 'origine', 'esprit'],
      answer: 'Najahni is a PIDEV 3A project developed by students from Esprit, Ariana, Tunisia. It is a Tunisian platform connecting entrepreneurs, mentors and investors.' },

    // ── Mentors ──
    { keywords: ['meilleur mentor', 'best mentor', 'top mentor', 'recommand'],
      answer: 'The best mentors depend on your needs. The active super mentors on Najahni generally have strong skills in tech startups, strategic management and fundraising. Check the dashboard to see "Top Rated" mentors based on community feedback.' },

    { keywords: ['trouver mentor', 'find mentor', 'chercher mentor', 'mentor disponible', 'available mentor'],
      answer: 'You can navigate to the "Find a mentor" tab to see available slots. You can also check the Availability Calendar to see dates highlighted in green where mentors are free.' },

    { keywords: ['calendrier', 'calendar', 'disponibilité mentor', 'planning'],
      answer: 'The availability calendar displays dates where mentors are available with green cells. Click on a green date to see slots and send a request directly. Access it via Mentoring → Find a mentor → Calendar.' },

    // ── Booking / Requests ──
    { keywords: ['réserver', 'book', 'prendre rendez', 'demande mentorat', 'request'],
      answer: 'To book a session: find an available slot in the "Find a mentor" tab or the Calendar, then send a mentoring request. Once approved by the mentor (or auto-accepted if matching is ≥ 70%), the session will appear in your "Sessions" tab.' },

    { keywords: ['demande', 'envoyer demande', 'nouvelle demande', 'créer demande'],
      answer: 'To create a request: go to "Find a mentor", choose a mentor and fill in the form with your motivation, goals and optionally a linked project. The matching score will be calculated automatically.' },

    { keywords: ['annuler', 'cancel', 'supprimer demande'],
      answer: 'You can cancel a pending request from the "Requests" tab by clicking the cancel button. Cancelled requests can also be edited and resent.' },

    { keywords: ['modifier', 'edit', 'changer demande', 'mettre à jour'],
      answer: 'Pending or cancelled requests can be edited. Click the pencil icon (✏️) in the Actions column of the "Requests" tab.' },

    { keywords: ['statut', 'status', 'état'],
      answer: 'Possible statuses for a request are: Pending (PENDING), Accepted (ACCEPTED), Auto-accepted, Rejected (REJECTED), Cancelled (CANCELLED). For sessions: Scheduled, Completed, Cancelled, No-show.' },

    // ── Sessions ──
    { keywords: ['session', 'séance', 'rendez-vous', 'meeting'],
      answer: 'Sessions are created automatically when a request is accepted. Mentors can also create them manually. Each session has a date, duration, meeting link and a feedback system.' },

    { keywords: ['feedback', 'avis', 'note', 'rating', 'évaluation'],
      answer: 'After a session is completed, the mentor and entrepreneur can leave feedback and a rating from 1 to 5 stars. This contributes to the mentor rankings on the platform.' },

    { keywords: ['export', 'pdf', 'excel', 'télécharger'],
      answer: 'You can export your sessions as PDF or Excel from the "Sessions" tab by clicking the export buttons at the top of the page. The PDF is in A4 landscape format.' },

    // ── Matching ──
    { keywords: ['matching', 'score', 'auto-accept', 'compatibilité'],
      answer: 'The matching score is calculated automatically based on your profile, industry, bio and account verification. A score ≥ 70% triggers auto-acceptance of the request and automatic session creation.' },

    // ── Availability ──
    { keywords: ['disponibilité', 'créneau', 'horaire', 'slot', 'availability'],
      answer: 'As a mentor, manage your slots in the "Availability" tab: add, edit or delete your time slots. Your personal calendar ("My Calendar") displays all your published availabilities with green dates.' },

    // ── Real-time / Chat ──
    { keywords: ['chat en direct', 'real-time', 'messagerie', 'message direct', 'direct message'],
      answer: 'Currently, the application supports planning and managing mentoring sessions. You can also export session details as PDF. Direct messaging may be available in future versions.' },

    // ── Investment ──
    { keywords: ['investissement', 'investment', 'investisseur', 'investor', 'financement', 'funding'],
      answer: 'The Investment module on Najahni allows entrepreneurs to publish opportunities and investors to make offers. Access it via the "Investment" menu in the navigation bar.' },

    // ── Projects ──
    { keywords: ['projet', 'project', 'startup'],
      answer: 'The Projects module lets you create and manage your entrepreneurial projects. You can link a project to a mentoring request so the mentor better understands your needs.' },

    // ── Community ──
    { keywords: ['communauté', 'community', 'groupe', 'group', 'event', 'événement', 'post'],
      answer: 'The Community module includes posts, groups and events. Share your ideas, join themed groups and participate in events organized by the Najahni community.' },

    // ── Learning ──
    { keywords: ['apprentissage', 'cours', 'learning', 'formation', 'badge', 'xp'],
      answer: 'The Learning module offers courses classified by level (Beginner to Expert). Complete courses to earn XP points and unlock badges (Common, Rare, Epic, Legendary).' },

    // ── Account ──
    { keywords: ['profil', 'compte', 'profile', 'account', 'paramètre', 'settings'],
      answer: 'Manage your profile from the top-right menu → "My Profile". You can edit your information, photo, bio, company, and language/theme/currency preferences.' },

    // ── Greetings ──
    { keywords: ['bonjour', 'salut', 'hello', 'hi', 'bonsoir', 'hey', 'salam'],
      answer: 'Hello! 👋 I am the Najahni assistant. How can I help you today? You can ask me questions about mentoring, sessions, the calendar, projects, investment and more!' },

    { keywords: ['merci', 'thanks', 'thank you', 'شكرا'],
      answer: 'You\'re welcome! Don\'t hesitate if you have any other questions. 😊' },

    { keywords: ['aide', 'help', 'comment', 'how'],
      answer: 'I can help you with: 🔹 Finding a mentor and checking the calendar\n🔹 Creating, editing or cancelling requests\n🔹 Managing your sessions and leaving feedback\n🔹 Exporting your data (PDF/Excel)\n🔹 Understanding matching and auto-acceptance\n🔹 Navigating the modules: Projects, Investment, Community, Learning\n\nJust ask your question!' },
];

function findBestAnswer(text) {
    const lower = text.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    let bestMatch = null;
    let bestScore = 0;

    for (const entry of knowledgeBase) {
        let score = 0;
        for (const kw of entry.keywords) {
            const kwClean = kw.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            if (lower.includes(kwClean)) {
                score += kwClean.length;
            }
        }
        if (score > bestScore) {
            bestScore = score;
            bestMatch = entry;
        }
    }
    return bestMatch ? bestMatch.answer : null;
}

function sendMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;
    input.value = '';

    appendMessage(text, 'user');

    // Show typing indicator
    const typingId = showTyping();

    setTimeout(function() {
        removeTyping(typingId);
        const reply = findBestAnswer(text)
            || 'I don\'t have information on this topic at the moment. Try asking me questions about:\n🔹 Najahni and how it works\n🔹 Finding a mentor / Calendar\n🔹 Mentoring requests and sessions\n🔹 Matching and auto-acceptance\n🔹 PDF / Excel export\n🔹 Projects, Investment, Community, Learning';
        appendMessage(reply, 'bot');
    }, 600 + Math.random() * 400);
}

function appendMessage(text, sender) {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = 'd-flex mb-3' + (sender === 'user' ? ' justify-content-end' : '');

    const formatted = escapeHtml(text).replace(/\n/g, '<br>');

    if (sender === 'bot') {
        div.innerHTML = '<div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;min-width:32px;background:var(--nj-gradient);color:#fff"><i class="bi bi-robot"></i></div>'
            + '<div class="bg-white p-2 px-3 rounded-3 shadow-sm" style="max-width:80%"><small>' + formatted + '</small></div>';
    } else {
        div.innerHTML = '<div class="p-2 px-3 rounded-3" style="max-width:80%;background:var(--nj-gradient);color:#fff"><small>' + formatted + '</small></div>';
    }

    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

function showTyping() {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    const id = 'typing-' + Date.now();
    div.id = id;
    div.className = 'd-flex mb-3';
    div.innerHTML = '<div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;min-width:32px;background:var(--nj-gradient);color:#fff"><i class="bi bi-robot"></i></div>'
        + '<div class="bg-white p-2 px-3 rounded-3 shadow-sm"><small class="typing-dots"><span>.</span><span>.</span><span>.</span></small></div>';
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
    return id;
}

function removeTyping(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
}

function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
}

// Quick-suggestion buttons
document.querySelectorAll('.chatbot-suggestion').forEach(function(btn) {
    btn.addEventListener('click', function() {
        document.getElementById('chatInput').value = this.dataset.question;
        sendMessage();
    });
});
</script>

<style>
.typing-dots span {
    animation: typingDot 1.4s infinite;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--nj-primary);
    font-weight: bold;
}
.typing-dots span:nth-child(2) { animation-delay: .2s; }
.typing-dots span:nth-child(3) { animation-delay: .4s; }
@keyframes typingDot {
    0%, 60%, 100% { opacity: .2; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-4px); }
}
</style>
{% endblock %}
