{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
/* ═══════════════════════════════════════════════════════
   ADMIN — CSS tokens (dark default, light override)
   All rules use html[data-bs-theme] body to beat the
   base.html.twig front-office rules (specificity wins)
═══════════════════════════════════════════════════════ */

/* ── Tokens ── */
:root {
    --adm-bg: #0b0f1e;
    --adm-sidebar-bg: rgba(255,255,255,.03);
    --adm-sidebar-border: rgba(255,255,255,.07);
    --adm-link: rgba(255,255,255,.58);
    --adm-link-hover: #fff;
    --adm-link-active-bg: rgba(67,97,238,.18);
    --adm-card-bg: rgba(255,255,255,.05);
    --adm-card-border: rgba(255,255,255,.08);
    --adm-card-shadow: 0 4px 20px rgba(0,0,0,.3);
    --adm-text: rgba(226,232,240,.9);
    --adm-muted: rgba(255,255,255,.4);
    --adm-num: #fff;
    --adm-row-hover: rgba(255,255,255,.04);
    --adm-input-bg: rgba(255,255,255,.06);
    --adm-input-border: rgba(255,255,255,.12);
    --adm-input-color: rgba(226,232,240,.9);
    --adm-divider: rgba(255,255,255,.07);
}
html[data-bs-theme="light"] {
    --adm-bg: #f0f2ff;
    --adm-sidebar-bg: #ffffff;
    --adm-sidebar-border: rgba(67,97,238,.12);
    --adm-link: #4b5280;
    --adm-link-hover: #1e1b4b;
    --adm-link-active-bg: rgba(67,97,238,.1);
    --adm-card-bg: #ffffff;
    --adm-card-border: rgba(67,97,238,.12);
    --adm-card-shadow: 0 2px 16px rgba(67,97,238,.08);
    --adm-text: #1e1b4b;
    --adm-muted: rgba(30,27,75,.5);
    --adm-num: #1e1b4b;
    --adm-row-hover: rgba(67,97,238,.04);
    --adm-input-bg: #fff;
    --adm-input-border: rgba(67,97,238,.2);
    --adm-input-color: #1e1b4b;
    --adm-divider: rgba(67,97,238,.1);
}

/* ── Body (beats base specificity with html prefix) ── */
html[data-bs-theme="dark"] body,
html[data-bs-theme="light"] body {
    background: var(--adm-bg) !important;
    color: var(--adm-text) !important;
    background-attachment: fixed !important;
}
html[data-bs-theme="dark"] body {
    background: radial-gradient(circle at 20% 20%, rgba(67,97,238,.06), transparent 35%),
                radial-gradient(circle at 80% 80%, rgba(114,9,183,.06), transparent 35%),
                #0b0f1e !important;
}
html[data-bs-theme="light"] body {
    background: linear-gradient(135deg, #f0f2ff 0%, #e8eaf6 50%, #ede9fe 100%) !important;
}

/* ── Admin navbar ── */
.admin-navbar {
    background: rgba(8,12,32,.92) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,.06) !important;
    box-shadow: 0 1px 0 rgba(255,255,255,.04) !important;
}
html[data-bs-theme="light"] .admin-navbar {
    background: #fff !important;
    border-bottom: 1px solid rgba(67,97,238,.12) !important;
    box-shadow: 0 2px 16px rgba(67,97,238,.08) !important;
    backdrop-filter: none !important;
}
/* Navbar text colors */
.admin-navbar .navbar-brand,
.admin-navbar .text-white,
.admin-navbar .dropdown-toggle { color: rgba(255,255,255,.9) !important; }
html[data-bs-theme="light"] .admin-navbar .navbar-brand,
html[data-bs-theme="light"] .admin-navbar .text-white,
html[data-bs-theme="light"] .admin-navbar .dropdown-toggle { color: #1e1b4b !important; }
/* Front Office button */
html[data-bs-theme="light"] .admin-navbar .btn-outline-light {
    color: var(--nj-primary) !important;
    border-color: rgba(67,97,238,.3) !important;
    background: transparent !important;
}
html[data-bs-theme="light"] .admin-navbar .btn-outline-light:hover {
    background: rgba(67,97,238,.08) !important;
}
/* Dropdown */
html[data-bs-theme="light"] .admin-navbar .dropdown-menu {
    background: #fff !important;
    border: 1px solid rgba(67,97,238,.12) !important;
    box-shadow: 0 8px 24px rgba(67,97,238,.12) !important;
}
html[data-bs-theme="light"] .admin-navbar .dropdown-item { color: #1e1b4b !important; }
html[data-bs-theme="light"] .admin-navbar .dropdown-item:hover { background: rgba(67,97,238,.07) !important; color: var(--nj-primary) !important; }
html[data-bs-theme="light"] .admin-navbar .dropdown-divider { border-color: rgba(67,97,238,.1) !important; }

/* ── Theme toggle button ── */
.adm-theme-btn {
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.2);
    color: rgba(255,255,255,.8);
    border-radius: .65rem;
    padding: .35rem .65rem;
    line-height: 1;
    cursor: pointer;
    font-size: .9rem;
    transition: all .2s;
}
.adm-theme-btn:hover { background: rgba(255,255,255,.2); color: #fff; }
html[data-bs-theme="light"] .adm-theme-btn {
    background: rgba(67,97,238,.08) !important;
    border-color: rgba(67,97,238,.22) !important;
    color: var(--nj-primary) !important;
}
html[data-bs-theme="light"] .adm-theme-btn:hover {
    background: rgba(67,97,238,.15) !important;
}

/* ── Sidebar ── */
.sidebar {
    background: var(--adm-sidebar-bg) !important;
    min-height: calc(100vh - 56px);
    border-right: 1px solid var(--adm-sidebar-border) !important;
    transition: background .25s, border-color .25s;
}
.sidebar .nav-section-label {
    padding: .65rem 1.25rem .25rem;
    font-size: .67rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--adm-muted);
}
.sidebar .nav-link {
    color: var(--adm-link) !important;
    padding: .7rem 1.25rem;
    border-left: 3px solid transparent;
    font-size: .9rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    transition: all .18s;
    text-decoration: none;
}
.sidebar .nav-link i { width: 20px; text-align: center; flex-shrink: 0; font-size: .95rem; }
.sidebar .nav-link:hover {
    color: var(--adm-link-hover) !important;
    background: rgba(67,97,238,.09) !important;
    border-left-color: rgba(67,97,238,.45) !important;
}
.sidebar .nav-link.active {
    color: var(--nj-primary) !important;
    background: var(--adm-link-active-bg) !important;
    border-left-color: var(--nj-primary) !important;
    font-weight: 600;
}

/* ── Admin content wrapper ── */
.admin-content {
    background: transparent;
    color: var(--adm-text);
    flex: 1;
    min-width: 0;
}

/* ── Cards ── */
html[data-bs-theme="dark"] .card,
html[data-bs-theme="light"] .card {
    background: var(--adm-card-bg) !important;
    border: 1px solid var(--adm-card-border) !important;
    box-shadow: var(--adm-card-shadow) !important;
    color: var(--adm-text) !important;
    border-radius: 1rem;
}
html[data-bs-theme="dark"] .card:hover,
html[data-bs-theme="light"] .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(67,97,238,.14) !important;
}
html[data-bs-theme="dark"] .card-body,
html[data-bs-theme="light"] .card-body { color: var(--adm-text) !important; }
html[data-bs-theme="dark"] .card h1, html[data-bs-theme="dark"] .card h2,
html[data-bs-theme="dark"] .card h3, html[data-bs-theme="dark"] .card h4,
html[data-bs-theme="dark"] .card h5, html[data-bs-theme="dark"] .card h6,
html[data-bs-theme="light"] .card h1, html[data-bs-theme="light"] .card h2,
html[data-bs-theme="light"] .card h3, html[data-bs-theme="light"] .card h4,
html[data-bs-theme="light"] .card h5, html[data-bs-theme="light"] .card h6 {
    color: var(--adm-text) !important;
}

/* ── Stat cards ── */
.stat-card {
    /* no background here — let gradient cards use their inline style */
    border: 1px solid var(--adm-card-border) !important;
    border-radius: 1rem;
    padding: 1.5rem;
    transition: transform .22s, box-shadow .22s;
    position: relative;
    overflow: hidden;
}
/* Only non-gradient cards get the themed background */
.stat-card:not(.stat-gradient) {
    background: var(--adm-card-bg) !important;
}
.stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(67,97,238,.15) !important; }
.stat-card:not(.stat-gradient) p,
.stat-card:not(.stat-gradient) .stat-label { color: var(--adm-muted) !important; font-size: .83rem; }
.stat-card:not(.stat-gradient) .stat-num,
.stat-card:not(.stat-gradient) h3.fw-bold { color: var(--adm-num) !important; font-size: 2rem; font-weight: 800; }

/* Gradient cards — always white text regardless of theme */
.stat-card.stat-gradient {
    border: none !important;
}
html[data-bs-theme="dark"] .stat-card.stat-gradient h4,
html[data-bs-theme="dark"] .stat-card.stat-gradient h3,
html[data-bs-theme="dark"] .stat-card.stat-gradient p,
html[data-bs-theme="dark"] .stat-card.stat-gradient i,
html[data-bs-theme="dark"] .stat-card.stat-gradient span,
html[data-bs-theme="light"] .stat-card.stat-gradient h4,
html[data-bs-theme="light"] .stat-card.stat-gradient h3,
html[data-bs-theme="light"] .stat-card.stat-gradient p,
html[data-bs-theme="light"] .stat-card.stat-gradient i,
html[data-bs-theme="light"] .stat-card.stat-gradient span { color: #fff !important; }
.stat-card.stat-gradient::after {
    content: '';
    position: absolute;
    top: -50%; right: -40%;
    width: 90%; height: 180%;
    background: rgba(255,255,255,.07);
    border-radius: 50%;
    pointer-events: none;
}

/* ── Text utilities ── */
html[data-bs-theme="dark"] .text-muted,
html[data-bs-theme="light"] .text-muted { color: var(--adm-muted) !important; }
html[data-bs-theme="dark"] h1, html[data-bs-theme="dark"] h2,
html[data-bs-theme="dark"] h3, html[data-bs-theme="dark"] h4,
html[data-bs-theme="dark"] h5, html[data-bs-theme="dark"] h6 { color: var(--adm-text) !important; }
html[data-bs-theme="light"] h1, html[data-bs-theme="light"] h2,
html[data-bs-theme="light"] h3, html[data-bs-theme="light"] h4,
html[data-bs-theme="light"] h5, html[data-bs-theme="light"] h6 { color: #1e1b4b !important; }
html[data-bs-theme="light"] p,
html[data-bs-theme="light"] span:not(.badge):not(.btn) { color: inherit; }

/* ── Tables ── */
.table-nj thead { background: var(--nj-gradient) !important; color: #fff !important; }
.table-nj thead th { font-weight: 600; padding: .9rem 1rem; border: none !important; font-size: .88rem; color: #fff !important; }
html[data-bs-theme="dark"] .table-nj tbody td { color: var(--adm-text); border-bottom: 1px solid var(--adm-divider); padding: .85rem 1rem; vertical-align: middle; font-size: .9rem; }
html[data-bs-theme="light"] .table-nj tbody td { color: #1e1b4b !important; border-bottom: 1px solid rgba(67,97,238,.08) !important; background: transparent !important; padding: .85rem 1rem; vertical-align: middle; font-size: .9rem; }
.table-nj tbody tr:hover { background: var(--adm-row-hover) !important; }
.table-nj tbody tr:last-child td { border-bottom: none !important; }

/* ── Forms ── */
html[data-bs-theme="dark"] .form-control, html[data-bs-theme="dark"] .form-select {
    background: var(--adm-input-bg) !important;
    border-color: var(--adm-input-border) !important;
    color: var(--adm-input-color) !important;
}
html[data-bs-theme="light"] .form-control, html[data-bs-theme="light"] .form-select {
    background: #fff !important;
    border-color: rgba(67,97,238,.2) !important;
    color: #1e1b4b !important;
}
html[data-bs-theme="light"] .form-label { color: #1e1b4b !important; }
html[data-bs-theme="light"] .form-check-label { color: #1e1b4b !important; }
html[data-bs-theme="light"] .input-group-text {
    background: rgba(67,97,238,.07) !important;
    border-color: rgba(67,97,238,.2) !important;
    color: var(--nj-primary) !important;
}

/* ── Buttons ── */
html[data-bs-theme="light"] .btn-outline-primary {
    color: var(--nj-primary) !important;
    border-color: var(--nj-primary) !important;
    background: transparent !important;
}
html[data-bs-theme="light"] .btn-outline-primary:hover {
    background: var(--nj-primary) !important;
    color: #fff !important;
}
html[data-bs-theme="light"] .btn-outline-secondary {
    color: #4b5563 !important;
    border-color: #d1d5db !important;
    background: transparent !important;
}
html[data-bs-theme="light"] .btn-outline-secondary:hover {
    background: #f3f4f6 !important;
    color: #1f2937 !important;
}
html[data-bs-theme="light"] .btn-outline-danger {
    color: #dc2626 !important;
    border-color: #dc2626 !important;
    background: transparent !important;
}
html[data-bs-theme="light"] .btn-outline-danger:hover {
    background: #dc2626 !important;
    color: #fff !important;
}
html[data-bs-theme="light"] .btn-sm.btn-outline-primary { font-size: .82rem; }

/* ── Badges ── */
html[data-bs-theme="light"] .badge.text-bg-primary { background: var(--nj-primary) !important; color: #fff !important; }
html[data-bs-theme="light"] .badge.text-bg-light { background: #e8eaf6 !important; color: #1e1b4b !important; }
html[data-bs-theme="light"] .badge.text-bg-warning { background: #fef3c7 !important; color: #92400e !important; }
html[data-bs-theme="light"] .badge.text-bg-success { background: #d1fae5 !important; color: #065f46 !important; }
html[data-bs-theme="light"] .badge.text-bg-danger { background: #fee2e2 !important; color: #991b1b !important; }

/* ── Pagination ── */
html[data-bs-theme="light"] .pagination .page-link {
    background: #fff !important;
    border-color: rgba(67,97,238,.15) !important;
    color: #1e1b4b !important;
}
html[data-bs-theme="light"] .pagination .page-item.active .page-link {
    background: var(--nj-gradient) !important;
    border-color: transparent !important;
    color: #fff !important;
}
html[data-bs-theme="light"] .pagination .page-link:hover {
    background: rgba(67,97,238,.08) !important;
    color: var(--nj-primary) !important;
}

/* ── Alerts / flash messages ── */
html[data-bs-theme="light"] .alert-success { background: #ecfdf5 !important; border-color: #a7f3d0 !important; color: #065f46 !important; }
html[data-bs-theme="light"] .alert-danger  { background: #fef2f2 !important; border-color: #fecaca !important; color: #991b1b !important; }
html[data-bs-theme="light"] .alert-info    { background: #eff6ff !important; border-color: #bfdbfe !important; color: #1e40af !important; }

/* ── Small utility nav (community tabs etc) ── */
html[data-bs-theme="light"] .btn-outline-primary.btn-sm { color: var(--nj-primary) !important; }

/* ── Fade-in ── */
.fade-in { animation: admFadeIn .28s ease-out both; }
@keyframes admFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>
{% endblock %}

{% block body %}
{# ── Admin Navbar ── #}
<nav class="navbar admin-navbar sticky-top" style="z-index:1030">
    <div class="container-fluid px-4">
        <a class="navbar-brand text-white fw-bold" href="{{ path('admin_dashboard') }}">
            LockedIn <span class="badge ms-2" style="background:var(--nj-gradient);font-size:.6rem;vertical-align:middle">Admin</span>
        </a>
        <div class="d-flex align-items-center gap-2">
            <button class="adm-theme-btn" id="admThemeBtn" title="Toggle theme">
                <i class="bi bi-sun-fill" id="admThemeIcon"></i>
            </button>
            <a href="{{ path('admin_preview_enter') }}" class="btn btn-outline-light btn-sm">
                <i class="bi bi-eye me-1"></i>Front Office
            </a>
            <div class="dropdown">
                <a class="text-white text-decoration-none dropdown-toggle ms-2" href="#" role="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i>{{ app.user ? app.user.firstname : 'Admin' }}
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi bi-person me-2"></i>Profil</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="d-flex" style="min-height:calc(100vh - 56px)">
    {# ── Sidebar ── #}
    <aside class="sidebar d-none d-lg-block" style="width:240px;flex-shrink:0">
        <nav class="nav flex-column py-2">
            <div class="nav-section-label mt-2">Navigation</div>
            <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' }}" href="{{ path('admin_dashboard') }}">
                <i class="bi bi-speedometer2"></i>Tableau de Bord
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' }}" href="{{ path('admin_users') }}">
                <i class="bi bi-people"></i>Utilisateurs
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_users_stats' ? 'active' }}" href="{{ path('admin_users_stats') }}">
                <i class="bi bi-bar-chart-line"></i>Stats Utilisateurs
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') == 'admin_users_broadcast' ? 'active' }}" href="{{ path('admin_users_broadcast') }}">
                <i class="bi bi-megaphone"></i>Email Broadcast
            </a>

            <div class="nav-section-label mt-3">Modules</div>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_projet' ? 'active' }}" href="{{ path('admin_projets') }}">
                <i class="bi bi-kanban"></i>Projets
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_invest' ? 'active' }}" href="{{ path('admin_invest_opportunities') }}">
                <i class="bi bi-graph-up-arrow"></i>Investissement
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_community' ? 'active' }}" href="{{ path('admin_community_dashboard') }}">
                <i class="bi bi-chat-dots"></i>Communauté
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_mentorat' ? 'active' }}" href="{{ path('admin_mentorat_requests') }}">
                <i class="bi bi-mortarboard"></i>Mentorat
            </a>
            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_team' ? 'active' }}" href="{{ path('admin_team_matcher') }}">
                <i class="bi bi-people-fill"></i>Co-founders & Partners
            </a>
        </nav>
    </aside>

    {# ── Content ── #}
    <div class="admin-content p-4 fade-in">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'danger' ? 'danger' : 'info') }} alert-dismissible mb-4" role="alert">
                <i class="bi bi-{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }} me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            {% endfor %}
        {% endfor %}
        {% block main %}{% endblock %}
    </div>
</div>

<script>
(function(){
    var root = document.documentElement;
    var btn  = document.getElementById('admThemeBtn');
    var icon = document.getElementById('admThemeIcon');
    var saved = localStorage.getItem('nj-theme') || 'dark';
    root.setAttribute('data-bs-theme', saved);
    if(icon) icon.className = saved === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    if(btn){
        btn.addEventListener('click', function(){
            var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-bs-theme', next);
            localStorage.setItem('nj-theme', next);
            icon.className = next === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
        });
    }
})();
</script>
{% endblock %}
